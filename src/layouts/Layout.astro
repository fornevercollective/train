---
import TrainConsoleSidebar from '../components/TrainConsoleSidebar.astro';
import HeaderEyebrowRail from '../components/HeaderEyebrowRail.astro';

interface Props {
	title?: string;
	description?: string;
	pageClass?: string;
	eyebrow?: string;
	subtitle?: string;
	/** When true, show directory search in the banner (synced with #filter-query on the home page). */
	showHeaderDirectorySearch?: boolean;
	/** FinanceAI-style left rail (mirrors Game `AppSidebar`). */
	showConsoleSidebar?: boolean;
	/**
	 * When false (default, with directory search), the eyebrow rail sits below the fixed header and
	 * above `<main>` (same band as the home page eyebrow slot). Set true to pin it inside the header top band.
	 */
	eyebrowInHeader?: boolean;
}

const {
	title = 'Erika Market Directory',
	description = 'A static market listing directory built from the Erika dataset.',
	pageClass = 'page-home',
	eyebrow = 'Static market directory',
	subtitle = 'Searchable listing intelligence built from the Erika dataset.',
	showHeaderDirectorySearch = true,
	showConsoleSidebar = true,
	eyebrowInHeader = false,
} = Astro.props;

const showEyebrowInHeader = !showHeaderDirectorySearch || eyebrowInHeader;
const eyebrowInMainChrome = showHeaderDirectorySearch && !eyebrowInHeader;

const baseUrl = import.meta.env.BASE_URL;
const gameConsoleUrl = (import.meta.env.PUBLIC_GAME_CONSOLE_URL || '').replace(/\/$/, '');
const path = Astro.url.pathname;
const navActive = {
	home:
		!path.includes('/directory') &&
		!path.includes('/featured') &&
		!path.includes('/predictions') &&
		!path.includes('/models') &&
		!path.includes('/listing') &&
		!path.includes('/raw') &&
		!path.includes('/live-captions'),
	featured: path.includes('/featured'),
	predictions: path.includes('/predictions'),
	models: path.includes('/models'),
	directory: path.includes('/directory'),
	listing: path.includes('/listing'),
	raw: path.includes('/raw'),
	liveCaptions: path.includes('/live-captions'),
};
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{title}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body
		class:list={[
			pageClass,
			showHeaderDirectorySearch && 'has-header-directory-search',
			showConsoleSidebar && 'has-train-console-sidebar',
			eyebrowInMainChrome && 'header-eyebrow-in-main',
		]}
		data-base-url={baseUrl}
	>
		<div class="bgGlow" aria-hidden="true"></div>
		<div class:list={['page-shell', showConsoleSidebar && 'page-shell--withTrainSidebar']}>
			{showConsoleSidebar ? <TrainConsoleSidebar baseUrl={baseUrl} gameConsoleUrl={gameConsoleUrl} navActive={navActive} /> : null}
			<div class:list={['page-chrome-main', showConsoleSidebar && 'page-chrome-main--withSidebar']}>
			{
				showConsoleSidebar ? (
					<button
						type="button"
						class="train-drawer-backdrop"
						data-train-drawer-backdrop
						aria-label="Close navigation drawer"
					/>
				) : null
			}
			<header class="headerBanner" role="banner">
				{
					showHeaderDirectorySearch ? (
						<div class="headerBannerTopBand">
							<div class="headerBannerSearchRow headerBannerSearchRow--primary">
								{
									showConsoleSidebar ? (
										<button
											type="button"
											class="train-sidebar-toggle train-sidebar-toggle--header"
											id="train-sidebar-toggle"
											aria-expanded="true"
											aria-controls="train-sidebar-rail"
											title="Collapse sidebar"
										>
											<svg
												class="train-sidebar-toggle-icon"
												width="18"
												height="18"
												viewBox="0 0 24 24"
												fill="none"
												stroke="currentColor"
												stroke-width="2"
												stroke-linecap="round"
												stroke-linejoin="round"
												aria-hidden="true"
											>
												<polyline points="15 6 9 12 15 18" />
											</svg>
										</button>
									) : null
								}
								<a class="logoLink logoLink--headerMini" href={baseUrl} aria-label="Erika Market Directory home">
									<span class="brand-mark brand-mark--header">E</span>
								</a>
								<input
									id="header-filter-query"
									class="headerBannerSearch-input headerBannerSearch-input--toolbar"
									type="search"
									placeholder="Ticker, company, exchange, country, alias…"
									autocomplete="off"
								/>
								<button
									type="button"
									class="header-site-nav-toggle"
									id="header-site-nav-toggle"
									aria-expanded="true"
									aria-controls="header-site-nav-panel"
									title="Hide site navigation"
								>
									<svg
										class="header-site-nav-toggle-icon"
										width="20"
										height="20"
										viewBox="0 0 24 24"
										fill="none"
										stroke="currentColor"
										stroke-width="2"
										stroke-linecap="round"
										stroke-linejoin="round"
										aria-hidden="true"
									>
										<polyline points="6 9 12 15 18 9" />
									</svg>
									<span class="header-site-nav-toggle-text">Menu</span>
								</button>
							</div>
							<div class="headerBannerSearchMetaRow" aria-label="Directory page context">
								<label class="headerBannerSearch-label" for="header-filter-query">
									Directory search
								</label>
								<h1 class="site-title">{title}</h1>
							</div>
							{showEyebrowInHeader ? (
								<HeaderEyebrowRail variant="beside-search" eyebrow={eyebrow} subtitle={subtitle} />
							) : null}
						</div>
					) : showEyebrowInHeader ? (
						<div class="headerBannerTopBand headerBannerTopBand--standalone">
							{
								showConsoleSidebar ? (
									<button
										type="button"
										class="train-sidebar-toggle train-sidebar-toggle--header"
										id="train-sidebar-toggle"
										aria-expanded="true"
										aria-controls="train-sidebar-rail"
										title="Collapse sidebar"
									>
										<svg
											class="train-sidebar-toggle-icon"
											width="18"
											height="18"
											viewBox="0 0 24 24"
											fill="none"
											stroke="currentColor"
											stroke-width="2"
											stroke-linecap="round"
											stroke-linejoin="round"
											aria-hidden="true"
										>
											<polyline points="15 6 9 12 15 18" />
										</svg>
									</button>
								) : null
							}
							<div class="headerBannerTopBand-standaloneFill">
								<HeaderEyebrowRail variant="standalone" eyebrow={eyebrow} subtitle={subtitle} title={title} baseUrl={baseUrl} />
							</div>
						</div>
					) : null}
				<div id="header-site-nav-panel" class="header-site-nav-panel">
				<nav
					class="site-nav site-nav--console site-nav--tabs site-nav--tabsGhost"
					aria-label="Site navigation"
				>
					<div class="site-nav-pillsWrap">
						<a class:list={['site-nav-pill', { 'is-active': navActive.home }]} href={baseUrl}>Home</a>
						<a
							class:list={['site-nav-pill', { 'is-active': navActive.featured }]}
							href={`${baseUrl}featured/`}
						>
							Featured
						</a>
						<a
							class:list={['site-nav-pill', { 'is-active': navActive.predictions }]}
							href={`${baseUrl}predictions/`}
						>
							Predictions
						</a>
						<a class:list={['site-nav-pill', { 'is-active': navActive.models }]} href={`${baseUrl}models/`}>
							Models
						</a>
						<a
							class:list={['site-nav-pill', { 'is-active': navActive.directory }]}
							href={`${baseUrl}directory/`}
						>
							Directory
						</a>
						<a class:list={['site-nav-pill', { 'is-active': navActive.listing }]} href={`${baseUrl}listing/`}>
							Listing
						</a>
						<a class:list={['site-nav-pill', { 'is-active': navActive.raw }]} href={`${baseUrl}raw/`}>Raw</a>
						<a
							class:list={['site-nav-pill', { 'is-active': navActive.liveCaptions }]}
							href={`${baseUrl}live-captions/`}
						>
							Captions
						</a>
						{
							gameConsoleUrl ? (
								<>
									<span class="site-nav-divider" aria-hidden="true" />
									<a
										class="site-nav-pill site-nav-pill--ext"
										href={`${gameConsoleUrl}/`}
										target="_blank"
										rel="noopener noreferrer"
									>
										Game
									</a>
									<a
										class="site-nav-pill site-nav-pill--ext"
										href={`${gameConsoleUrl}/live`}
										target="_blank"
										rel="noopener noreferrer"
									>
										Live
									</a>
								</>
							) : null
						}
					</div>
					<div class="paywallPill paywallPill--headerNav">Educational dataset view only</div>
				</nav>
				</div>
			</header>
			<div class="page-bodyGrid">
				{
					eyebrowInMainChrome ? (
						<div class="page-eyebrow-slot card">
							<HeaderEyebrowRail variant="beside-search" eyebrow={eyebrow} subtitle={subtitle} />
						</div>
					) : null
				}
				<main class="wrap">
					<slot />
				</main>
			</div>
			</div>
		</div>
		<script is:inline>
			(() => {
				const threshold = 36;
				let ticking = false;
				function sync() {
					document.body.classList.toggle('header-collapsed', window.scrollY > threshold);
					ticking = false;
				}
				function onScroll() {
					if (!ticking) {
						ticking = true;
						requestAnimationFrame(sync);
					}
				}
				window.addEventListener('scroll', onScroll, { passive: true });
				window.addEventListener('resize', onScroll, { passive: true });
				sync();
			})();

			(() => {
				const body = document.body;
				const headerInput = document.getElementById('header-filter-query');
				if (!headerInput || !body.classList.contains('has-header-directory-search')) return;
				if (body.classList.contains('page-directory')) return;
				const base = body.getAttribute('data-base-url') || '/';
				headerInput.addEventListener('keydown', (event) => {
					if (event.key !== 'Enter') return;
					event.preventDefault();
					const q = headerInput.value.trim();
					const qs = q ? `?q=${encodeURIComponent(q)}` : '';
					window.location.href = `${base}directory/${qs}`;
				});
			})();

			(() => {
				const KEY = 'train-sidebar-collapsed';
				const body = document.body;
				const toggle = document.getElementById('train-sidebar-toggle');
				if (!toggle) return;
				const mobileMq = window.matchMedia('(max-width: 900px)');
				const backdrop = document.querySelector('[data-train-drawer-backdrop]');
				const apply = (collapsed) => {
					body.classList.toggle('train-sidebar-collapsed', collapsed);
					toggle.setAttribute('aria-expanded', collapsed ? 'false' : 'true');
					toggle.setAttribute('title', collapsed ? 'Expand sidebar' : 'Collapse sidebar');
				};
				const initialCollapsed = () => {
					try {
						if (mobileMq.matches) {
							if (localStorage.getItem(KEY) === '0') return false;
							return true;
						}
						return localStorage.getItem(KEY) === '1';
					} catch {
						return false;
					}
				};
				apply(initialCollapsed());
				toggle.addEventListener('click', () => {
					const next = !body.classList.contains('train-sidebar-collapsed');
					apply(next);
					try {
						localStorage.setItem(KEY, next ? '1' : '0');
					} catch {
						/* ignore */
					}
				});
				backdrop?.addEventListener('click', () => {
					if (!mobileMq.matches) return;
					apply(true);
					try {
						localStorage.setItem(KEY, '1');
					} catch {
						/* ignore */
					}
				});
				document.addEventListener('keydown', (event) => {
					if (event.key !== 'Escape') return;
					if (!mobileMq.matches) return;
					if (body.classList.contains('train-sidebar-collapsed')) return;
					apply(true);
					try {
						localStorage.setItem(KEY, '1');
					} catch {
						/* ignore */
					}
				});
			})();

			(() => {
				const KEY = 'train-header-site-nav-collapsed';
				const toggle = document.getElementById('header-site-nav-toggle');
				const panel = document.getElementById('header-site-nav-panel');
				if (!toggle || !panel) return;
				const apply = (collapsed) => {
					document.body.classList.toggle('header-site-nav-collapsed', collapsed);
					toggle.setAttribute('aria-expanded', collapsed ? 'false' : 'true');
					toggle.setAttribute('title', collapsed ? 'Show site navigation' : 'Hide site navigation');
					if (collapsed) panel.setAttribute('aria-hidden', 'true');
					else panel.removeAttribute('aria-hidden');
				};
				try {
					apply(localStorage.getItem(KEY) === '1');
				} catch {
					apply(false);
				}
				toggle.addEventListener('click', () => {
					const next = !document.body.classList.contains('header-site-nav-collapsed');
					apply(next);
					try {
						localStorage.setItem(KEY, next ? '1' : '0');
					} catch {
						/* ignore */
					}
				});
			})();
		</script>
	</body>
</html>

<style is:global>
	@import url('https://fonts.googleapis.com/css2?family=Arimo:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&family=Instrument+Serif:ital@0;1&display=swap');

	:root {
		color-scheme: dark;
		--font-ui:
			'Arimo', ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI',
			sans-serif;
		--font-serif: 'Instrument Serif', Georgia, serif;
		--font-mono: 'IBM Plex Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
		--bg-strong: #060711;
		--text: rgba(255, 255, 255, 0.92);
		--muted: rgba(255, 255, 255, 0.62);
		--soft: rgba(255, 255, 255, 0.48);
		--accent: rgba(72, 224, 188, 0.92);
		--accent-alt: rgba(170, 90, 255, 0.95);
		--accent-warm: rgba(255, 210, 120, 0.92);
		--card-bg: rgba(0, 0, 0, 0.34);
		--card-border: rgba(255, 255, 255, 0.11);
		--field-bg: rgba(0, 0, 0, 0.24);
		--shadow:
			0 22px 60px rgba(0, 0, 0, 0.35),
			0 0 0 1px rgba(255, 215, 130, 0.06),
			0 0 38px rgba(255, 190, 90, 0.06);
		/* Light “console” surfaces — aligned with PredictionsGamePanel + home card chrome */
		--header-rail-surface: #ffffff;
		--header-rail-border: #e7e9ef;
		--header-rail-shadow: 0 24px 60px rgba(8, 12, 24, 0.12);
		--header-rail-muted: #5c6378;
		--header-rail-pill-bg: #f6f7fb;
		--header-rail-pill-border: #d7dbe8;
	}

	* {
		box-sizing: border-box;
	}

	html,
	body {
		min-height: 100%;
	}

	html {
		background: radial-gradient(1200px 900px at 50% 0%, #0c1020, #070812 55%, #05050b 100%);
		scroll-behavior: smooth;
	}

	body {
		margin: 0;
		min-width: 320px;
		color: var(--text);
		background: none;
		font-family: var(--font-ui);
		letter-spacing: 0.2px;
	}

	body::before {
		content: '';
		position: fixed;
		inset: 0;
		background:
			radial-gradient(circle at 20% 20%, rgba(255, 255, 255, 0.06), transparent 32%),
			radial-gradient(circle at 78% 18%, rgba(170, 90, 255, 0.14), transparent 24%),
			radial-gradient(circle at 55% 80%, rgba(60, 200, 255, 0.12), transparent 24%),
			radial-gradient(circle at center, rgba(10, 15, 30, 0.3), rgba(5, 5, 11, 0.1) 60%);
		pointer-events: none;
		z-index: 0;
	}

	.bgGlow {
		position: fixed;
		inset: -30vh -30vw;
		background:
			radial-gradient(900px 600px at 20% 20%, rgba(255, 255, 255, 0.08), transparent),
			radial-gradient(800px 500px at 80% 25%, rgba(170, 90, 255, 0.13), transparent),
			radial-gradient(700px 550px at 50% 85%, rgba(60, 200, 255, 0.12), transparent);
		filter: blur(8px);
		pointer-events: none;
		z-index: 0;
	}

	a {
		color: inherit;
		text-decoration: none;
	}

	button,
	input,
	select {
		font: inherit;
	}

	.page-shell {
		position: relative;
		z-index: 1;
	}

	.page-shell--withTrainSidebar {
		min-height: 100vh;
	}

	.page-chrome-main {
		position: relative;
		z-index: 1;
		min-width: 0;
	}

	body.has-train-console-sidebar {
		--train-sidebar-peek: 280px;
	}

	body.has-train-console-sidebar.train-sidebar-collapsed {
		/* Rail tucks away fully; collapse control lives in the header search row. */
		--train-sidebar-peek: 0px;
	}

	@media (max-width: 900px) {
		body.has-train-console-sidebar:not(.train-sidebar-collapsed) {
			--train-sidebar-peek: min(300px, 88vw);
		}
	}

	.page-chrome-main--withSidebar {
		margin-left: var(--train-sidebar-peek);
		transition: margin-left 0.24s ease;
	}

	@media (prefers-reduced-motion: reduce) {
		.page-chrome-main--withSidebar {
			transition: none;
		}
	}

	.train-drawer-backdrop {
		display: none;
	}

	@media (max-width: 900px) {
		body.has-train-console-sidebar:not(.train-sidebar-collapsed) .train-drawer-backdrop {
			display: block;
			position: fixed;
			top: 0;
			right: 0;
			bottom: 0;
			left: var(--train-sidebar-peek);
			z-index: 195;
			margin: 0;
			padding: 0;
			border: 0;
			background: rgba(3, 5, 12, 0.5);
			backdrop-filter: blur(4px);
			-webkit-backdrop-filter: blur(4px);
			cursor: pointer;
			animation: trainBackdropIn 0.22s ease;
		}

		body.has-train-console-sidebar:not(.train-sidebar-collapsed) .train-console-sidebar {
			box-shadow: 12px 0 48px rgba(0, 0, 0, 0.45);
		}
	}

	@keyframes trainBackdropIn {
		from {
			opacity: 0;
		}
		to {
			opacity: 1;
		}
	}

	.page-bodyGrid {
		width: 100%;
		max-width: 100%;
		margin: 0 auto;
		padding: 9.25rem 18px 52px;
		box-sizing: border-box;
		transition: padding-top 0.22s ease;
	}

	body.header-eyebrow-in-main .page-bodyGrid {
		display: flex;
		flex-direction: column;
		gap: 18px;
	}

	.page-eyebrow-slot.card {
		padding: 14px 16px;
		width: 100%;
		box-sizing: border-box;
	}

	body:not(.has-train-console-sidebar) .page-eyebrow-slot {
		max-width: 1380px;
		margin-left: auto;
		margin-right: auto;
	}

	.page-eyebrow-slot .headerEyebrowRow--railBesideSearch {
		max-width: none;
		flex: 1 1 auto;
		width: 100%;
		align-self: stretch;
	}

	/* Directory-search header height tiers (eyebrow in header vs main; nav panel expanded vs collapsed). */
	body.has-header-directory-search .page-bodyGrid {
		padding-top: 13rem;
	}

	body.has-header-directory-search.header-eyebrow-in-main .page-bodyGrid {
		padding-top: 8.85rem;
	}

	body.has-header-directory-search.header-site-nav-collapsed:not(.header-eyebrow-in-main) .page-bodyGrid {
		padding-top: 9.85rem;
	}

	body.has-header-directory-search.header-eyebrow-in-main.header-site-nav-collapsed .page-bodyGrid {
		padding-top: 6.35rem;
	}

	body.has-train-console-sidebar .page-bodyGrid {
		max-width: min(1680px, 100%);
	}

	body.has-train-console-sidebar .page-bodyGrid .wrap {
		margin: 0;
		max-width: none;
	}

	@media (max-width: 1100px) {
		.headerBannerTopBand {
			flex-direction: column;
			align-items: stretch;
		}

		.headerBannerTopBand .headerBannerSearchRow--primary,
		.headerBannerTopBand .headerBannerSearchMetaRow,
		.headerBannerTopBand .headerEyebrowRow--railBesideSearch {
			max-width: 100%;
			width: 100%;
		}
	}

	@media (max-width: 1100px) and (min-width: 901px) {
		body.has-header-directory-search:not(.header-eyebrow-in-main):not(.header-site-nav-collapsed) .page-bodyGrid {
			padding-top: 11.5rem;
		}

		body.has-header-directory-search.header-eyebrow-in-main:not(.header-site-nav-collapsed) .page-bodyGrid {
			padding-top: 7.65rem;
		}

		body.has-header-directory-search.header-site-nav-collapsed:not(.header-eyebrow-in-main) .page-bodyGrid {
			padding-top: 8.35rem;
		}

		body.has-header-directory-search.header-eyebrow-in-main.header-site-nav-collapsed .page-bodyGrid {
			padding-top: 5.65rem;
		}
	}

	body:not(.has-train-console-sidebar) .page-bodyGrid .wrap {
		max-width: 1380px;
		margin-left: auto;
		margin-right: auto;
	}

	.wrap {
		position: relative;
		z-index: 1;
		padding: 0;
	}

	@media (prefers-reduced-motion: reduce) {
		.page-bodyGrid {
			transition: none;
		}
	}

	body.header-collapsed .headerBanner {
		padding: 6px 16px 8px;
		box-shadow: 0 4px 20px rgba(0, 0, 0, 0.35);
	}

	body.header-collapsed .headerBanner .eyebrow {
		margin: 0 0 2px;
	}

	body.header-collapsed .headerBanner .headerEyebrowRow-copy .sub {
		display: none;
	}

	body.header-collapsed .headerBanner .site-title {
		margin: 0 0 2px;
		font-size: clamp(1rem, 2.4vw, 1.25rem);
	}

	body.header-collapsed .headerBanner .site-nav {
		margin-top: 2px;
	}

	body.header-collapsed .headerBanner .headerBannerAttribution--rail {
		display: none;
	}

	body.header-collapsed .page-bodyGrid {
