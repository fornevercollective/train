---
import TrainConsoleSidebar from '../components/TrainConsoleSidebar.astro';

interface Props {
	title?: string;
	description?: string;
	pageClass?: string;
	eyebrow?: string;
	subtitle?: string;
	/** When true, show directory search in the banner (synced with #filter-query on the home page). */
	showHeaderDirectorySearch?: boolean;
	/** FinanceAI-style left rail (mirrors Game `AppSidebar`). */
	showConsoleSidebar?: boolean;
}

const {
	title = 'Erika Market Directory',
	description = 'A static market listing directory built from the Erika dataset.',
	pageClass = 'page-home',
	eyebrow = 'Static market directory',
	subtitle = 'Searchable listing intelligence built from the Erika dataset.',
	showHeaderDirectorySearch = true,
	showConsoleSidebar = true,
} = Astro.props;

const baseUrl = import.meta.env.BASE_URL;
const gameConsoleUrl = (import.meta.env.PUBLIC_GAME_CONSOLE_URL || '').replace(/\/$/, '');
const path = Astro.url.pathname;
const navActive = {
	home:
		!path.includes('/directory') &&
		!path.includes('/featured') &&
		!path.includes('/predictions') &&
		!path.includes('/listing') &&
		!path.includes('/raw'),
	featured: path.includes('/featured'),
	predictions: path.includes('/predictions'),
	directory: path.includes('/directory'),
	listing: path.includes('/listing'),
	raw: path.includes('/raw'),
};
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{title}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body
		class={`${pageClass}${showHeaderDirectorySearch ? ' has-header-directory-search' : ''}`}
		data-base-url={baseUrl}
	>
		<div class="bgGlow" aria-hidden="true"></div>
		<div class="page-shell">
			<header class="headerBanner" role="banner">
				{
					showHeaderDirectorySearch ? (
						<div class="headerBannerSearch headerBannerSearch--top">
							<div class="headerBannerSearch-labelRow">
								<label class="headerBannerSearch-label" for="header-filter-query">
									Directory search
								</label>
								<h1 class="site-title">{title}</h1>
							</div>
							<input
								id="header-filter-query"
								class="headerBannerSearch-input"
								type="search"
								placeholder="Ticker, company, exchange, country, alias…"
								autocomplete="off"
							/>
						</div>
					) : null
				}
				<div class="headerEyebrowRow headerEyebrowRow--rail">
					<a class="logoLink logoLink--headerMini" href={baseUrl} aria-label="Erika Market Directory home">
						<span class="brand-mark brand-mark--header">E</span>
					</a>
					<div class="headerEyebrowRow-copy">
						<div class="eyebrow">{eyebrow}</div>
						{
							!showHeaderDirectorySearch ? (
								<h1 class="site-title site-title--headerEyebrow">{title}</h1>
							) : null
						}
						<p class="sub">{subtitle}</p>
					</div>
					<p class="headerBannerAttribution headerBannerAttribution--rail">
						Built from Erika dataset metadata for browsing, filtering, and static profile lookup.
					</p>
				</div>
				<nav class="site-nav site-nav--console site-nav--tabs" aria-label="Site navigation">
					<div class="site-nav-pillsWrap">
						<a class:list={['site-nav-pill', { 'is-active': navActive.home }]} href={baseUrl}>Home</a>
						<a
							class:list={['site-nav-pill', { 'is-active': navActive.featured }]}
							href={`${baseUrl}featured/`}
						>
							Featured
						</a>
						<a
							class:list={['site-nav-pill', { 'is-active': navActive.predictions }]}
							href={`${baseUrl}predictions/`}
						>
							Predictions
						</a>
						<a
							class:list={['site-nav-pill', { 'is-active': navActive.directory }]}
							href={`${baseUrl}directory/`}
						>
							Directory
						</a>
						<a class:list={['site-nav-pill', { 'is-active': navActive.listing }]} href={`${baseUrl}listing/`}>
							Listing
						</a>
						<a class:list={['site-nav-pill', { 'is-active': navActive.raw }]} href={`${baseUrl}raw/`}>Raw</a>
						{
							gameConsoleUrl ? (
								<>
									<span class="site-nav-divider" aria-hidden="true" />
									<a
										class="site-nav-pill site-nav-pill--ext"
										href={`${gameConsoleUrl}/`}
										target="_blank"
										rel="noopener noreferrer"
									>
										Game
									</a>
									<a
										class="site-nav-pill site-nav-pill--ext"
										href={`${gameConsoleUrl}/live`}
										target="_blank"
										rel="noopener noreferrer"
									>
										Live
									</a>
								</>
							) : null
						}
					</div>
					<div class="paywallPill paywallPill--headerNav">Educational dataset view only</div>
				</nav>
			</header>
			<div class:list={['page-bodyGrid', showConsoleSidebar && 'page-bodyGrid--withSidebar']}>
				{showConsoleSidebar ? (
					<TrainConsoleSidebar baseUrl={baseUrl} gameConsoleUrl={gameConsoleUrl} navActive={navActive} />
				) : null}
				<main class="wrap">
					<slot />
				</main>
			</div>
		</div>
		<script is:inline>
			(() => {
				const threshold = 36;
				let ticking = false;
				function sync() {
					document.body.classList.toggle('header-collapsed', window.scrollY > threshold);
					ticking = false;
				}
				function onScroll() {
					if (!ticking) {
						ticking = true;
						requestAnimationFrame(sync);
					}
				}
				window.addEventListener('scroll', onScroll, { passive: true });
				window.addEventListener('resize', onScroll, { passive: true });
				sync();
			})();

			(() => {
				const body = document.body;
				const headerInput = document.getElementById('header-filter-query');
				if (!headerInput || !body.classList.contains('has-header-directory-search')) return;
				if (body.classList.contains('page-directory')) return;
				const base = body.getAttribute('data-base-url') || '/';
				headerInput.addEventListener('keydown', (event) => {
					if (event.key !== 'Enter') return;
					event.preventDefault();
					const q = headerInput.value.trim();
					const qs = q ? `?q=${encodeURIComponent(q)}` : '';
					window.location.href = `${base}directory/${qs}`;
				});
			})();

			(() => {
				const KEY = 'train-sidebar-collapsed';
				const body = document.body;
				const toggle = document.getElementById('train-sidebar-toggle');
				if (!toggle) return;
				const apply = (collapsed) => {
					body.classList.toggle('train-sidebar-collapsed', collapsed);
					toggle.setAttribute('aria-expanded', collapsed ? 'false' : 'true');
					toggle.setAttribute('title', collapsed ? 'Expand sidebar' : 'Collapse sidebar');
				};
				try {
					apply(localStorage.getItem(KEY) === '1');
				} catch {
					apply(false);
				}
				toggle.addEventListener('click', () => {
					const next = !body.classList.contains('train-sidebar-collapsed');
					apply(next);
					try {
						localStorage.setItem(KEY, next ? '1' : '0');
					} catch {
						/* ignore */
					}
				});
			})();
		</script>
	</body>
</html>

<style is:global>
	@import url('https://fonts.googleapis.com/css2?family=Arimo:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&family=Instrument+Serif:ital@0;1&display=swap');

	:root {
		color-scheme: dark;
		--font-ui:
			'Arimo', ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI',
			sans-serif;
		--font-serif: 'Instrument Serif', Georgia, serif;
		--font-mono: 'IBM Plex Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
		--bg-strong: #060711;
		--text: rgba(255, 255, 255, 0.92);
		--muted: rgba(255, 255, 255, 0.62);
		--soft: rgba(255, 255, 255, 0.48);
		--accent: rgba(72, 224, 188, 0.92);
		--accent-alt: rgba(170, 90, 255, 0.95);
		--accent-warm: rgba(255, 210, 120, 0.92);
		--card-bg: rgba(0, 0, 0, 0.34);
		--card-border: rgba(255, 255, 255, 0.11);
		--field-bg: rgba(0, 0, 0, 0.24);
		--shadow:
			0 22px 60px rgba(0, 0, 0, 0.35),
			0 0 0 1px rgba(255, 215, 130, 0.06),
			0 0 38px rgba(255, 190, 90, 0.06);
		/* Light “console” surfaces — aligned with PredictionsGamePanel + home card chrome */
		--header-rail-surface: #ffffff;
		--header-rail-border: #e7e9ef;
		--header-rail-shadow: 0 24px 60px rgba(8, 12, 24, 0.12);
		--header-rail-muted: #5c6378;
		--header-rail-pill-bg: #f6f7fb;
		--header-rail-pill-border: #d7dbe8;
	}

	* {
		box-sizing: border-box;
	}

	html,
	body {
		min-height: 100%;
	}

	html {
		background: radial-gradient(1200px 900px at 50% 0%, #0c1020, #070812 55%, #05050b 100%);
		scroll-behavior: smooth;
	}

	body {
		margin: 0;
		min-width: 320px;
		color: var(--text);
		background: none;
		font-family: var(--font-ui);
		letter-spacing: 0.2px;
	}

	body::before {
		content: '';
		position: fixed;
		inset: 0;
		background:
			radial-gradient(circle at 20% 20%, rgba(255, 255, 255, 0.06), transparent 32%),
			radial-gradient(circle at 78% 18%, rgba(170, 90, 255, 0.14), transparent 24%),
			radial-gradient(circle at 55% 80%, rgba(60, 200, 255, 0.12), transparent 24%),
			radial-gradient(circle at center, rgba(10, 15, 30, 0.3), rgba(5, 5, 11, 0.1) 60%);
		pointer-events: none;
		z-index: 0;
	}

	.bgGlow {
		position: fixed;
		inset: -30vh -30vw;
		background:
			radial-gradient(900px 600px at 20% 20%, rgba(255, 255, 255, 0.08), transparent),
			radial-gradient(800px 500px at 80% 25%, rgba(170, 90, 255, 0.13), transparent),
			radial-gradient(700px 550px at 50% 85%, rgba(60, 200, 255, 0.12), transparent);
		filter: blur(8px);
		pointer-events: none;
		z-index: 0;
	}

	a {
		color: inherit;
		text-decoration: none;
	}

	button,
	input,
	select {
		font: inherit;
	}

	.page-shell {
		position: relative;
		z-index: 1;
	}

	.page-bodyGrid {
		width: 100%;
		max-width: 100%;
		margin: 0 auto;
		padding: 7.8rem 18px 52px;
		box-sizing: border-box;
		transition: padding-top 0.22s ease;
	}

	body.has-header-directory-search .page-bodyGrid {
		padding-top: 9.85rem;
	}

	.page-bodyGrid--withSidebar {
		display: flex;
		align-items: stretch;
		gap: 18px;
		max-width: min(1680px, 100%);
	}

	.page-bodyGrid--withSidebar .wrap {
		margin: 0;
		max-width: none;
		flex: 1;
		min-width: 0;
	}

	body.train-sidebar-collapsed .page-bodyGrid--withSidebar {
		gap: 10px;
	}

	@media (max-width: 1100px) {
		.page-bodyGrid--withSidebar {
			flex-direction: column;
		}
	}

	.page-bodyGrid:not(.page-bodyGrid--withSidebar) .wrap {
		max-width: 1380px;
		margin-left: auto;
		margin-right: auto;
	}

	.wrap {
		position: relative;
		z-index: 1;
		padding: 0;
	}

	@media (prefers-reduced-motion: reduce) {
		.page-bodyGrid {
			transition: none;
		}
	}

	body.header-collapsed .headerBanner {
		padding: 6px 16px 8px;
		box-shadow: 0 4px 20px rgba(0, 0, 0, 0.35);
	}

	body.header-collapsed .headerBanner .eyebrow {
		margin: 0 0 2px;
	}

	body.header-collapsed .headerBanner .headerEyebrowRow-copy .sub {
		display: none;
	}

	body.header-collapsed .headerBanner .site-title {
		margin: 0 0 2px;
		font-size: clamp(1rem, 2.4vw, 1.25rem);
	}

	body.header-collapsed .headerBanner .site-nav {
		margin-top: 2px;
	}

	body.header-collapsed .headerBanner .headerBannerAttribution--rail {
		display: none;
	}

	body.header-collapsed .page-bodyGrid {
		padding-top: 5.85rem;
	}

	.container {
		width: 100%;
		margin: 0 auto;
	}

	.headerBanner {
		position: fixed;
		inset: 0 0 auto 0;
		z-index: 200;
		display: flex;
		flex-direction: column;
		align-items: stretch;
		gap: 8px;
		padding: 8px 18px 10px;
		font-size: 13px;
		line-height: 1.55;
		color: var(--text);
		background: rgba(0, 0, 0, 0.28);
		border-bottom: 1px solid rgba(255, 255, 255, 0.11);
		backdrop-filter: blur(16px) saturate(1.12);
		-webkit-backdrop-filter: blur(16px) saturate(1.12);
		box-shadow: 0 1px 0 rgba(0, 0, 0, 0.25);
		transition: padding 0.22s ease, box-shadow 0.22s ease;
	}

	@media (prefers-reduced-motion: reduce) {
		.headerBanner {
			transition: none;
		}
	}

	.eyebrow,
	.panel-label,
	.ticker,
	.kicker {
		font-family: var(--font-mono);
		font-size: 11px;
		font-weight: 500;
		letter-spacing: 0.2em;
		text-transform: uppercase;
	}

	.eyebrow {
		margin: 0 0 6px;
		color: var(--accent);
	}

	.headerEyebrowRow--rail {
		display: flex;
		align-items: center;
		gap: 12px 14px;
		width: 100%;
		box-sizing: border-box;
		flex-wrap: wrap;
		padding: 10px 14px 12px;
		background: var(--header-rail-surface);
		color: #0a0b0d;
		border: 1px solid var(--header-rail-border);
		border-radius: 24px;
		box-shadow: var(--header-rail-shadow);
		font-family: 'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif;
	}

	.logoLink--headerMini {
		flex: 0 0 auto;
		text-decoration: none;
		color: inherit;
		line-height: 0;
	}

	.brand-mark {
		display: grid;
		place-items: center;
		background:
			radial-gradient(circle at 30% 30%, rgba(255, 255, 255, 0.85), rgba(255, 255, 255, 0)),
			linear-gradient(135deg, rgba(170, 90, 255, 0.94), rgba(60, 200, 255, 0.82));
		color: rgba(255, 255, 255, 0.92);
		font-family: var(--font-serif);
		box-shadow: 0 2px 12px rgba(0, 0, 0, 0.35);
	}

	.brand-mark--header {
		width: 36px;
		height: 36px;
		border-radius: 11px;
		font-size: 1.08rem;
		font-weight: 600;
	}

	.headerEyebrowRow-copy {
		flex: 1 1 200px;
		min-width: 0;
	}

	.headerEyebrowRow--rail .eyebrow {
		margin: 0;
		color: #0f766e;
		letter-spacing: 0.14em;
		font-size: 0.72rem;
	}

	.headerEyebrowRow--rail .sub {
		margin: 4px 0 0;
		text-align: left;
		color: var(--header-rail-muted);
		font-size: 0.82rem;
		line-height: 1.45;
		max-width: 42rem;
	}

	.site-title--headerEyebrow {
		margin: 4px 0 0;
		color: #0a0b0d;
		font-size: clamp(1.1rem, 2.4vw, 1.45rem);
	}

	.headerBannerAttribution--rail {
		margin: 0;
		flex: 1 1 200px;
		max-width: min(100%, 20rem);
		font-size: 10px;
		line-height: 1.4;
		color: var(--header-rail-muted);
		text-align: right;
		align-self: center;
	}

	.site-title {
		margin: 0 0 4px;
		font-weight: 700;
		font-size: clamp(1.2rem, 2.6vw, 1.7rem);
		line-height: 1.15;
	}

	.sub {
		margin: 0;
		max-width: 62ch;
		font-size: 12.5px;
		line-height: 1.5;
		color: var(--muted);
	}

	.site-nav {
		margin-top: 6px;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 6px 10px;
		font-size: 12px;
		color: var(--muted);
	}

	.site-nav-pillsWrap {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 8px;
		flex: 1 1 auto;
		min-width: 0;
	}

	.site-nav a {
		color: var(--accent);
		border-bottom: 1px solid rgba(72, 224, 188, 0.35);
	}

	.site-nav a:hover {
		color: var(--accent-warm);
		border-bottom-color: rgba(255, 210, 120, 0.55);
	}

	/* Game-console–style top rail: pills, Inter, no dot separators */
	.site-nav--console {
		align-items: center;
		gap: 8px;
		font-family: 'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif;
	}

	.site-nav--console a {
		border-bottom: none;
		text-decoration: none;
	}

	.site-nav-pill {
		display: inline-flex;
		align-items: center;
		padding: 8px 12px;
		border-radius: 999px;
		border: 1px solid rgba(255, 255, 255, 0.12);
		background: rgba(0, 0, 0, 0.22);
		color: rgba(230, 236, 255, 0.78);
		font-size: 12px;
		font-weight: 500;
		line-height: 1.2;
		transition:
			background 0.15s ease,
			border-color 0.15s ease,
			color 0.15s ease;
	}

	.site-nav-pill:hover {
		color: var(--accent);
		border-color: rgba(72, 224, 188, 0.35);
		background: rgba(72, 224, 188, 0.08);
	}

	.site-nav-pill.is-active {
		color: #0a0b0d;
		background: rgba(255, 255, 255, 0.92);
		border-color: rgba(255, 255, 255, 0.35);
		font-weight: 600;
	}

	.site-nav-pill--ext {
		border-style: dashed;
		color: rgba(200, 220, 255, 0.88);
	}

	.site-nav-pill--ext:hover {
		border-style: solid;
	}

	.site-nav-divider {
		width: 1px;
		height: 22px;
		background: rgba(255, 255, 255, 0.14);
		margin: 0 2px;
	}

	.site-nav--tabs {
		margin-top: 2px;
		padding: 10px 14px 12px;
		width: 100%;
		box-sizing: border-box;
		background: var(--header-rail-surface);
		color: #0a0b0d;
		border: 1px solid var(--header-rail-border);
		border-radius: 24px;
		box-shadow: var(--header-rail-shadow);
	}

	.site-nav--tabs.site-nav--console {
		gap: 10px 12px;
	}

	.site-nav--tabs .site-nav-pill {
		border: 1px solid var(--header-rail-pill-border);
		background: var(--header-rail-pill-bg);
		color: var(--header-rail-muted);
	}

	.site-nav--tabs .site-nav-pill:hover {
		border-color: #0052ff;
		color: #0052ff;
		background: #ffffff;
	}

	.site-nav--tabs .site-nav-pill.is-active {
		color: #ffffff;
		background: #0a0b0d;
		border-color: #0a0b0d;
	}

	.site-nav--tabs .site-nav-pill--ext {
		color: #3d4a63;
		border-style: dashed;
	}

	.site-nav--tabs .site-nav-pill--ext:hover {
		border-style: solid;
		color: #0052ff;
	}

	.site-nav--tabs .site-nav-divider {
		background: #e0e4f0;
	}

	.paywallPill--headerNav {
		margin-left: auto;
		flex: 0 0 auto;
		border-color: var(--header-rail-pill-border);
		background: var(--header-rail-pill-bg);
		color: #0a0b0d;
	}

	.headerBannerSearch {
		margin-top: 0;
		display: flex;
		flex-direction: column;
		gap: 4px;
		width: 100%;
		max-width: min(100%, 42rem);
	}

	.headerBannerSearch--top {
		max-width: 100%;
	}

	.headerBannerSearch-labelRow {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 12px 16px;
		width: 100%;
		flex-wrap: wrap;
	}

	.headerBannerSearch-labelRow .site-title {
		margin: 0;
		text-align: right;
		flex: 0 1 auto;
		min-width: 0;
		font-size: clamp(1.05rem, 2.2vw, 1.55rem);
		line-height: 1.2;
	}

	.headerBannerSearch-label {
		font-family: var(--font-mono);
		font-size: 11px;
		font-weight: 500;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--soft);
	}

	.headerBannerSearch-input {
		width: 100%;
		min-height: 40px;
		padding: 10px 12px;
		border-radius: 12px;
		border: 1px solid rgba(255, 255, 255, 0.12);
		outline: none;
		background: var(--field-bg);
		color: var(--text);
		font-size: 13px;
		box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.18);
	}

	.headerBannerSearch-input::placeholder {
		color: var(--muted);
	}

	.headerBannerSearch-input:focus {
		border-color: rgba(180, 130, 255, 0.45);
