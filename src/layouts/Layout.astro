---
interface Props {
	title?: string;
	description?: string;
	pageClass?: string;
	eyebrow?: string;
	subtitle?: string;
	/** When true, show directory search in the banner (synced with #filter-query on the home page). */
	showHeaderDirectorySearch?: boolean;
}

const {
	title = 'Erika Market Directory',
	description = 'A static market listing directory built from the Erika dataset.',
	pageClass = 'page-home',
	eyebrow = 'Static market directory',
	subtitle = 'Searchable listing intelligence built from the Erika dataset.',
	showHeaderDirectorySearch = false,
} = Astro.props;

const baseUrl = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{title}</title>
	</head>
	<body
		class={`${pageClass}${showHeaderDirectorySearch ? ' has-header-directory-search' : ''}`}
		data-base-url={baseUrl}
	>
		<div class="bgGlow" aria-hidden="true"></div>
		<div class="page-shell">
			<header class="headerBanner" role="banner">
				<div class="eyebrow">{eyebrow}</div>
				<div class="brand">
					<a class="logoLink" href={baseUrl} aria-label="Erika Market Directory">
						<span class="brand-mark">E</span>
					</a>
					<div class="brandText">
						<h1 class="site-title">Erika Market Directory</h1>
						<p class="sub">{subtitle}</p>
					</div>
				</div>
				<nav class="site-nav" aria-label="Site navigation">
					<a href={baseUrl}>Home</a>
					<span>·</span>
					<a href={`${baseUrl}featured/`}>Featured</a>
					<span>·</span>
					<a href={`${baseUrl}#explore`}>Directory</a>
					<span>·</span>
					<a href={`${baseUrl}listing/`}>Listing view</a>
					<span>·</span>
					<a href={`${baseUrl}raw/`}>Raw data</a>
				</nav>
				{
					showHeaderDirectorySearch ? (
						<div class="headerBannerSearch">
							<label class="headerBannerSearch-label" for="header-filter-query">
								Directory search
							</label>
							<input
								id="header-filter-query"
								class="headerBannerSearch-input"
								type="search"
								placeholder="Ticker, company, exchange, country, alias…"
								autocomplete="off"
							/>
						</div>
					) : null
				}
				<div class="headerBannerBottomRow">
					<div class="paywallPill">Educational dataset view only</div>
					<p class="headerBannerAttribution">
						Built from Erika dataset metadata for browsing, filtering, and static profile lookup.
					</p>
				</div>
			</header>
			<main class="wrap">
				<slot />
			</main>
		</div>
		<script is:inline>
			(() => {
				const threshold = 36;
				let ticking = false;
				function sync() {
					document.body.classList.toggle('header-collapsed', window.scrollY > threshold);
					ticking = false;
				}
				function onScroll() {
					if (!ticking) {
						ticking = true;
						requestAnimationFrame(sync);
					}
				}
				window.addEventListener('scroll', onScroll, { passive: true });
				window.addEventListener('resize', onScroll, { passive: true });
				sync();
			})();
		</script>
	</body>
</html>

<style is:global>
	@import url('https://fonts.googleapis.com/css2?family=Arimo:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&family=Instrument+Serif:ital@0;1&display=swap');

	:root {
		color-scheme: dark;
		--font-ui:
			'Arimo', ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI',
			sans-serif;
		--font-serif: 'Instrument Serif', Georgia, serif;
		--font-mono: 'IBM Plex Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
		--bg-strong: #060711;
		--text: rgba(255, 255, 255, 0.92);
		--muted: rgba(255, 255, 255, 0.62);
		--soft: rgba(255, 255, 255, 0.48);
		--accent: rgba(72, 224, 188, 0.92);
		--accent-alt: rgba(170, 90, 255, 0.95);
		--accent-warm: rgba(255, 210, 120, 0.92);
		--card-bg: rgba(0, 0, 0, 0.34);
		--card-border: rgba(255, 255, 255, 0.11);
		--field-bg: rgba(0, 0, 0, 0.24);
		--shadow:
			0 22px 60px rgba(0, 0, 0, 0.35),
			0 0 0 1px rgba(255, 215, 130, 0.06),
			0 0 38px rgba(255, 190, 90, 0.06);
	}

	* {
		box-sizing: border-box;
	}

	html,
	body {
		min-height: 100%;
	}

	html {
		background: radial-gradient(1200px 900px at 50% 0%, #0c1020, #070812 55%, #05050b 100%);
		scroll-behavior: smooth;
	}

	body {
		margin: 0;
		min-width: 320px;
		color: var(--text);
		background: none;
		font-family: var(--font-ui);
		letter-spacing: 0.2px;
	}

	body::before {
		content: '';
		position: fixed;
		inset: 0;
		background:
			radial-gradient(circle at 20% 20%, rgba(255, 255, 255, 0.06), transparent 32%),
			radial-gradient(circle at 78% 18%, rgba(170, 90, 255, 0.14), transparent 24%),
			radial-gradient(circle at 55% 80%, rgba(60, 200, 255, 0.12), transparent 24%),
			radial-gradient(circle at center, rgba(10, 15, 30, 0.3), rgba(5, 5, 11, 0.1) 60%);
		pointer-events: none;
		z-index: 0;
	}

	.bgGlow {
		position: fixed;
		inset: -30vh -30vw;
		background:
			radial-gradient(900px 600px at 20% 20%, rgba(255, 255, 255, 0.08), transparent),
			radial-gradient(800px 500px at 80% 25%, rgba(170, 90, 255, 0.13), transparent),
			radial-gradient(700px 550px at 50% 85%, rgba(60, 200, 255, 0.12), transparent);
		filter: blur(8px);
		pointer-events: none;
		z-index: 0;
	}

	a {
		color: inherit;
		text-decoration: none;
	}

	button,
	input,
	select {
		font: inherit;
	}

	.page-shell {
		position: relative;
		z-index: 1;
	}

	.wrap {
		position: relative;
		z-index: 1;
		max-width: 1380px;
		margin: 0 auto;
		padding: 7.8rem 18px 52px;
		transition: padding-top 0.22s ease;
	}

	body.has-header-directory-search .wrap {
		padding-top: 9.85rem;
	}

	@media (prefers-reduced-motion: reduce) {
		.wrap {
			transition: none;
		}
	}

	body.header-collapsed .headerBanner {
		padding: 6px 16px 8px;
		box-shadow: 0 4px 20px rgba(0, 0, 0, 0.35);
	}

	body.header-collapsed .headerBanner .eyebrow {
		margin: 0 0 2px;
	}

	body.header-collapsed .headerBanner .brand {
		display: contents;
	}

	body.header-collapsed .headerBanner .logoLink {
		display: none;
	}

	body.header-collapsed .headerBanner .brandText {
		display: block;
		align-items: flex-start;
		text-align: left;
	}

	body.header-collapsed .headerBanner .sub {
		display: none;
	}

	body.header-collapsed .headerBanner .site-title {
		margin: 0 0 2px;
		font-size: clamp(1rem, 2.4vw, 1.25rem);
	}

	body.header-collapsed .headerBanner .site-nav {
		margin-top: 2px;
	}

	body.header-collapsed .headerBanner .headerBannerBottomRow {
		margin-top: 4px;
		align-items: center;
	}

	body.header-collapsed .headerBanner .headerBannerAttribution {
		display: none;
	}

	body.header-collapsed .wrap {
		padding-top: 5.85rem;
	}

	.container {
		width: 100%;
		margin: 0 auto;
	}

	.headerBanner {
		position: fixed;
		inset: 0 0 auto 0;
		z-index: 200;
		display: flex;
		flex-direction: column;
		gap: 0;
		padding: 8px 18px 10px;
		font-size: 13px;
		line-height: 1.55;
		color: var(--text);
		background: rgba(0, 0, 0, 0.28);
		border-bottom: 1px solid rgba(255, 255, 255, 0.11);
		backdrop-filter: blur(16px) saturate(1.12);
		-webkit-backdrop-filter: blur(16px) saturate(1.12);
		box-shadow: 0 1px 0 rgba(0, 0, 0, 0.25);
		transition: padding 0.22s ease, box-shadow 0.22s ease;
	}

	@media (prefers-reduced-motion: reduce) {
		.headerBanner {
			transition: none;
		}
	}

	.eyebrow,
	.panel-label,
	.ticker,
	.kicker {
		font-family: var(--font-mono);
		font-size: 11px;
		font-weight: 500;
		letter-spacing: 0.2em;
		text-transform: uppercase;
	}

	.eyebrow {
		margin: 0 0 6px;
		color: var(--accent);
	}

	.brand {
		display: flex;
		align-items: flex-start;
		gap: 12px 16px;
		flex-wrap: wrap;
	}

	.logoLink {
		flex: 0 0 auto;
	}

	.brand-mark {
		display: grid;
		place-items: center;
		width: 84px;
		height: 84px;
		border-radius: 18px;
		background:
			radial-gradient(circle at 30% 30%, rgba(255, 255, 255, 0.85), rgba(255, 255, 255, 0)),
			linear-gradient(135deg, rgba(170, 90, 255, 0.94), rgba(60, 200, 255, 0.82));
		color: rgba(255, 255, 255, 0.92);
		font-family: var(--font-serif);
		font-size: 2.1rem;
		box-shadow: 0 4px 16px rgba(0, 0, 0, 0.5);
	}

	.brandText {
		flex: 1;
		min-width: 0;
		display: flex;
		flex-direction: column;
		align-items: flex-end;
		text-align: right;
	}

	.site-title {
		margin: 0 0 4px;
		font-weight: 700;
		font-size: clamp(1.2rem, 2.6vw, 1.7rem);
		line-height: 1.15;
	}

	.sub {
		margin: 0;
		max-width: 62ch;
		font-size: 12.5px;
		line-height: 1.5;
		color: var(--muted);
	}

	.site-nav {
		margin-top: 6px;
		display: flex;
		flex-wrap: wrap;
		gap: 6px 10px;
		font-size: 12px;
		color: var(--muted);
	}

	.site-nav a {
		color: var(--accent);
		border-bottom: 1px solid rgba(72, 224, 188, 0.35);
	}

	.site-nav a:hover {
		color: var(--accent-warm);
		border-bottom-color: rgba(255, 210, 120, 0.55);
	}

	.headerBannerSearch {
		margin-top: 8px;
		display: flex;
		flex-direction: column;
		gap: 4px;
		width: 100%;
		max-width: min(100%, 42rem);
	}

	.headerBannerSearch-label {
		font-family: var(--font-mono);
		font-size: 11px;
		font-weight: 500;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--soft);
	}

	.headerBannerSearch-input {
		width: 100%;
		min-height: 40px;
		padding: 10px 12px;
		border-radius: 12px;
		border: 1px solid rgba(255, 255, 255, 0.12);
		outline: none;
		background: var(--field-bg);
		color: var(--text);
		font-size: 13px;
		box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.18);
	}

	.headerBannerSearch-input::placeholder {
		color: var(--muted);
	}

	.headerBannerSearch-input:focus {
		border-color: rgba(180, 130, 255, 0.45);
		box-shadow:
			inset 0 0 0 1px rgba(0, 0, 0, 0.18),
			0 0 0 3px rgba(180, 130, 255, 0.12);
	}

	body.header-collapsed .headerBannerSearch {
		margin-top: 4px;
		max-width: min(100%, 36rem);
	}

	body.header-collapsed .headerBannerSearch-input {
		min-height: 36px;
		padding: 8px 10px;
		font-size: 12.5px;
	}

	body.has-header-directory-search.header-collapsed .wrap {
		padding-top: 7.35rem;
	}

	@media (max-width: 900px) {
		body.has-header-directory-search.header-collapsed .wrap {
			padding-top: 7.85rem;
		}
	}

	@media (max-width: 720px) {
		body.has-header-directory-search.header-collapsed .wrap {
			padding-top: 8.65rem;
		}
	}

	.headerBannerBottomRow {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-end;
		justify-content: space-between;
		gap: 6px 16px;
		margin-top: 8px;
	}

	.headerBannerAttribution {
		margin: 0;
		max-width: min(100%, 46ch);
		font-size: 10.5px;
		line-height: 1.45;
		color: var(--muted);
		text-align: right;
	}

	.paywallPill,
	.metaPill {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		padding: 7px 10px;
		border-radius: 999px;
		border: 1px solid rgba(120, 200, 255, 0.22);
		background: rgba(0, 0, 0, 0.22);
		color: rgba(230, 244, 255, 0.92);
		font-size: 12px;
		line-height: 1;
	}

	.disclaimer {
		width: 100%;
		font-size: 12px;
		line-height: 1.35;
		color: rgba(255, 255, 255, 0.75);
	}

	.disclaimer__text {
		margin: 0;
		font-style: italic;
	}

	.card {
		padding: 16px;
		border-radius: 18px;
		background: var(--card-bg);
		border: 1px solid var(--card-border);
		box-shadow: var(--shadow);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
	}

	.tileTop,
	.section-heading,
	.results-toolbar,
	.pagination-row,
	.metaRow {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
		flex-wrap: wrap;
	}

	.tileTop {
		align-items: flex-start;
	}

	.ticker,
	.kicker,
	.panel-label {
		color: var(--accent);
	}

	.name {
		margin-top: 4px;
		font-size: 13px;
		line-height: 1.5;
		color: var(--muted);
	}

	.section-heading {
		margin-bottom: 14px;
	}

	.section-heading h2 {
		margin: 0;
		font-size: clamp(1.45rem, 2vw, 2rem);
		font-weight: 600;
	}

	.section-heading p {
		margin: 4px 0 0;
		max-width: 54rem;
		color: var(--muted);
	}

	.badge {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.45rem 0.72rem;
		border-radius: 999px;
		border: 1px solid rgba(255, 255, 255, 0.12);
		background: rgba(255, 255, 255, 0.06);
		color: rgba(255, 255, 255, 0.86);
		font-size: 0.8rem;
		line-height: 1;
	}

	.badge.success {
		border-color: rgba(72, 224, 188, 0.35);
		background: rgba(72, 224, 188, 0.1);
	}

	.badge.warning {
		border-color: rgba(255, 210, 120, 0.34);
		background: rgba(255, 210, 120, 0.1);
	}

	.badge.muted {
		color: rgba(255, 255, 255, 0.75);
	}

	.button,
	.button-secondary {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.5rem;
		padding: 11px 14px;
		border-radius: 14px;
		border: 1px solid rgba(255, 255, 255, 0.12);
		cursor: pointer;
		transition: transform 90ms ease, background 120ms ease, border-color 120ms ease;
	}

	.button {
		background: linear-gradient(135deg, rgba(170, 90, 255, 0.35), rgba(60, 200, 255, 0.22));
		border-color: rgba(180, 130, 255, 0.35);
		color: rgba(255, 255, 255, 0.92);
	}

	.button-secondary {
		background: rgba(255, 255, 255, 0.06);
		color: rgba(255, 255, 255, 0.86);
	}

	.button:hover,
	.button-secondary:hover {
		background: rgba(255, 255, 255, 0.085);
		border-color: rgba(255, 255, 255, 0.18);
	}

	.button:active,
	.button-secondary:active {
		transform: translateY(1px);
	}

	.field {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.field span {
		color: var(--muted);
		font-family: var(--font-mono);
		font-size: 11px;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.field input,
	.field select {
		min-height: 46px;
		padding: 12px 14px;
		border-radius: 14px;
		border: 1px solid rgba(255, 255, 255, 0.12);
		outline: none;
		background: var(--field-bg);
		color: var(--text);
		box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.18);
	}

	.field input:focus,
	.field select:focus {
		border-color: rgba(180, 130, 255, 0.45);
		box-shadow:
			inset 0 0 0 1px rgba(0, 0, 0, 0.18),
			0 0 0 4px rgba(180, 130, 255, 0.12);
	}

	.muted,
	.metaHint {
		color: var(--muted);
	}

	.metaHint {
		font-size: 12px;
	}

	@media (max-width: 900px) {
		.wrap {
			padding-top: 9.8rem;
		}

		body.has-header-directory-search .wrap {
			padding-top: 11.85rem;
		}

		body.header-collapsed .wrap {
			padding-top: 6.35rem;
		}

		.brandText {
			align-items: flex-start;
			text-align: left;
		}
	}

	@media (max-width: 720px) {
		.wrap {
			padding-top: 11.5rem;
			padding-inline: 14px;
		}

		body.has-header-directory-search .wrap {
			padding-top: 13.75rem;
		}

		body.header-collapsed .wrap {
			padding-top: 7.1rem;
		}

		.brand-mark {
			width: 64px;
			height: 64px;
			font-size: 1.6rem;
		}

		.headerBannerAttribution {
			text-align: left;
		}
	}
</style>
