function parseHttpUrl(raw: string): URL | null {
	if (!raw) return null;
	try {
		const withProto = raw.includes('://') ? raw : `http://${raw}`;
		const u = new URL(withProto);
		if (u.username || u.password) return null;
		if (u.protocol !== 'http:' && u.protocol !== 'https:') return null;
		return u;
	} catch {
		return null;
	}
}

function rerunIframeHref(u: URL): string | null {
	const allowRaw = (import.meta.env.PUBLIC_RERUN_EMBED_HOSTS || '').trim();
	if (allowRaw) {
		const hosts = allowRaw
			.split(',')
			.map((h: string) => h.trim().toLowerCase())
			.filter(Boolean);
		const host = u.hostname.toLowerCase();
		if (!hosts.includes(host)) return null;
	}
	return u.href;
}

const rerunViewerUrl = parseHttpUrl(rerunViewerRaw);
const rerunOpenHref = rerunViewerUrl ? rerunViewerUrl.href : null;
const rerunIframeSrc = rerunViewerUrl ? rerunIframeHref(rerunViewerUrl) : null;

