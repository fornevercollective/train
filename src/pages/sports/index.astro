							<span class="sports-field-chip-v">high press · 4-3-3 detect</span>
						</div>
						<div class="sports-field-chip mono small">
							<span class="sports-field-chip-k">field</span>
							<span class="sports-field-chip-v">line snap · homography err 0.4px</span>
						</div>
						<div class="sports-field-chip mono small">
							<span class="sports-field-chip-k">hex</span>
							<span class="sports-field-chip-v">cell 7f2a · ladder rung 4</span>
						</div>
					</div>
					<p class="muted micro sports-field-out-foot">
						Pipe JSON / WebSocket shards from your workpad into these tiles; keep GPU + splat decode off GitHub Pages.
					</p>
				</section>
			</div>
		</div>
	</section>
</Layout>

<script is:inline define:vars={{ genreTabsForClient, marchBundle }}>
	(() => {
		const tabs = Array.from(document.querySelectorAll('[data-genre-tab]'));
		const readout = document.getElementById('sports-genre-readout');
		const liveTitle = document.getElementById('sports-live-program');
		const liveSub = document.getElementById('sports-live-program-sub');
		const railUl = document.getElementById('sports-rail-lines');
		const weekHint = document.getElementById('sports-rail-week-hint');
		const marchPanel = document.getElementById('sports-march-panel');
		const marchSeason = document.getElementById('march-season-select');
		const marchBracket = document.getElementById('march-bracket-summary');
		const marchMarkets = document.getElementById('march-markets-list');
		if (!tabs.length || !readout || !liveTitle || !liveSub || !railUl) return;

		const byId = new Map(genreTabsForClient.map((g) => [g.id, g]));
		const seasonsByYear = new Map((marchBundle.seasons || []).map((s) => [s.year, s]));

		const TOURNEY_Q = 'tourney';

		function readTourneyYear() {
			try {
				const raw = new URLSearchParams(window.location.search).get(TOURNEY_Q);
				if (raw == null || raw === '') return null;
				const y = Number(raw);
				if (!Number.isFinite(y)) return null;
				return seasonsByYear.has(y) ? y : null;
			} catch {
				return null;
			}
		}

		function pushTourneyYear(y) {
			try {
				const u = new URL(window.location.href);
				u.searchParams.set(TOURNEY_Q, String(y));
				window.history.replaceState({}, '', u.toString());
			} catch {}
		}

		function venueLabel(v) {
			if (v === 'kalshi') return 'Kalshi';
			if (v === 'polymarket') return 'Polymarket';
			return String(v || 'Venue');
		}

		function kindLabel(k) {
			if (k === 'champion') return 'Champion / futures';
			if (k === 'game') return 'Game';
			if (k === 'region') return 'Region / advance';
			if (k === 'prop') return 'Prop';
			return String(k || 'Market');
		}

		function seeds15FromR64(r64) {
			const rows = [];
			if (!Array.isArray(r64)) return rows;
			const seen = new Set();
			for (const g of r64) {
				[
					{ s: g.s1, n: g.n1 },
					{ s: g.s2, n: g.n2 },
				].forEach((x) => {
					if (x.s >= 1 && x.s <= 5 && x.n && !seen.has(x.n)) {
						seen.add(x.n);
						rows.push({ seed: x.s, name: x.n });
					}
				});
			}
			rows.sort((a, b) => a.seed - b.seed);
			return rows;
		}

		function matchupCard(g) {
			const wrap = document.createElement('div');
			wrap.className = 'sports-bracket-game sports-bracket-game--tile';
			if (g.id) wrap.dataset.gameId = g.id;

			function line(seed, name, pts, win) {
				const row = document.createElement('div');
				row.className = 'sports-bracket-line' + (win ? ' is-winner' : '');
				const sEl = document.createElement('span');
				sEl.className = 'sports-bracket-seed mono';
				sEl.textContent = String(seed);
				const nEl = document.createElement('span');
				nEl.className = 'sports-bracket-name';
				nEl.textContent = name || '—';
				const pEl = document.createElement('span');
				pEl.className = 'sports-bracket-pts mono';
				pEl.textContent = String(pts);
				row.append(sEl, nEl, pEl);
				return row;
			}

			wrap.append(
				line(g.s1, g.n1, g.p1, g.w === 1),
				line(g.s2, g.n2, g.p2, g.w === 2)
			);
			const idRow = document.createElement('div');
			idRow.className = 'sports-bracket-id mono micro muted';
			idRow.textContent = g.id || '';
			wrap.append(idRow);

			if (g.id) {
				const actions = document.createElement('div');
				actions.className = 'sports-bracket-game-actions';
				const copyBtn = document.createElement('button');
				copyBtn.type = 'button';
				copyBtn.className = 'sports-bracket-copy mono micro';
				copyBtn.setAttribute('aria-label', 'Copy bracket game id ' + g.id);
				copyBtn.textContent = 'Copy id';
				copyBtn.addEventListener('click', () => {
					const id = g.id;
					function done(ok) {
						copyBtn.textContent = ok ? 'Copied' : 'Copy failed';
						window.setTimeout(() => {
							copyBtn.textContent = 'Copy id';
						}, 1600);
					}
					if (navigator.clipboard && typeof navigator.clipboard.writeText === 'function') {
						navigator.clipboard.writeText(id).then(() => done(true), () => done(false));
					} else {
						done(false);
					}
				});
				actions.append(copyBtn);
				wrap.append(actions);
			}

			return wrap;
		}

		function bracketColumn(label, games, singleGame) {
			const card = document.createElement('div');
			card.className = 'sports-bracket-col-card';
			const h = document.createElement('div');
			h.className = 'sports-bracket-col-head mono small';
			h.textContent = label;
			const stack = document.createElement('div');
			stack.className = 'sports-bracket-col-stack';
			if (singleGame && singleGame.id) {
				stack.append(matchupCard(singleGame));
			} else if (Array.isArray(games)) {
				for (const g of games) stack.append(matchupCard(g));
			}
			card.append(h, stack);
			return card;
		}

		function appendFullBracket(parent, bracket) {
			if (!bracket || !Array.isArray(bracket.regions)) return;

			const h = document.createElement('h3');
			h.className = 'sports-march-subhead mono sports-march-subhead--spaced';
			h.textContent = 'Regional brackets · R64 → E8';
			parent.append(h);

			const shell = document.createElement('div');
			shell.className = 'sports-bracket-shell';

			const tabs = document.createElement('div');
			tabs.className = 'sports-bracket-region-tabs';
			tabs.setAttribute('role', 'tablist');
			tabs.setAttribute('aria-label', 'Bracket region');

			const mount = document.createElement('div');
			mount.className = 'sports-bracket-region-mount';
			mount.id = 'march-bracket-region-panel';
			mount.setAttribute('role', 'tabpanel');
			mount.setAttribute('aria-label', 'Regional bracket for selected quadrant');

			const seedStrip = document.createElement('div');
			seedStrip.className = 'sports-bracket-seedstrip';
			seedStrip.id = 'march-bracket-seedstrip';

			const tabButtons = [];

			function paintRegion(idx) {
				const reg = bracket.regions[idx];
				if (!reg) return;
				mount.replaceChildren();
				const row = document.createElement('div');
				row.className = 'sports-bracket-cols';
				row.append(
					bracketColumn('Round of 64', reg.r64),
					bracketColumn('Round of 32', reg.r32),
					bracketColumn('Sweet 16', reg.s16),
					bracketColumn('Elite 8', null, reg.e8)
				);
				mount.append(row);

				seedStrip.replaceChildren();
				const lab = document.createElement('span');
				lab.className = 'mono small muted';
				lab.textContent = 'Seeds 1–5 · ' + reg.name;
				seedStrip.append(lab);
				for (const x of seeds15FromR64(reg.r64)) {
					const chip = document.createElement('span');
					chip.className = 'sports-bracket-seed-chip mono small';
					chip.textContent = String(x.seed) + ' ' + x.name;
					seedStrip.append(chip);
				}
			}

			function activateTab(idx) {
				const n = bracket.regions.length;
				const i = Math.max(0, Math.min(n - 1, idx));
				tabButtons.forEach((el, j) => {
					const on = j === i;
					el.setAttribute('aria-selected', on ? 'true' : 'false');
					el.tabIndex = on ? 0 : -1;
				});
				paintRegion(i);
			}

			bracket.regions.forEach((reg, idx) => {
				const b = document.createElement('button');
				b.type = 'button';
				b.className = 'sports-bracket-region-tab';
				b.setAttribute('role', 'tab');
				b.id = 'march-bracket-tab-' + idx;
				b.setAttribute('aria-controls', 'march-bracket-region-panel');
				b.dataset.regionIndex = String(idx);
				b.textContent = reg.name;
				b.setAttribute('aria-selected', idx === 0 ? 'true' : 'false');
				b.tabIndex = idx === 0 ? 0 : -1;
				b.addEventListener('click', () => {
					activateTab(idx);
					tabButtons[idx].focus();
				});
				tabButtons.push(b);
				tabs.append(b);
			});

			tabs.addEventListener('keydown', (e) => {
				const i = tabButtons.findIndex((t) => t.getAttribute('aria-selected') === 'true');
				if (i < 0) return;
				let next = i;
				if (e.key === 'ArrowRight') {
					e.preventDefault();
					next = Math.min(tabButtons.length - 1, i + 1);
				} else if (e.key === 'ArrowLeft') {
					e.preventDefault();
					next = Math.max(0, i - 1);
				} else if (e.key === 'Home') {
					e.preventDefault();
					next = 0;
				} else if (e.key === 'End') {
					e.preventDefault();
					next = tabButtons.length - 1;
				} else {
					return;
				}
				activateTab(next);
				tabButtons[next].focus();
			});

			shell.append(tabs, seedStrip, mount);
			parent.append(shell);
			activateTab(0);

			const natH = document.createElement('h3');
			natH.className = 'sports-march-subhead mono sports-march-subhead--spaced';
			natH.textContent = 'Final Four & championship';
			parent.append(natH);

			const natRow = document.createElement('div');
			natRow.className = 'sports-bracket-national';

			function nationalRoundCard(labelText, games, singleGame) {
				const card = document.createElement('div');
				card.className = 'sports-bracket-col-card sports-bracket-national-card';
				const h = document.createElement('div');
				h.className = 'sports-bracket-col-head mono small';
				h.textContent = labelText;
				const stack = document.createElement('div');
				stack.className = 'sports-bracket-col-stack';
				if (singleGame && singleGame.id) {
					stack.append(matchupCard(singleGame));
				} else if (Array.isArray(games)) {
					for (const g of games) stack.append(matchupCard(g));
				}
				card.append(h, stack);
				return card;
			}

			const ffWrap = nationalRoundCard('Semifinals', bracket.finalFour, null);
			natRow.append(ffWrap);
			if (bracket.championship && bracket.championship.id) {
				const chWrap = nationalRoundCard('Title game', null, bracket.championship);
				chWrap.classList.add('sports-bracket-national-card--champ');
				natRow.append(chWrap);
			}
			parent.append(natRow);
		}

		function renderMarch(year) {
			if (!marchBracket || !marchMarkets) return;
			const s = seasonsByYear.get(Number(year));
			marchBracket.replaceChildren();
			marchMarkets.replaceChildren();
			if (!s) {
				const p = document.createElement('p');
				p.className = 'muted small';
				p.textContent = 'No data for that season.';
				marchBracket.append(p);
				return;
			}

			const meta = document.createElement('div');
			meta.className = 'sports-march-meta sports-march-summary-card muted small';
			const metaP = document.createElement('p');
			metaP.className = 'sports-march-meta-line';
			metaP.append(
				document.createTextNode(s.label + ' · Selection Sunday ' + String(s.selectionSunday || '—'))
			);
			meta.append(metaP);
			const sites = document.createElement('p');
			sites.className = 'sports-march-meta-line';
			sites.append(
				document.createTextNode('Final Four site: ' + (s.finalFourSite || '—') + ' · Title: ' + (s.titleSite || '—'))
			);
			meta.append(sites);
			marchBracket.append(meta);

			if (Array.isArray(s.regions) && s.regions.length) {
				const regTitle = document.createElement('h3');
				regTitle.className = 'sports-march-subhead mono sports-march-subhead--spaced';
				regTitle.textContent = '1-seeds by region (snapshot)';
				marchBracket.append(regTitle);
				const regGrid = document.createElement('div');
				regGrid.className = 'sports-march-region-grid';
				for (const r of s.regions) {
					const card = document.createElement('div');
					card.className = 'sports-march-region-card';
					const nm = document.createElement('span');
					nm.className = 'sports-march-region-name mono small';
					nm.textContent = r.name;
					const one = document.createElement('span');
					one.className = 'sports-march-region-one';
					one.textContent = r.oneSeed || '—';
					card.append(nm, one);
					regGrid.append(card);
				}
				marchBracket.append(regGrid);
			}

			if (s.bracket && s.bracket.regions) {
				appendFullBracket(marchBracket, s.bracket);
			} else if (Array.isArray(s.finalFour) && s.finalFour.length) {
				const ffTitle = document.createElement('h3');
				ffTitle.className = 'sports-march-subhead mono sports-march-subhead--spaced';
				ffTitle.textContent = 'Final Four';
				marchBracket.append(ffTitle);
				const ffGrid = document.createElement('div');
				ffGrid.className = 'sports-march-ff-grid';
				for (const t of s.finalFour) {
					const cell = document.createElement('div');
					cell.className = 'sports-march-ff-cell';
					const seed = document.createElement('span');
					seed.className = 'sports-march-ff-seed mono small';
					seed.textContent = String(t.seed) + ' seed';
					const name = document.createElement('span');
					name.className = 'sports-march-ff-name';
					name.textContent = t.name || '—';
					const rg = document.createElement('span');
					rg.className = 'muted micro';
					rg.textContent = t.region || '';
					cell.append(seed, name, rg);
					ffGrid.append(cell);
				}
				marchBracket.append(ffGrid);
			} else {
				const ph = document.createElement('p');
				ph.className = 'muted small sports-march-placeholder';
				ph.textContent =
					'Final Four field not loaded for this season yet — extend JSON when the bracket is official.';
				marchBracket.append(ph);
			}

			if (!(s.bracket && s.bracket.regions) && s.champion && s.champion.name) {
				const ch = document.createElement('div');
				ch.className = 'sports-march-champ';
				const chLab = document.createElement('span');
				chLab.className = 'mono small muted';
				chLab.textContent = 'Champion';
				const chName = document.createElement('strong');
				chName.textContent =
					s.champion.name + (s.champion.seed != null ? ' (' + String(s.champion.seed) + ' seed)' : '');
				ch.append(chLab, chName);
				if (s.runnerUp && s.runnerUp.name) {
					const ru = document.createElement('span');
					ru.className = 'muted small';
					ru.textContent = ' · runner-up ' + s.runnerUp.name;
					ch.append(ru);
				}
				marchBracket.append(ch);
			}

			const mk = Array.isArray(s.markets) ? s.markets : [];
			for (const m of mk) {
				const li = document.createElement('li');
				li.className = 'sports-march-market-row';
				if (m.bracketGameId) li.dataset.bracketGameId = String(m.bracketGameId);
				const left = document.createElement('div');
				left.className = 'sports-march-market-main';
				const title = document.createElement('a');
				title.className = 'sports-march-market-title';
				title.href = m.url || '#';
				title.target = '_blank';
				title.rel = 'noopener noreferrer';
				title.textContent = m.title || m.id || 'Market';
				const sub = document.createElement('div');
				sub.className = 'sports-march-market-sub muted small';
				const parts = [kindLabel(m.kind), venueLabel(m.venue)];
				if (m.bracketGameId) parts.push('id ' + m.bracketGameId);
				sub.textContent = parts.join(' · ');
				left.append(title, sub);
				if (m.note) {
					const note = document.createElement('p');
					note.className = 'sports-march-market-note micro muted';
					note.textContent = m.note;
					left.append(note);
				}
				const badge = document.createElement('span');
				badge.className = 'sports-march-market-badge mono small';
				badge.textContent = venueLabel(m.venue);
				li.append(left, badge);
				marchMarkets.append(li);
			}
			if (!mk.length) {
				const empty = document.createElement('li');
				empty.className = 'muted small';
				empty.textContent = 'No market rows for this season — add objects under `markets` in JSON.';
				marchMarkets.append(empty);
			}

			if (marchMarkets && marchBracket) {
				marchMarkets.querySelectorAll('.sports-march-market-row').forEach((li) => {
					li.addEventListener('mouseenter', () => {
						const id = li.dataset.bracketGameId;
						if (!id) return;
						const esc = window.CSS && typeof window.CSS.escape === 'function' ? window.CSS.escape(id) : id;
						const cell = marchBracket.querySelector('[data-game-id="' + esc + '"]');
						if (cell) cell.classList.add('is-highlighted');
					});
					li.addEventListener('mouseleave', () => {
						marchBracket.querySelectorAll('.sports-bracket-game.is-highlighted').forEach((el) => {
							el.classList.remove('is-highlighted');
						});
					});
				});
			}
		}

		if (marchSeason && marchBracket && marchMarkets) {
			const urlY = readTourneyYear();
			if (urlY != null) marchSeason.value = String(urlY);
			const initialY = Number(marchSeason.value) || marchBundle.defaultSeason;
			renderMarch(initialY);
			marchSeason.addEventListener('change', () => {
				const y = Number(marchSeason.value) || marchBundle.defaultSeason;
				renderMarch(y);
				pushTourneyYear(y);
			});
		}

		function renderUpcoming(rows) {
			railUl.replaceChildren(
				...rows.map((row) => {
					const li = document.createElement('li');
					li.className = 'sports-upcoming-item';
					const when = document.createElement('span');
					when.className = 'sports-upcoming-when mono';
					when.textContent = row.when;
					const body = document.createElement('div');
					body.className = 'sports-upcoming-body';
					const title = document.createElement('span');
					title.className = 'sports-upcoming-title';
					title.textContent = row.title;
					const mkts = document.createElement('span');
					mkts.className = 'sports-upcoming-mkts muted';
					mkts.textContent = row.markets;
					body.append(title, mkts);
					li.append(when, body);
					return li;
				})
			);
		}

		function select(id) {
			const g = byId.get(id);
			if (!g) return;
			tabs.forEach((el) => {
				const on = el.getAttribute('data-genre-tab') === id;
				el.setAttribute('aria-selected', on ? 'true' : 'false');
				el.tabIndex = on ? 0 : -1;
			});
			readout.textContent = `${g.section === 'sports' ? 'Sports' : 'Markets'} · ${g.label}`;
			liveTitle.textContent = g.heroTitle;
			liveSub.textContent = g.heroSub;
			renderUpcoming(g.upcoming);
			if (weekHint) {
				weekHint.textContent =
					g.section === 'sports'
						? 'This week · games & props (sample slate)'
						: 'This week · macro & event contracts (sample slate)';
			}
			if (marchPanel) {
				if (id === 'ncaamb') marchPanel.classList.add('sports-march-panel--ncaamb');
				else marchPanel.classList.remove('sports-march-panel--ncaamb');
			}
		}

		tabs.forEach((btn) => {
			btn.addEventListener('click', () => select(btn.getAttribute('data-genre-tab') || ''));
			btn.addEventListener('keydown', (e) => {
				if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft' && e.key !== 'Home' && e.key !== 'End') return;
				e.preventDefault();
				const i = tabs.indexOf(btn);
				let next = i;
				if (e.key === 'ArrowRight') next = Math.min(tabs.length - 1, i + 1);
				if (e.key === 'ArrowLeft') next = Math.max(0, i - 1);
				if (e.key === 'Home') next = 0;
				if (e.key === 'End') next = tabs.length - 1;
				const t = tabs[next];
				if (t) {
					t.focus();
					select(t.getAttribute('data-genre-tab') || '');
				}
			});
		});
	})();
</script>

<script is:inline>
	(() => {
		const ESPN_SCOREBOARD =
			'https://site.api.espn.com/apis/site/v2/sports/basketball/mens-college-basketball/scoreboard';
		const ESPN_Q = 'espnDate';

		const statusEl = document.getElementById('sports-ncaamb-live-status');
		const gamesEl = document.getElementById('sports-ncaamb-live-games');
		const dateInput = document.getElementById('sports-ncaamb-live-date');
		const applyBtn = document.getElementById('sports-ncaamb-live-apply');
		const refreshBtn = document.getElementById('sports-ncaamb-live-refresh');
		if (!statusEl || !gamesEl || !dateInput) return;

		function localYmdCompact(d) {
			const y = d.getFullYear();
			const m = String(d.getMonth() + 1).padStart(2, '0');
			const day = String(d.getDate()).padStart(2, '0');
			return `${y}${m}${day}`;
		}

		function hyphenToCompact(h) {
			const compact = String(h || '')
				.trim()
				.replace(/-/g, '');
			return /^\d{8}$/.test(compact) ? compact : null;
		}

		function compactToHyphen(c) {
			return /^\d{8}$/.test(c) ? `${c.slice(0, 4)}-${c.slice(4, 6)}-${c.slice(6, 8)}` : null;
		}

		function readUrlCompact() {
			try {
				const raw = new URLSearchParams(window.location.search).get(ESPN_Q);
				if (!raw) return null;
				const t = raw.trim();
				if (/^\d{8}$/.test(t)) return t;
				return hyphenToCompact(t);
			} catch {
				return null;
			}
		}

		function pushUrlCompact(compact) {
			try {
				const u = new URL(window.location.href);
				u.searchParams.set(ESPN_Q, compact);
				window.history.replaceState({}, '', u.toString());
			} catch {}
		}

		function initDateInput() {
			const urlC = readUrlCompact();
			const fallback = localYmdCompact(new Date());
			const compact = urlC || fallback;
			const hyp = compactToHyphen(compact);
			if (hyp) dateInput.value = hyp;
		}

		function parseEvent(ev) {
			const comp = ev.competitions && ev.competitions[0];
			if (!comp) return null;
			const teams = comp.competitors || [];
			const home = teams.find((t) => t.homeAway === 'home');
			const away = teams.find((t) => t.homeAway === 'away');
			const st = comp.status && comp.status.type;
			const state = st && st.state ? String(st.state) : '';
			const completed = st && st.completed === true;
			return {
				label: String(ev.shortName || ev.name || '').trim() || 'Game',
				detail: String((st && (st.detail || st.shortDetail || st.description)) || '').trim(),
				state,
				completed,
				home: home
					? {
							name: String(
								(home.team && (home.team.shortDisplayName || home.team.displayName)) || 'Home'
							).trim(),
							score: home.score != null ? String(home.score) : '—',
						}
					: null,
				away: away
					? {
							name: String(
								(away.team && (away.team.shortDisplayName || away.team.displayName)) || 'Away'
							).trim(),
							score: away.score != null ? String(away.score) : '—',
						}
					: null,
			};
		}

		function renderGame(p) {
			const row = document.createElement('div');
			row.className = 'sports-ncaamb-live-game';
			if (p.completed) row.classList.add('sports-ncaamb-live-game--final');
			if (!p.completed && p.state === 'in') row.classList.add('sports-ncaamb-live-game--live');

			const top = document.createElement('div');
			top.className = 'sports-ncaamb-live-game-top';
			const name = document.createElement('span');
			name.className = 'sports-ncaamb-live-game-name mono small';
			name.textContent = p.label;
			const stat = document.createElement('span');
			stat.className = 'muted micro sports-ncaamb-live-game-stat';
			stat.textContent = p.detail || (p.completed ? 'Final' : p.state === 'in' ? 'Live' : '');
			top.appendChild(name);
			top.appendChild(stat);

			const mid = document.createElement('div');
			mid.className = 'sports-ncaamb-live-game-mid';
			const awayCell = document.createElement('div');
			awayCell.className = 'sports-ncaamb-live-team';
			const awayN = document.createElement('span');
			awayN.className = 'sports-ncaamb-live-team-name';
			awayN.textContent = p.away ? p.away.name : '—';
			const awayS = document.createElement('span');
			awayS.className = 'sports-ncaamb-live-team-score mono';
			awayS.textContent = p.away ? p.away.score : '—';
			awayCell.appendChild(awayN);
			awayCell.appendChild(awayS);

			const vs = document.createElement('span');
			vs.className = 'sports-ncaamb-live-vs muted micro';
			vs.textContent = '@';

			const homeCell = document.createElement('div');
			homeCell.className = 'sports-ncaamb-live-team sports-ncaamb-live-team--home';
			const homeN = document.createElement('span');
			homeN.className = 'sports-ncaamb-live-team-name';
			homeN.textContent = p.home ? p.home.name : '—';
			const homeS = document.createElement('span');
			homeS.className = 'sports-ncaamb-live-team-score mono';
			homeS.textContent = p.home ? p.home.score : '—';
			homeCell.appendChild(homeN);
			homeCell.appendChild(homeS);

			mid.appendChild(awayCell);
			mid.appendChild(vs);
			mid.appendChild(homeCell);

			row.appendChild(top);
			row.appendChild(mid);
			return row;
		}

		async function loadBoard() {
			const compact = hyphenToCompact(dateInput.value) || localYmdCompact(new Date());
			const hyp = compactToHyphen(compact);
			if (hyp) dateInput.value = hyp;
			pushUrlCompact(compact);

			statusEl.textContent = 'Loading scoreboard…';
			gamesEl.replaceChildren();

			const url = `${ESPN_SCOREBOARD}?dates=${encodeURIComponent(compact)}&limit=400`;
			let data;
			try {
				const r = await fetch(url, { credentials: 'omit' });
				if (!r.ok) throw new Error(String(r.status));
				data = await r.json();
			} catch {
				statusEl.textContent =
					'Could not load ESPN from this origin (network or browser block). Use the links above or open ESPN directly.';
				const p = document.createElement('p');
				p.className = 'muted small';
				const a = document.createElement('a');
				a.href = `https://www.espn.com/mens-college-basketball/scoreboard/_/date/${compact}`;
				a.target = '_blank';
				a.rel = 'noopener noreferrer';
				a.textContent = `ESPN scoreboard · ${compact}`;
				p.appendChild(a);
				gamesEl.appendChild(p);
				return;
			}

			const events = Array.isArray(data.events) ? data.events : [];
			const dayLabel = (data.day && data.day.date) || compact;
			if (!events.length) {
				statusEl.textContent = `No games in ESPN feed for ${dayLabel} (off day or outside the MBB calendar).`;
				return;
			}

			statusEl.textContent = `${events.length} games · ESPN day ${dayLabel}`;

			const frag = document.createDocumentFragment();
			for (const ev of events) {
				const p = parseEvent(ev);
				if (!p || !p.home || !p.away) continue;
				frag.appendChild(renderGame(p));
			}
			gamesEl.appendChild(frag);
		}

		applyBtn && applyBtn.addEventListener('click', () => void loadBoard());
		refreshBtn && refreshBtn.addEventListener('click', () => void loadBoard());
		initDateInput();
		void loadBoard();
	})();
</script>

