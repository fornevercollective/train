---
import Layout from '../../layouts/Layout.astro';
import ModelsLeaderboardECharts from '../../components/ModelsLeaderboardECharts.astro';
import ModelsTesterCompare from '../../components/ModelsTesterCompare.astro';
import { benchmarkBlocks, llmDeskRows } from '../../lib/models-leaderboard-data';

const baseUrl = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const modelsPayload = encodeURIComponent(JSON.stringify({ rows: llmDeskRows }));
const modelCategories = [
	{ key: 'all', label: 'All' },
	{ key: 'chat', label: 'Chat' },
	{ key: 'vision', label: 'Vision' },
	{ key: 'image', label: 'Image' },
	{ key: 'audio', label: 'Audio' },
	{ key: 'video', label: 'Video' },
	{ key: 'transcribe', label: 'Transcribe' },
	{ key: 'embeddings', label: 'Embeddings' },
	{ key: 'rerank', label: 'Rerank' },
	{ key: 'moderation', label: 'Moderation' },
];
---

<Layout
	title="Models · LLM leaderboard (illustrative)"
	description="Static Train page with Artificial Analysis– and Onyx-style leaderboard layout: charts and tables for education only."
	pageClass="page-models"
	eyebrow="Models desk"
	subtitle="Independent-style rankings and benchmark rows rendered statically on Train — not live vendor APIs or official benchmark scores."
	eyebrowAttribution="Train models desk — static UI. For real side-by-side prompt evaluation in GitHub, enable GitHub Models on the repository (Compare tab, public preview)."
>
	<section class="container models-shell">
		<header class="models-hero card">
			<p class="models-hero-eyebrow">LLM leaderboard</p>
			<h1 class="models-hero-title">Compare models like leaderboard sites — on static GitHub Pages</h1>
			<p class="models-hero-lede muted">
				Layout and chart idioms echo Together AI’s{' '}
				<a href="https://whichllm.together.ai/" target="_blank" rel="noopener noreferrer">Which LLM</a>
				{' '}cards,{' '}
				<a href="https://onyx.app/llm-leaderboard" target="_blank" rel="noopener noreferrer">Onyx’s LLM leaderboard</a>.
				Numbers below are <strong>illustrative placeholders</strong> for UI development; replace with your own dataset or API when wiring a real desk.{' '}
				<a href="#model-tester">GitHub-style model tester mock →</a>
				{' · '}
				<a href={`${baseUrl}models/liquid-ai/`}>Liquid AI live tuning →</a>
			</p>
		</header>

		<ModelsTesterCompare />

		<div
			id="models-leaderboard-root"
			class="models-leaderboard-mount"
			data-payload={modelsPayload}
			role="region"
			aria-label="Leaderboard charts and benchmark rows"
		>
			<ModelsLeaderboardECharts />

			<section class="models-benchmarks" id="benchmarks" aria-label="Benchmark style rows">
				<h2 class="models-benchmarks-title">Benchmark rows</h2>
				<p class="models-benchmarks-lede muted">
					Each block uses a split layout (copy + horizontal bar chart) similar to expandable benchmark sections on modern leaderboard sites.
				</p>
				<div class="models-benchmarks-stack">
					{
						benchmarkBlocks.map((block) => (
							<div class="models-bench-row">
								<div class="models-bench-copy">
									<h3>{block.title}</h3>
									<p class="muted">{block.lede}</p>
								</div>
								<div
									class="models-bench-chart"
									data-models-mini={encodeURIComponent(JSON.stringify(block.minis))}
									role="img"
									aria-label={`Bar chart for ${block.title}`}
								/>
							</div>
						))
					}
				</div>
			</section>
		</div>

		<section class="models-table-section card" aria-labelledby="models-desk-table-title">
			<div class="models-table-head">
				<div>
					<h2 id="models-desk-table-title">Serverless inference directory</h2>
					<p class="muted models-table-sub">
						Multi-sort table with major model brands, model size, last update, modality routing, and per-token price lanes.
					</p>
				</div>
				<div class="models-table-toggle" aria-label="Pricing mode">
					<span>Price per 1M tokens</span>
					<span>Batch API price</span>
					<button type="button" id="models-batch-toggle" aria-pressed="false"><span></span></button>
					<button type="button" id="models-offline-toggle" class="models-offline-toggle" aria-pressed="false">
						Free / offline
					</button>
				</div>
			</div>
			<div class="models-table-toolbar" aria-label="Model table controls">
				<div class="models-category-tabs" role="tablist" aria-label="Model category">
					{
						modelCategories.map((category) => (
							<button type="button" class:list={['models-category-tab', category.key === 'all' && 'is-active']} data-model-category={category.key}>
								{category.label}
							</button>
						))
					}
				</div>
				<label class="models-table-search">
					<span>Search providers</span>
					<input id="models-table-search" type="search" placeholder="OpenAI, Liquid, Qwen, rerank..." autocomplete="off" />
				</label>
			</div>
			<div class="models-table-wrap">
				<table class="models-table" id="models-directory-table">
					<thead>
						<tr>
							<th scope="col"><button type="button" data-sort="model">Model ↕</button></th>
							<th scope="col"><button type="button" data-sort="category">Route ↕</button></th>
							<th scope="col"><button type="button" data-sort="modelSize">Size ↕</button></th>
							<th scope="col"><button type="button" data-sort="lastUpdated">Updated ↕</button></th>
							<th scope="col"><button type="button" data-sort="inputPerM">Input ↕</button></th>
							<th scope="col"><button type="button" data-sort="outputPerM">Output ↕</button></th>
							<th scope="col"><button type="button" data-sort="agentFit">Agent fit ↕</button></th>
						</tr>
					</thead>
					<tbody>
						{
							llmDeskRows.map((r) => (
								<tr
									data-category={r.category}
									data-provider={r.provider}
									data-model={r.model}
									data-modelsize={r.modelSize}
									data-lastupdated={r.lastUpdated}
									data-inputperm={r.inputPerM}
									data-outputperm={r.outputPerM}
									data-agentfit={r.agentFit}
									data-offline={r.inputPerM === 0 && r.outputPerM === 0 ? '1' : '0'}
								>
									<th scope="row">
										{r.model}
										<span class="models-provider">{r.provider}</span>
									</th>
									<td>
										<span class="models-route-pill">{r.category}</span>
										<span class="models-modalities">{r.modalities.join(' · ')}</span>
									</td>
									<td>{r.modelSize}</td>
									<td>
										{r.lastUpdated}
										<span class="models-modalities">ctx {r.context}</span>
									</td>
									<td data-price="input" data-raw={r.inputPerM}>${r.inputPerM.toFixed(2)}</td>
									<td data-price="output" data-raw={r.outputPerM}>${r.outputPerM.toFixed(2)}</td>
									<td>
										<strong>{r.agentFit}</strong>
										<span class="models-modalities">JSON {r.jsonMode ? 'yes' : 'no'} · Tools {r.functionCalling ? 'yes' : 'no'}</span>
									</td>
								</tr>
							))
						}
					</tbody>
				</table>
			</div>
		</section>

		<p class="models-foot muted">
			External references:{' '}
			<a href="https://whichllm.together.ai/" target="_blank" rel="noopener noreferrer">whichllm.together.ai</a>
			{' · '}
			<a href="https://www.agentrecipes.com" target="_blank" rel="noopener noreferrer">agentrecipes.com</a>
			{' · '}
			<a href="https://www.anthropic.com/engineering/building-effective-agents" target="_blank" rel="noopener noreferrer">building effective agents</a>
			{' · '}
			<a href="https://onyx.app/llm-leaderboard" target="_blank" rel="noopener noreferrer">onyx.app/llm-leaderboard</a>
			{' · '}
			<a href={baseUrl}>← Directory home</a>
		</p>
	</section>
</Layout>

<style>
	.models-shell {
		display: flex;
		flex-direction: column;
		gap: 18px;
		padding-top: 4px;
		max-width: min(1100px, 100%);
		margin: 0 auto;
	}

	.models-hero {
		padding: 18px 20px;
	}

	.models-hero-eyebrow {
		margin: 0 0 8px;
		font-family: var(--font-mono);
		font-size: 0.72rem;
		font-weight: 600;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--accent);
	}

	.models-hero-title {
		margin: 0 0 10px;
		font-family: var(--font-serif);
		font-size: clamp(1.55rem, 3vw, 2.1rem);
		font-weight: 500;
		line-height: 1.15;
		max-width: 28ch;
	}

	.models-hero-lede {
		margin: 0;
		max-width: 58rem;
		line-height: 1.6;
		font-size: 0.98rem;
	}

	.models-hero-lede a {
		color: var(--accent);
		text-decoration: underline;
		text-underline-offset: 2px;
	}

	.models-table-section {
		padding: 16px 18px 18px;
	}

	.models-table-head h2 {
		margin: 0 0 6px;
		font-size: 1.15rem;
	}

	.models-table-head {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 16px;
		flex-wrap: wrap;
	}

	.models-table-sub {
		margin: 0 0 14px;
		font-size: 0.9rem;
		line-height: 1.5;
	}

	.models-table-toggle {
		display: flex;
		align-items: center;
		gap: 10px;
		color: var(--muted);
		font-size: 0.78rem;
	}

	.models-table-toggle #models-batch-toggle {
		width: 42px;
		height: 24px;
		padding: 2px;
		border-radius: 999px;
		border: 1px solid rgba(255, 255, 255, 0.14);
		background: rgba(255, 255, 255, 0.14);
		cursor: pointer;
	}

	.models-table-toggle #models-batch-toggle span {
		display: block;
		width: 18px;
		height: 18px;
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.86);
		transition: transform 0.15s ease;
	}

	.models-table-toggle #models-batch-toggle[aria-pressed='true'] span {
		transform: translateX(17px);
		background: var(--accent);
	}

	.models-offline-toggle {
		min-height: 26px;
		padding: 0 10px;
		border-radius: 999px;
		border: 1px solid rgba(72, 224, 188, 0.24);
		background: rgba(72, 224, 188, 0.08);
		color: rgba(210, 255, 242, 0.9);
		font-family: var(--font-mono);
		font-size: 0.68rem;
		text-transform: uppercase;
		cursor: pointer;
	}

	.models-offline-toggle[aria-pressed='true'] {
		background: rgba(72, 224, 188, 0.2);
		border-color: rgba(72, 224, 188, 0.46);
		color: var(--text);
	}

	.models-table-toolbar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
		margin: 4px 0 12px;
		flex-wrap: wrap;
	}

	.models-category-tabs {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
	}

	.models-category-tab {
		min-height: 34px;
		padding: 0 12px;
		border-radius: 10px;
		border: 1px solid rgba(255, 255, 255, 0.12);
		background: rgba(255, 255, 255, 0.06);
		color: rgba(230, 237, 243, 0.88);
		font-family: var(--font-mono);
		font-size: 0.68rem;
		text-transform: uppercase;
		cursor: pointer;
	}

	.models-category-tab.is-active,
	.models-category-tab:hover {
		background: rgba(72, 224, 188, 0.14);
		border-color: rgba(72, 224, 188, 0.35);
		color: var(--text);
	}

	.models-table-search {
		display: flex;
		align-items: center;
		gap: 8px;
		color: var(--muted);
		font-family: var(--font-mono);
		font-size: 0.68rem;
		text-transform: uppercase;
	}

	.models-table-search input {
		min-height: 34px;
		width: min(260px, 60vw);
		border-radius: 10px;
		border: 1px solid rgba(255, 255, 255, 0.12);
		background: rgba(0, 0, 0, 0.24);
		color: var(--text);
		padding: 8px 10px;
		text-transform: none;
	}

	.models-table-wrap {
		overflow-x: auto;
		border-radius: 14px;
		border: 1px solid rgba(255, 255, 255, 0.1);
	}

	.models-table {
		width: 100%;
		min-width: 640px;
		border-collapse: collapse;
		font-size: 0.88rem;
	}

	.models-table th,
	.models-table td {
		padding: 10px 12px;
		text-align: left;
		border-bottom: 1px solid rgba(255, 255, 255, 0.08);
		vertical-align: top;
	}

	.models-table thead th {
		font-family: var(--font-mono);
		font-size: 0.68rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--soft);
		background: rgba(7, 8, 18, 0.92);
	}

	.models-table thead button {
		border: 0;
		background: transparent;
		color: inherit;
		font: inherit;
		letter-spacing: inherit;
		text-transform: inherit;
		cursor: pointer;
	}

	.models-table tbody th {
		font-weight: 600;
		color: var(--text);
	}

	.models-provider {
		display: block;
		margin-top: 4px;
		font-size: 0.78rem;
		font-weight: 500;
		color: var(--muted);
	}

	.models-route-pill {
		display: inline-flex;
		padding: 4px 8px;
		border-radius: 999px;
		background: rgba(72, 224, 188, 0.1);
		border: 1px solid rgba(72, 224, 188, 0.2);
		color: rgba(210, 255, 242, 0.92);
		font-family: var(--font-mono);
		font-size: 0.68rem;
		text-transform: uppercase;
	}

	.models-modalities {
		display: block;
		margin-top: 4px;
		color: var(--muted);
		font-size: 0.72rem;
		line-height: 1.35;
	}

	.models-benchmarks-title {
		margin: 0 0 6px;
		font-size: 1.1rem;
	}

	.models-benchmarks-lede {
		margin: 0 0 14px;
		font-size: 0.9rem;
		max-width: 52rem;
		line-height: 1.55;
	}

	.models-benchmarks-stack {
		display: flex;
		flex-direction: column;
		border-radius: 16px;
		border: 1px solid rgba(255, 255, 255, 0.1);
		background: rgba(0, 0, 0, 0.18);
		overflow: hidden;
	}

	.models-bench-row {
		display: flex;
		flex-wrap: wrap;
		align-items: stretch;
		gap: 16px 20px;
		padding: 20px 18px;
		border-bottom: 1px solid rgba(255, 255, 255, 0.1);
	}

	.models-bench-row:last-child {
		border-bottom: none;
	}

	.models-bench-copy {
		flex: 1 1 240px;
		min-width: 0;
	}

	.models-bench-copy h3 {
		margin: 0 0 8px;
		font-size: 1.02rem;
		font-weight: 650;
	}

	.models-bench-copy p {
		margin: 0;
		line-height: 1.55;
		font-size: 0.9rem;
	}

	.models-bench-chart {
		flex: 1 1 260px;
		min-height: 140px;
		height: 160px;
		border-radius: 12px;
		border: 1px solid rgba(255, 255, 255, 0.08);
		background: rgba(0, 0, 0, 0.25);
		overflow: hidden;
	}

	.models-foot {
		font-size: 0.84rem;
		line-height: 1.5;
		margin: 0 0 28px;
	}

	.models-foot a {
		color: var(--accent);
	}

	.models-leaderboard-mount {
		display: flex;
		flex-direction: column;
		gap: 22px;
	}

	@media (max-width: 720px) {
		.models-bench-row {
			flex-direction: column;
		}

		.models-bench-chart {
			width: 100%;
		}
	}
</style>

<script>
	type SortEntry = { key: string; dir: 1 | -1 };

	(() => {
		const table = document.getElementById('models-directory-table');
		const tbody = table?.querySelector('tbody');
		if (!table || !tbody) return;
		const rows = Array.from(tbody.querySelectorAll('tr')) as HTMLTableRowElement[];
		const search = document.getElementById('models-table-search') as HTMLInputElement | null;
		const tabs = Array.from(
			document.querySelectorAll<HTMLElement>('[data-model-category]'),
		);
		const batchToggle = document.getElementById('models-batch-toggle');
		const offlineToggle = document.getElementById('models-offline-toggle');
		let activeCategory = 'all';
		let offlineOnly = false;
		const sortState: SortEntry[] = [];

		function valueFor(row: HTMLElement, key: string): number | string {
			const raw = row.dataset[key.toLowerCase()] ?? row.dataset[key] ?? '';
			const numeric = Number(raw);
			if (!Number.isNaN(numeric) && raw !== '') return numeric;
			return raw.toLowerCase();
		}

		function applyFilters() {
			const q = search?.value?.trim().toLowerCase() || '';
			for (const row of rows) {
				const categoryMatch = activeCategory === 'all' || row.dataset.category === activeCategory;
				const offlineMatch = !offlineOnly || row.dataset.offline === '1';
				const haystack = `${row.dataset.model || ''} ${row.dataset.provider || ''} ${row.textContent || ''}`.toLowerCase();
				row.hidden = !categoryMatch || !offlineMatch || (q !== '' && !haystack.includes(q));
			}
		}

		function sortRows(key: string) {
			const existing = sortState.find((s) => s.key === key);
			if (existing) existing.dir = (existing.dir * -1) as 1 | -1;
			else sortState.unshift({ key, dir: key === 'model' || key === 'category' ? 1 : -1 });
			sortState.splice(3);
			const sorted = [...rows].sort((a, b) => {
				for (const s of sortState) {
					const av = valueFor(a, s.key);
					const bv = valueFor(b, s.key);
					if (av < bv) return -1 * s.dir;
					if (av > bv) return 1 * s.dir;
				}
				return 0;
			});
			for (const row of sorted) tbody!.appendChild(row);
			applyFilters();
		}

		table.querySelectorAll<HTMLElement>('[data-sort]').forEach((button) => {
			button.addEventListener('click', () => sortRows(button.dataset.sort || 'model'));
		});
		tabs.forEach((tab) => {
			tab.addEventListener('click', () => {
				activeCategory = tab.dataset.modelCategory || 'all';
				tabs.forEach((t) => t.classList.toggle('is-active', t === tab));
				applyFilters();
			});
		});
		search?.addEventListener('input', applyFilters);
		offlineToggle?.addEventListener('click', () => {
			offlineOnly = !offlineOnly;
			offlineToggle.setAttribute('aria-pressed', offlineOnly ? 'true' : 'false');
			applyFilters();
		});
		batchToggle?.addEventListener('click', () => {
			const pressed = batchToggle.getAttribute('aria-pressed') === 'true';
			batchToggle.setAttribute('aria-pressed', pressed ? 'false' : 'true');
			table.querySelectorAll('[data-price]').forEach((cell) => {
				const raw = Number(cell.getAttribute('data-raw') || 0);
				const next = pressed ? raw : raw * 0.5;
				cell.textContent = `$${next.toFixed(2)}`;
			});
		});
	})();

	(async () => {
		const root = document.getElementById('models-leaderboard-root');
		if (!root) return;
		try {
			const { mountModelsLeaderboard } = await import('../../lib/models-leaderboard-echarts');
			mountModelsLeaderboard(root);
		} catch {
			/* ignore */
		}
	})();
</script>
