---
import Layout from '../../layouts/Layout.astro';
import '../../styles/explorer-catalog.css';
import healthManifest from '../../../public/data/health/manifest.json';

const coverageMeta = {
	shardCount: healthManifest.shardCount,
	tickerCount: healthManifest.tickerCount,
	patchCount: healthManifest.patchCount,
	generatedAt: healthManifest.generatedAt,
	axes: healthManifest.axes,
};
---

<Layout
	title="Directory explorer"
	description="Search and filter the Erika listing catalog in the browser against static JSON."
	pageClass="page-directory"
	eyebrow="Directory explorer"
	subtitle="Search, slice, and open individual listing profiles from the static catalog."
	showHeaderDirectorySearch={true}
>
	<section class="container directory-page-shell">
		<section class="section-card card explorer-section" id="explore">
			<div class="section-heading">
				<div>
					<div class="kicker">Directory explorer</div>
					<h2>Search, slice, and open individual listing profiles</h2>
					<p>
						Runs entirely from static JSON on GitHub Pages. Use the header search to jump queries
						from any tab; filters below stay in sync with the URL.
					</p>
				</div>
			</div>

			<div class="filters-grid">
				<label class="field field-search">
					<span>Search</span>
					<input
						id="filter-query"
						type="search"
						placeholder="Ticker, company, exchange, country, alias..."
						autocomplete="off"
					/>
				</label>

				<label class="field">
					<span>Security type</span>
					<select id="filter-type">
						<option value="">All types</option>
					</select>
				</label>

				<label class="field">
					<span>Date coverage</span>
					<select id="filter-coverage">
						<option value="">Any coverage</option>
						<option value="complete">Complete</option>
						<option value="partial">Partial</option>
						<option value="missing">Missing</option>
					</select>
				</label>

				<label class="field">
					<span>Country</span>
					<input id="filter-country" list="country-options" placeholder="All countries" />
					<datalist id="country-options"></datalist>
				</label>

				<label class="field">
					<span>Exchange</span>
					<input id="filter-exchange" list="exchange-options" placeholder="All exchanges" />
					<datalist id="exchange-options"></datalist>
				</label>

				<label class="field">
					<span>Sector</span>
					<input id="filter-sector" list="sector-options" placeholder="All sectors" />
					<datalist id="sector-options"></datalist>
				</label>
				<label class="field">
					<span>IPO/founding completeness</span>
					<select id="filter-ipo-coverage">
						<option value="">Any IPO/founding</option>
						<option value="complete">Complete</option>
						<option value="partial">Partial</option>
						<option value="missing">Missing</option>
					</select>
				</label>
				<label class="field">
					<span>LLC filing completeness</span>
					<select id="filter-filing-coverage">
						<option value="">Any filing coverage</option>
						<option value="complete">Complete</option>
						<option value="partial">Partial</option>
						<option value="missing">Missing</option>
					</select>
				</label>
				<label class="field">
					<span>Sort</span>
					<select id="filter-sort">
						<option value="ticker">Ticker (A-Z)</option>
						<option value="completeness-desc">Completeness (best first)</option>
						<option value="completeness-asc">Completeness (least first)</option>
						<option value="ipo-recent">IPO date (newest first)</option>
					</select>
				</label>
			</div>

			<div class="results-toolbar">
				<div id="results-meta" class="metaHint">Loading catalog…</div>
				<button id="clear-filters" class="button-secondary" type="button">Reset filters</button>
			</div>

			<p class="metaHint coverage-strip" id="coverage-strip">
				Snowflake coverage: <strong>{coverageMeta.shardCount}</strong> shards ·
				<strong>{coverageMeta.tickerCount.toLocaleString()}</strong> profiles ·
				<strong>{coverageMeta.patchCount}</strong> overlay {coverageMeta.patchCount === 1 ? 'patch' : 'patches'}
				· generated {coverageMeta.generatedAt}
			</p>

			<div id="results-grid" class="results-grid"></div>

			<div class="pagination-row">
				<button id="prev-page" class="button-secondary" type="button">Previous</button>
				<div id="page-meta" class="metaHint">Page 1</div>
				<button id="next-page" class="button-secondary" type="button">Next</button>
			</div>
		</section>
	</section>

	<script is:inline define:vars={{ baseUrl: import.meta.env.BASE_URL, coverageAxes: coverageMeta.axes }}>
		const pageSize = 24;
		const filterElements = {
			query: document.querySelector('#filter-query'),
			type: document.querySelector('#filter-type'),
			coverage: document.querySelector('#filter-coverage'),
			country: document.querySelector('#filter-country'),
			exchange: document.querySelector('#filter-exchange'),
			sector: document.querySelector('#filter-sector'),
			ipoCoverage: document.querySelector('#filter-ipo-coverage'),
			filingCoverage: document.querySelector('#filter-filing-coverage'),
			sort: document.querySelector('#filter-sort'),
		};
		const headerFilterQuery = document.querySelector('#header-filter-query');
		const resultsMeta = document.querySelector('#results-meta');
		const resultsGrid = document.querySelector('#results-grid');
		const pageMeta = document.querySelector('#page-meta');
		const previousButton = document.querySelector('#prev-page');
		const nextButton = document.querySelector('#next-page');
		const clearFiltersButton = document.querySelector('#clear-filters');
		const countryOptions = document.querySelector('#country-options');
		const exchangeOptions = document.querySelector('#exchange-options');
		const sectorOptions = document.querySelector('#sector-options');
		const state = {
			query: '',
			type: '',
			coverage: '',
			country: '',
			exchange: '',
			sector: '',
			ipoCoverage: '',
			filingCoverage: '',
			sort: 'ticker',
			page: 1,
		};
		let catalog = [];
		let filteredCatalog = [];

		const countFormatter = new Intl.NumberFormat();
		const dateFormatter = new Intl.DateTimeFormat(undefined, { dateStyle: 'medium' });

		function escapeHtml(value) {
			return String(value || '').replace(/[&<>'"]/g, (character) => {
				return (
					{
						'&': '&amp;',
						'<': '&lt;',
						'>': '&gt;',
						"'": '&#39;',
						'"': '&quot;',
					}[character] || character
				);
			});
		}

		function formatDate(value) {
			if (!value) return 'Unavailable';
			const date = new Date(value);
			return Number.isNaN(date.getTime()) ? value : dateFormatter.format(date);
		}

		function coverageBadge(coverage) {
			if (coverage === 'complete') return 'success';
			if (coverage === 'partial') return 'warning';
			return 'muted';
		}

		function normalize(value) {
			return String(value || '').trim().toLowerCase();
		}

		function completenessScore(value) {
			if (value === 'complete') return 2;
			if (value === 'partial') return 1;
			return 0;
		}

		function timestampValue(value) {
			if (!value) return 0;
			const epoch = Date.parse(value);
			return Number.isNaN(epoch) ? 0 : epoch;
		}

		const US_EXCHANGES = new Set(['NYSE', 'NASDAQ', 'OTC', 'NYSEARCA', 'BATS', 'NYSEAMERICAN', 'AMEX']);

		function isUsListing(entry) {
			return entry.co === 'United States' || US_EXCHANGES.has(entry.ex);
		}

		function edgarTickerUrl(ticker) {
			return `https://www.sec.gov/cgi-bin/browse-edgar?action=getcompany&CIK=${encodeURIComponent(ticker)}&type=&dateb=&owner=include&count=10`;
		}

		function edgarCompanyUrl(name) {
			return `https://www.sec.gov/cgi-bin/browse-edgar?company=${encodeURIComponent(name)}&CIK=&type=&dateb=&owner=include&count=40&action=getcompany`;
		}

		function applyUrlState() {
			const params = new URLSearchParams(window.location.search);
			state.query = params.get('q') || '';
			state.type = params.get('type') || '';
			state.coverage = params.get('coverage') || '';
			state.country = params.get('country') || '';
			state.exchange = params.get('exchange') || '';
			state.sector = params.get('sector') || '';
			state.ipoCoverage = params.get('ipo') || '';
			state.filingCoverage = params.get('filing') || '';
			state.sort = params.get('sort') || 'ticker';
			state.page = Math.max(Number(params.get('page') || '1'), 1);

			filterElements.query.value = state.query;
			if (headerFilterQuery) headerFilterQuery.value = state.query;
			filterElements.type.value = state.type;
			filterElements.coverage.value = state.coverage;
			filterElements.country.value = state.country;
			filterElements.exchange.value = state.exchange;
			filterElements.sector.value = state.sector;
			filterElements.ipoCoverage.value = state.ipoCoverage;
			filterElements.filingCoverage.value = state.filingCoverage;
			filterElements.sort.value = state.sort;
		}

		function syncUrl() {
			const params = new URLSearchParams();
			if (state.query) params.set('q', state.query);
			if (state.type) params.set('type', state.type);
			if (state.coverage) params.set('coverage', state.coverage);
			if (state.country) params.set('country', state.country);
			if (state.exchange) params.set('exchange', state.exchange);
			if (state.sector) params.set('sector', state.sector);
			if (state.ipoCoverage) params.set('ipo', state.ipoCoverage);
			if (state.filingCoverage) params.set('filing', state.filingCoverage);
			if (state.sort && state.sort !== 'ticker') params.set('sort', state.sort);
			if (state.page > 1) params.set('page', String(state.page));
			const queryString = params.toString();
			const nextUrl = `${window.location.pathname}${queryString ? `?${queryString}` : ''}`;
			window.history.replaceState({}, '', nextUrl);
		}

		function createOptionMarkup(values) {
			return values.map((value) => `<option value="${escapeHtml(value)}"></option>`).join('');
		}

		function populateFilterControls(records) {
			const securityTypes = [...new Set(records.map((entry) => entry.ty).filter(Boolean))].sort();
			const countries = [...new Set(records.map((entry) => entry.co).filter(Boolean))].sort();
			const exchanges = [...new Set(records.map((entry) => entry.ex).filter(Boolean))].sort();
			const sectors = [...new Set(records.map((entry) => entry.se).filter(Boolean))].sort();

			filterElements.type.innerHTML = `<option value="">All types</option>${securityTypes
				.map((value) => `<option value="${escapeHtml(value)}">${escapeHtml(value)}</option>`)
				.join('')}`;
			countryOptions.innerHTML = createOptionMarkup(countries);
			exchangeOptions.innerHTML = createOptionMarkup(exchanges);
			sectorOptions.innerHTML = createOptionMarkup(sectors);
		}

		function filterCatalog() {
			const query = normalize(state.query);
			const type = normalize(state.type);
			const coverage = normalize(state.coverage);
			const country = normalize(state.country);
			const exchange = normalize(state.exchange);
			const sector = normalize(state.sector);
			const ipoCoverage = normalize(state.ipoCoverage);
			const filingCoverage = normalize(state.filingCoverage);

			filteredCatalog = catalog.filter((entry) => {
				if (query && !entry._search.includes(query)) return false;
				if (type && normalize(entry.ty) !== type) return false;
				if (coverage && normalize(entry.dc) !== coverage) return false;
				if (country && normalize(entry.co) !== country) return false;
				if (exchange && normalize(entry.ex) !== exchange) return false;
				if (sector && normalize(entry.se) !== sector) return false;
				if (ipoCoverage && normalize(entry.ic) !== ipoCoverage) return false;
				if (filingCoverage && normalize(entry.fc) !== filingCoverage) return false;
				return true;
			});

			filteredCatalog.sort((left, right) => {
				if (state.sort === 'completeness-desc' || state.sort === 'completeness-asc') {
					const leftScore =
						completenessScore(left.ic) * 10 +
						completenessScore(left.fc) * 5 +
						completenessScore(left.dc);
					const rightScore =
						completenessScore(right.ic) * 10 +
						completenessScore(right.fc) * 5 +
						completenessScore(right.dc);
					if (leftScore !== rightScore) {
						return state.sort === 'completeness-desc' ? rightScore - leftScore : leftScore - rightScore;
					}
				}

				if (state.sort === 'ipo-recent') {
					const leftIpo = timestampValue(left.ip);
					const rightIpo = timestampValue(right.ip);
					if (leftIpo !== rightIpo) return rightIpo - leftIpo;
				}

				return String(left.id).localeCompare(String(right.id));
			});

			const maxPage = Math.max(Math.ceil(filteredCatalog.length / pageSize), 1);
			state.page = Math.min(state.page, maxPage);
		}

		const miniChartHandles = [];

		function clearMiniChartHandles() {
			while (miniChartHandles.length) {
				const h = miniChartHandles.pop();
				try {
					if (h && typeof h.dispose === 'function') h.dispose();
				} catch {}
			}
		}

		function renderResults() {
			filterCatalog();
			const total = filteredCatalog.length;
			const firstItem = total === 0 ? 0 : (state.page - 1) * pageSize + 1;
			const lastItem = Math.min(state.page * pageSize, total);
			const pageItems = filteredCatalog.slice(firstItem - 1, lastItem);

			resultsMeta.textContent =
				total === 0
					? 'No listings match these filters.'
					: `Showing ${countFormatter.format(firstItem)}-${countFormatter.format(lastItem)} of ${countFormatter.format(total)} listings`;

			pageMeta.textContent = `Page ${state.page} of ${Math.max(Math.ceil(total / pageSize), 1)}`;
			previousButton.disabled = state.page <= 1;
			nextButton.disabled = state.page >= Math.max(Math.ceil(total / pageSize), 1);

			clearMiniChartHandles();

			if (pageItems.length === 0) {
				resultsGrid.innerHTML = `
					<div class="result-empty card">
						<h3>No matches</h3>
						<p>Try a broader search, clear one of the filters, or adjust the query in the header.</p>
					</div>
				`;
				return;
			}

				resultsGrid.innerHTML = pageItems
				.map((entry) => {
					const tags = [
						entry.ty,
						entry.ex,
						entry.co,
						entry.se || entry.ec,
						entry.dc,
						`IPO ${entry.ic || 'missing'}`,
						`Filing ${entry.fc || 'missing'}`,
					].filter(Boolean);
					const ticker = entry.sy || entry.id.split(':').pop();
					const name = entry.ln || entry.nm;
					const edgarHtml = isUsListing(entry)
						? `<div class="result-card-edgar">
								<span class="result-card-edgar-label muted">SEC EDGAR</span>
								<a class="button-secondary result-edgar-link" href="${escapeHtml(edgarTickerUrl(ticker))}" target="_blank" rel="noopener noreferrer">${escapeHtml(ticker)} filings</a>
								<a class="button-secondary result-edgar-link" href="${escapeHtml(edgarCompanyUrl(name))}" target="_blank" rel="noopener noreferrer">Company search</a>
							</div>`
						: '';
					return `
						<article class="result-card card" data-ticker="${escapeHtml(entry.id)}">
							<div class="result-card-head">
								<div>
									<h3>${escapeHtml(entry.nm)}</h3>
									<p>${escapeHtml(entry.id)}</p>
								</div>
								<span class="badge ${coverageBadge(entry.dc)}">${escapeHtml(entry.dc || 'missing')}</span>
							</div>
							<div class="result-card-tags">
								${tags
									.map((tag) => `<span class="badge muted">${escapeHtml(tag)}</span>`)
									.join('')}
							</div>
							<p class="result-card-body">
								${escapeHtml(entry.ln || 'Primary legal name unavailable')}
							</p>
							<dl class="result-card-snowflake" data-snowflake="pending" aria-label="Snowflake coverage">
								<dt>Snowflake</dt>
								<dd class="snowflake-axes muted">Loading coverage…</dd>
							</dl>
							<div class="result-card-chart-block" aria-label="Erika daily price history">
								<div class="result-card-chart-label mono small muted">Current interval · our OHLCV</div>
								<div
									class="result-card-chart"
									data-chart-host="1"
									data-chart-ticker="${escapeHtml(entry.id)}"
									role="img"
									aria-label="Price history chart for ${escapeHtml(entry.id)}"
								></div>
								<p class="result-card-chart-status muted micro" data-chart-status>Loading chart…</p>
							</div>
							${edgarHtml}
							<div class="result-card-footer">
								<span class="muted">Company: ${escapeHtml(formatDate(entry.cd))}</span>
								<span class="muted">IPO: ${escapeHtml(formatDate(entry.ip))}</span>
								<span class="muted">Filing: ${escapeHtml(formatDate(entry.lt))}</span>
								<span class="muted">Location: ${escapeHtml(entry.ll || 'Unavailable')}</span>
							</div>
							<a class="button result-link" href="${baseUrl}listing/?id=${encodeURIComponent(entry.id)}">
								Open profile
							</a>
						</article>
					`;
				})
				.join('');

			const pageTickers = pageItems.map((entry) => entry.id);
			void hydrateSnowflakeBadges(pageTickers);
			void hydrateMiniCharts(pageTickers);
		}

		const snowflakeCache = new Map();
		const axisLabels = { value: 'V', future: 'F', past: 'Pa', health: 'H', dividends: 'D' };
		const chartNumFmt = new Intl.NumberFormat();

		function skeletonSummaryFromManifest(ticker, axes) {
			if (!axes || !axes.length) return null;
			let totalChecks = 0;
			const axisRows = axes.map((a) => {
				const n = typeof a.checkCount === 'number' ? a.checkCount : 0;
				totalChecks += n;
				return { name: a.name, passed: 0, total: n, na: n };
			});
			return { ticker, totalChecks, naChecks: totalChecks, axes: axisRows };
		}

		function whenCoverageHelpersReady(timeoutMs = 8000) {
			return new Promise((resolve) => {
				if (window.__qbitosHealthLoader__) return resolve(window.__qbitosHealthLoader__);
				const start = Date.now();
				const handler = () => resolve(window.__qbitosHealthLoader__ ?? null);
				const tick = () => {
					if (window.__qbitosHealthLoader__) return resolve(window.__qbitosHealthLoader__);
					if (Date.now() - start > timeoutMs) return resolve(null);
					setTimeout(tick, 80);
				};
				window.addEventListener('qbitos:health-loader-ready', handler, { once: true });
				tick();
			});
		}

		async function hydrateSnowflakeBadges(tickers) {
			const helpers = await whenCoverageHelpersReady();
			const hasGet = helpers && typeof helpers.getCoverageSummaryForTicker === 'function';

			const rows = await Promise.all(
				tickers.map(async (ticker) => {
					let summary = null;
					if (hasGet) {
						if (snowflakeCache.has(ticker)) {
							summary = snowflakeCache.get(ticker);
						} else {
							try {
								summary = await helpers.getCoverageSummaryForTicker(ticker);
								if (summary) snowflakeCache.set(ticker, summary);
							} catch {
								summary = null;
							}
						}
					}
					return { ticker, summary };
				}),
			);

			rows.forEach(({ ticker, summary }) => {
				const card = resultsGrid.querySelector(`.result-card[data-ticker="${cssEscape(ticker)}"]`);
				if (!card) return;
				const wrap = card.querySelector('[data-snowflake]');
				const target = card.querySelector('.snowflake-axes');
				if (!wrap || !target) return;

				const skeleton = skeletonSummaryFromManifest(ticker, coverageAxes);
				if (!summary && !skeleton) {
					wrap.dataset.snowflake = 'unavailable';
					target.textContent = 'Coverage manifest unavailable.';
					return;
				}

				const display = summary || skeleton;
				const isSkeleton = !summary;
				wrap.dataset.snowflake = isSkeleton ? 'skeleton' : 'ready';

				if (display.totalChecks === 0) {
					target.textContent = 'No checks defined.';
					return;
				}

				const filled = display.totalChecks - display.naChecks;
				let filledLabel;
				if (isSkeleton) {
					filledLabel = `Not in shard index yet · ${display.totalChecks} checks when patched`;
				} else if (filled === 0) {
					filledLabel = 'awaiting research overlay';
				} else {
					filledLabel = `${filled}/${display.totalChecks} checks scored`;
				}

				target.innerHTML = `
					<span class="snowflake-axes-row">
						${display.axes
							.map(
								(axis) =>
									`<span class="axis-pip ${axis.passed > 0 ? 'on' : 'na'}" title="${axis.name} ${axis.passed}/${axis.total}">${axisLabels[axis.name] || String(axis.name)[0].toUpperCase()}<small>${axis.passed}/${axis.total}</small></span>`,
							)
							.join('')}
					</span>
					<span class="snowflake-meta muted">${filledLabel}</span>
				`;
			});
		}

		function whenHistoryHelpersReady(timeoutMs = 8000) {
			return new Promise((resolve) => {
				if (window.__qbitosHistoryLoader__) return resolve(window.__qbitosHistoryLoader__);
				const start = Date.now();
				const handler = () => resolve(window.__qbitosHistoryLoader__ ?? null);
				const tick = () => {
					if (window.__qbitosHistoryLoader__) return resolve(window.__qbitosHistoryLoader__);
					if (Date.now() - start > timeoutMs) return resolve(null);
					setTimeout(tick, 80);
				};
				window.addEventListener('qbitos:history-loader-ready', handler, { once: true });
				tick();
			});
		}

		async function mountSparkline(host, series) {
			const spark = window.__qbitosSparkline__;
			if (!spark || typeof spark.mountHistorySparkline !== 'function') {
				return await new Promise((resolve) => {
					const handler = () => {
						const ready = window.__qbitosSparkline__;
						if (ready && ready.mountHistorySparkline) resolve(ready.mountHistorySparkline(host, series));
					};
					window.addEventListener('qbitos:sparkline-ready', handler, { once: true });
					setTimeout(() => {
						const late = window.__qbitosSparkline__;
						if (late && late.mountHistorySparkline) resolve(late.mountHistorySparkline(host, series));
						else resolve({ dispose() {} });
					}, 4000);
				});
			}
			return spark.mountHistorySparkline(host, series);
		}

		async function hydrateMiniCharts(tickers) {
			const helpers = await whenHistoryHelpersReady();
			for (let i = 0; i < tickers.length; i += 1) {
				const ticker = tickers[i];
				const card = resultsGrid.querySelector(`.result-card[data-ticker="${cssEscape(ticker)}"]`);
				const host = card && card.querySelector('[data-chart-host]');
				const statusEl = card && card.querySelector('[data-chart-status]');
				if (!host || !statusEl) continue;

				if (!helpers || typeof helpers.getHistoryForTicker !== 'function') {
					statusEl.textContent = 'History loader unavailable.';
					continue;
				}

				try {
					statusEl.textContent = 'Loading chart…';
					const series = await helpers.getHistoryForTicker(ticker);
					if (!series) {
						statusEl.textContent = 'No history shim yet — same store as listing profile.';
						continue;
					}
					statusEl.textContent = `${chartNumFmt.format(series.rows)} daily bars · ${series.source || 'erika'}`;
					const handle = await mountSparkline(host, series);
					miniChartHandles.push(handle);
				} catch (err) {
					statusEl.textContent =
						err && err.message ? `Chart error: ${err.message}` : 'Chart failed to load.';
				}
			}
		}

		function cssEscape(value) {
			if (window.CSS && typeof window.CSS.escape === 'function') return window.CSS.escape(value);
			return String(value).replace(/[^a-zA-Z0-9_-]/g, (ch) => `\\${ch}`);
		}

		function handleFilterChange() {
			state.query = filterElements.query.value.trim();
			state.type = filterElements.type.value.trim();
			state.coverage = filterElements.coverage.value.trim();
			state.country = filterElements.country.value.trim();
			state.exchange = filterElements.exchange.value.trim();
			state.sector = filterElements.sector.value.trim();
			state.ipoCoverage = filterElements.ipoCoverage.value.trim();
			state.filingCoverage = filterElements.filingCoverage.value.trim();
			state.sort = filterElements.sort.value.trim() || 'ticker';
			state.page = 1;
			syncUrl();
			renderResults();
		}

		async function loadCatalog() {
			const response = await fetch(`${baseUrl}data/catalog.json`);
			if (!response.ok) {
				throw new Error(`Failed to load catalog: ${response.status}`);
			}

			const records = await response.json();
			return records.map((entry) => ({
				...entry,
				_search: [
					entry.id,
					entry.sy,
					entry.ex,
					entry.nm,
					entry.ln,
					entry.ty,
					entry.se,
					entry.ec,
					entry.co,
					entry.ll,
					entry.lt,
					...(entry.al || []),
				]
					.filter(Boolean)
					.join(' ')
					.toLowerCase(),
			}));
		}

		previousButton.addEventListener('click', () => {
			state.page = Math.max(1, state.page - 1);
			syncUrl();
			renderResults();
		});

		nextButton.addEventListener('click', () => {
			state.page += 1;
			syncUrl();
			renderResults();
		});

		clearFiltersButton.addEventListener('click', () => {
			Object.assign(state, {
				query: '',
				type: '',
				coverage: '',
				country: '',
				exchange: '',
				sector: '',
				ipoCoverage: '',
				filingCoverage: '',
				sort: 'ticker',
				page: 1,
			});
			filterElements.query.value = '';
			filterElements.type.value = '';
			filterElements.coverage.value = '';
			filterElements.country.value = '';
			filterElements.exchange.value = '';
			filterElements.sector.value = '';
			filterElements.ipoCoverage.value = '';
			filterElements.filingCoverage.value = '';
			filterElements.sort.value = 'ticker';
			if (headerFilterQuery) headerFilterQuery.value = '';
			syncUrl();
			renderResults();
		});

		for (const [key, element] of Object.entries(filterElements)) {
			if (key === 'query') continue;
			element.addEventListener('input', handleFilterChange);
			element.addEventListener('change', handleFilterChange);
		}

		function syncHeaderQueryFromMain() {
			if (headerFilterQuery) headerFilterQuery.value = filterElements.query.value;
		}

		filterElements.query.addEventListener('input', () => {
			syncHeaderQueryFromMain();
			handleFilterChange();
		});
		filterElements.query.addEventListener('change', () => {
			syncHeaderQueryFromMain();
			handleFilterChange();
		});

		if (headerFilterQuery) {
			headerFilterQuery.addEventListener('input', () => {
				filterElements.query.value = headerFilterQuery.value;
				handleFilterChange();
			});
			headerFilterQuery.addEventListener('change', () => {
				filterElements.query.value = headerFilterQuery.value;
				handleFilterChange();
			});
		}

		(async () => {
			try {
				catalog = await loadCatalog();
				populateFilterControls(catalog);
				applyUrlState();
				renderResults();
			} catch (error) {
				resultsMeta.textContent = 'Catalog failed to load.';
				resultsGrid.innerHTML = `
					<div class="result-empty card">
						<h3>Unable to load the directory</h3>
						<p>${escapeHtml(error.message)}</p>
					</div>
				`;
			}
		})();
	</script>

	<script>
		import {
			getCoverageForTicker,
			getCoverageSummaryForTicker,
			loadHealthManifest,
			prefetchShardForTicker,
			summarizeProfile,
		} from '../../lib/health-shard-loader.ts';
		import {
			getHistoryForTicker,
			hasHistoryForTicker,
			loadHistoryManifest,
			summarizeHistoryWindow,
			dayKeyToISO,
		} from '../../lib/history-shard-loader.ts';
		import { mountHistorySparkline } from '../../lib/history-sparkline.ts';

		window.__qbitosHealthLoader__ = {
			getCoverageForTicker,
			getCoverageSummaryForTicker,
			loadHealthManifest,
			prefetchShardForTicker,
			summarizeProfile,
		};
		window.__qbitosHistoryLoader__ = {
			getHistoryForTicker,
			hasHistoryForTicker,
			loadHistoryManifest,
			summarizeHistoryWindow,
			dayKeyToISO,
		};
		window.__qbitosSparkline__ = { mountHistorySparkline };
		window.dispatchEvent(new CustomEvent('qbitos:health-loader-ready'));
		window.dispatchEvent(new CustomEvent('qbitos:history-loader-ready'));
		window.dispatchEvent(new CustomEvent('qbitos:sparkline-ready'));
	</script>
</Layout>

