		const US_EXCHANGES = new Set(['NYSE', 'NASDAQ', 'OTC', 'NYSEARCA', 'BATS', 'NYSEAMERICAN', 'AMEX']);

		function isUsListing(record) {
			return record.co === 'United States' || US_EXCHANGES.has(record.ex);
		}

		function edgarTickerUrl(ticker) {
			return `https://www.sec.gov/cgi-bin/browse-edgar?action=getcompany&CIK=${encodeURIComponent(ticker)}&type=&dateb=&owner=include&count=10`;
		}

		function edgarCompanyUrl(name) {
			return `https://www.sec.gov/cgi-bin/browse-edgar?company=${encodeURIComponent(name)}&CIK=&type=&dateb=&owner=include&count=40&action=getcompany`;
		}

		function edgarFullTextUrl(query) {
			return `https://efts.sec.gov/LATEST/search-index?q=${encodeURIComponent(`"${query}"`)}&forms=10-K,10-Q,8-K`;
		}

		function legalEntityLabel(record) {
			const legal = String(record.ln || '').trim();
			const trade = String(record.nm || '').trim();
			return legal || trade || String(record.id || record.sy || 'Listing');
		}

		function openRegistryCompanyUrl(record) {
			const registry = record.registry;
			if (!registry || registry.source !== 'openregistry') return null;
			const jurisdiction = String(registry.jurisdiction || '').trim().toLowerCase();
			const companyId = String(registry.companyId || '').trim();
			if (!jurisdiction || !companyId) return null;
			return `https://openregistry.sophymarine.com/company/${jurisdiction}/${companyId}`;
		}

		function secEdgarCompanyUrl(record) {
			const registry = record.registry;
			if (!registry || registry.source !== 'sec_edgar') return null;
			const cik = String(registry.companyId || '').trim().replace(/^0+/, '');
			if (!cik) return null;
			return `https://www.sec.gov/cgi-bin/browse-edgar?action=getcompany&CIK=${encodeURIComponent(cik)}`;
		}

		function renderEdgarPanel(record) {
			if (!edgarPanel || !edgarLinks) return;
			const links = [];
			const orUrl = openRegistryCompanyUrl(record);
			if (orUrl) {
				links.push(
					`<a class="button-secondary edgar-link" href="${escapeHtml(orUrl)}" target="_blank" rel="noopener noreferrer">OpenRegistry profile</a>`,
				);
			}
			const secUrl = secEdgarCompanyUrl(record);
			if (secUrl) {
				links.push(
					`<a class="button-secondary edgar-link" href="${escapeHtml(secUrl)}" target="_blank" rel="noopener noreferrer">SEC EDGAR company (CIK)</a>`,
				);
			}
			if (isUsListing(record)) {
				const ticker = record.sy || record.id.split(':').pop();
				const name = legalEntityLabel(record);
				links.push(
					`<a class="button-secondary edgar-link" href="${escapeHtml(edgarTickerUrl(ticker))}" target="_blank" rel="noopener noreferrer">EDGAR: ${escapeHtml(ticker)} filings</a>`,
					`<a class="button-secondary edgar-link" href="${escapeHtml(edgarCompanyUrl(name))}" target="_blank" rel="noopener noreferrer">EDGAR: company search</a>`,
					`<a class="button-secondary edgar-link" href="${escapeHtml(edgarFullTextUrl(ticker))}" target="_blank" rel="noopener noreferrer">EDGAR: full-text search</a>`,
				);
			}
			if (links.length === 0) {
				edgarPanel.hidden = true;
				return;
			}
			edgarLinks.innerHTML = links.join('');
			edgarPanel.hidden = false;
		}

		async function loadCatalog() {
			const response = await fetch(`${baseUrl}data/catalog.json`);
			if (!response.ok) {
				throw new Error(`Failed to load catalog: ${response.status}`);
			}

			return response.json();
		}

		const snowflakeCard = document.querySelector('[data-snowflake-card]');
		const snowflakeSummary = document.querySelector('#snowflake-summary');
		const snowflakeAxes = document.querySelector('#snowflake-axes');
		const snowflakeAsOf = document.querySelector('#snowflake-asof');

		function whenCoverageHelpersReady() {
			return Promise.resolve(window.__qbitosHealthLoader__ ?? null);
		}

		function checkBadge(state) {
			if (state === 'pass') return 'success';
			if (state === 'fail') return 'warning';
			return 'muted';
		}

		const historyCard = document.querySelector('[data-history-card]');
		const historyChart = document.querySelector('#history-chart');
		const historyAsOf = document.querySelector('#history-asof');
		const historySubtitle = document.querySelector('#history-subtitle');
		const historyStatus = document.querySelector('#history-status');
		const historyTotal = document.querySelector('#history-total-return');
		const historyAnnualized = document.querySelector('#history-annualized');
		const historyDrawdown = document.querySelector('#history-drawdown');
		const historyVolume = document.querySelector('#history-volume');
		const historyCalendarChart = document.querySelector('#history-calendar-chart');
		const historyFlowMonth = document.querySelector('#history-flow-month');
		const historyFlowWeek = document.querySelector('#history-flow-week');
		const historyFlowDay = document.querySelector('#history-flow-day');
		const historyFlowMonthData = document.querySelector('#history-flow-month-data');
		const historyFlowWeekData = document.querySelector('#history-flow-week-data');
		const historyFlowDayData = document.querySelector('#history-flow-day-data');
		const historySnowflakeHistory = document.querySelector('#history-snowflake-history');
		const snowflakeAxisMinis = document.querySelector('#snowflake-axis-minis');
		let historyChartHandle = null;
		let historyCalendarHandle = null;
		let historyFlowHandle = null;
		let historySnowflakeHistoryHandle = null;
		let snowflakeRadarHandle = null;
		let snowflakeAxisGridHandle = null;

		function whenHistoryHelpersReady() {
			return Promise.resolve(window.__qbitosHistoryLoader__ ?? null);
		}

		function spanYears(rangeStart, rangeEnd) {
			const startYear = Math.floor(rangeStart / 10000);
			const startRest = rangeStart - startYear * 10000;
			const endYear = Math.floor(rangeEnd / 10000);
			const endRest = rangeEnd - endYear * 10000;
			return endYear - startYear + (endRest - startRest) / 10000;
		}

		async function renderHistorySparkline(ticker, _displayName) {
			if (!historyCard || !historyChart || !historyStatus) return;
			const helpers = await whenHistoryHelpersReady();
			if (!helpers) return;

			historyCard.hidden = false;
			historyStatus.textContent = 'Loading history…';
			try {
				const series = await helpers.getHistoryForTicker(ticker);
				if (!series) {
					historyStatus.textContent =
						'No history series for this ticker yet. Run `npm run history:fetch -- --tickers=' +
						ticker +
						' --lookback max` to backfill, or import a CSV via `scripts/import_history_csv.py`.';
					return;
				}
				const summary = helpers.summarizeHistoryWindow(series);
				const isMax = series.lookbackMode === 'max' || (series.lookbackYears === 0 && series.rows > 0);
				const span = spanYears(series.rangeStart, series.rangeEnd);
				const spanLabel = span >= 1 ? `${span.toFixed(1)} years` : `${series.rows} bars`;

				if (historySubtitle) {
					historySubtitle.textContent = isMax
						? `Full available daily OHLCV (${spanLabel}, source: ${series.source}).`
						: `Daily OHLCV — ${spanLabel} window (source: ${series.source}).`;
				}
				historyAsOf.textContent = `As of: ${series.asOfISO || 'pending'}`;
				historyTotal.textContent = pctFormatter.format(summary.totalReturnPct / 100);
				historyAnnualized.textContent = pctFormatter.format(summary.annualizedReturnPct / 100);
				historyDrawdown.textContent = pctFormatter.format(summary.maxDrawdownPct / 100);
				historyVolume.textContent = numFormatter.format(Math.round(summary.avgVolume));
				historyStatus.textContent = `${numFormatter.format(series.rows)} daily bars · ${helpers.dayKeyToISO(series.rangeStart)} → ${helpers.dayKeyToISO(series.rangeEnd)}`;

				if (historyChartHandle) historyChartHandle.dispose();
				historyChartHandle = await mountSparkline(historyChart, series);

				const charts = await whenChartsReady();
				if (charts && historyCalendarChart) {
					if (historyCalendarHandle) historyCalendarHandle.dispose();
					historyCalendarHandle = charts.mountHistoryCalendar(historyCalendarChart, series);
				}
				if (
					charts &&
					historyFlowMonth &&
					historyFlowWeek &&
					historyFlowDay
				) {
					if (historyFlowHandle) historyFlowHandle.dispose();
					try {
						historyFlowHandle = await charts.mountReturnFlowStack(
							historyFlowMonth,
							historyFlowWeek,
							historyFlowDay,
							series,
							{
								month: historyFlowMonthData,
								week: historyFlowWeekData,
								day: historyFlowDayData,
							},
						);
					} catch (flowErr) {
						const msg =
							'<p class="muted" style="padding:12px;font-size:11px;">Return flows unavailable in this browser.</p>';
						historyFlowMonth.innerHTML = msg;
						console.warn('return flow mount failed', flowErr);
					}
				}
				if (charts && historySnowflakeHistory) {
					if (historySnowflakeHistoryHandle) historySnowflakeHistoryHandle.dispose();
					historySnowflakeHistoryHandle = charts.mountHistorySnowflakeRadar(
						historySnowflakeHistory,
						series,
					);
				}
			} catch (err) {
				historyStatus.textContent = `History failed to load: ${err && err.message ? err.message : err}`;
			}
		}

		function whenChartsReady() {
			return Promise.resolve(window.__qbitosCharts__ ?? null);
		}

		async function mountSparkline(host, series) {
			const helpers = window.__qbitosSparkline__;
			if (!helpers?.mountHistorySparkline) return { dispose() {} };
			return helpers.mountHistorySparkline(host, series);
		}

		async function renderSnowflakeCoverage(ticker) {
			if (!snowflakeCard || !snowflakeSummary || !snowflakeAxes || !snowflakeAsOf) return;
			const helpers = await whenCoverageHelpersReady();
			if (!helpers || typeof helpers.getCoverageForTicker !== 'function') return;

			snowflakeCard.hidden = false;
			snowflakeSummary.textContent = 'Loading coverage…';
			snowflakeAxes.innerHTML = '';
			try {
				const profile = await helpers.getCoverageForTicker(ticker);
				if (!profile) {
					snowflakeSummary.textContent = 'No coverage profile is available for this ticker yet.';
					return;
				}
				const summary = helpers.summarizeProfile(profile);
				snowflakeAsOf.textContent = `As of: ${profile.asOfISO || 'pending'}`;
				const filled = summary.totalChecks - summary.naChecks;
				snowflakeSummary.textContent =
					filled === 0
						? `Skeleton scaffold for ${summary.totalChecks} checks across ${summary.axes.length} axes — awaiting research overlay patch.`
						: `${summary.passedChecks} of ${summary.totalChecks} checks passed (${filled} scored, ${summary.naChecks} pending).`;
				const charts = await whenChartsReady();
				const radarHost = document.querySelector('#history-snowflake-radar');
				if (snowflakeRadarHandle) snowflakeRadarHandle.dispose();
				if (charts && radarHost) {
					snowflakeRadarHandle = charts.mountSnowflakeRadar(radarHost, profile);
				}
				if (snowflakeAxisGridHandle) snowflakeAxisGridHandle.dispose();
				if (charts && snowflakeAxisMinis) {
					snowflakeAxisGridHandle = charts.mountSnowflakeAxisGrid(snowflakeAxisMinis, profile.axes);
				}

				snowflakeAxes.innerHTML = profile.axes
					.map((axis) => {
						const passed = axis.checks.filter((check) => check.state === 'pass').length;
						return `
							<article class="snowflake-axis">
								<header>
									<strong>${escapeHtml(axis.label)}</strong>
									<span class="badge muted">${escapeHtml(String(passed))}/${escapeHtml(String(axis.checks.length))}</span>
								</header>
								<ul>
									${axis.checks
										.map(
											(check) => `
												<li>
													<span class="badge ${checkBadge(check.state)}">${escapeHtml(check.state)}</span>
													<div>
														<div class="check-label">${escapeHtml(check.label)}</div>
														<div class="check-detail muted">${escapeHtml(check.detail)}</div>
													</div>
												</li>
											`,
										)
										.join('')}
								</ul>
							</article>
						`;
					})
					.join('');
			} catch (err) {
				snowflakeSummary.textContent = `Coverage failed to load: ${err && err.message ? err.message : err}`;
			}
		}

		function whenListingBridgesReady(timeoutMs = 12000) {
			return new Promise((resolve) => {
				if (
					window.__qbitosCharts__ &&
					window.__qbitosHistoryLoader__ &&
					window.__qbitosSparkline__ &&
					window.__qbitosQuotes__
				) {
					return resolve(true);
				}
				const start = Date.now();
				const done = () =>
					resolve(
						!!(
							window.__qbitosCharts__ &&
							window.__qbitosHistoryLoader__ &&
							window.__qbitosSparkline__ &&
							window.__qbitosQuotes__
						),
					);
				window.addEventListener('qbitos:listing-bridges-ready', () => done(), { once: true });
				const tick = () => {
					if (
						window.__qbitosCharts__ &&
						window.__qbitosHistoryLoader__ &&
						window.__qbitosSparkline__ &&
						window.__qbitosQuotes__
					) {
						return done();
					}
					if (Date.now() - start > timeoutMs) return resolve(false);
					setTimeout(tick, 60);
				};
				tick();
			});
		}

		(async () => {
			await whenListingBridgesReady();
			const params = new URLSearchParams(window.location.search);
			const liveTicker = params.get('t')?.trim();
			const liveLabel = params.get('label')?.trim();
			const recordId = params.get('id')?.trim();

			if (liveTicker && !recordId) {
				try {
					const catalog = await loadCatalog();
					const record = catalog.find(
						(entry) =>
							entry.id === liveTicker ||
							entry.sy === liveTicker ||
							String(entry.id || '').split(':').pop() === liveTicker,
					);
					if (record) {
						const url = new URL(window.location.href);
						url.searchParams.delete('t');
						url.searchParams.delete('label');
						url.searchParams.set('id', record.id);
						window.location.replace(url.toString());
						return;
					}
				} catch {
					/* fall through to lightweight live snapshot */
				}
				showLiveSnapshot(liveTicker, liveLabel);
				return;
			}

			if (!recordId) {
				if (liveRoot) liveRoot.hidden = true;
				statusElement.textContent = 'Choose a listing from the directory to open its profile.';
				emptyTitleElement.textContent = 'No listing selected';
				emptyCopyElement.textContent =
					'Use the main directory page to pick a ticker, ETF, or exchange listing, open a priority-market live snapshot with ?t=…, or open one of the sample links below.';
				return;
			}

			try {
				const catalog = await loadCatalog();
				const record = catalog.find((entry) => entry.id === recordId);

				if (!record) {
					if (liveRoot) liveRoot.hidden = true;
					statusElement.textContent = 'That listing was not found in the generated catalog.';
					emptyTitleElement.textContent = 'Listing not found';
					emptyCopyElement.textContent = `No generated catalog record matched ${recordId}. Try one of the sample profiles below or go back to the directory.`;
					return;
				}

				const legalName = legalEntityLabel(record);
				const tradeName = String(record.nm || record.sy || '').trim();
				document.title = `${legalName} | Train Market Data`;
				emptyElement.hidden = true;
				titleElement.textContent = tradeName || legalName;
				subtitleElement.textContent =
					legalName && tradeName && legalName.toLowerCase() !== tradeName.toLowerCase()
						? `${legalName} · ${record.id} · ${record.ty} · ${record.ex}`
						: `${record.id} · ${record.ty} · ${record.ex}`;
				featuredLink.href = `${baseUrl}featured/?exchange=${encodeURIComponent(record.ex || '')}`;
				idElement.textContent = record.id;
				coverageElement.textContent = record.dc || 'missing';
				coverageElement.className = `badge ${coverageClass(record.dc)}`;
				companyDateElement.textContent = formatDate(record.cd);
				ipoDateElement.textContent = formatDate(record.ip);
				firstTradeElement.textContent = formatDate(record.ft);
				filingTimestampElement.textContent = formatDate(record.lt);
				filingLocationElement.textContent = record.ll || 'Unavailable';
				notesElement.textContent = record.nt || 'No additional notes were provided for this listing.';

				tagsElement.innerHTML = [
					record.ty,
					record.ex,
					record.co,
					record.se || record.ec,
					record.lx,
				]
					.filter(Boolean)
					.map((value) => `<span class="badge muted">${escapeHtml(value)}</span>`)
					.join('');

				renderPairs(identityGrid, [
					['Symbol', record.sy],
					['Exchange', record.ex],
					['Country', record.co],
					['Country code', record.cc],
					['ISIN', record.is],
					['Legal entity', legalName],
					['Legal entity source', record.ls || (record.registry?.source === 'openregistry' ? 'openregistry' : '')],
				]);

				renderPairs(classificationGrid, [
					['Security type', record.ty],
					['Sector', record.se],
					['ETF category', record.ec],
					['Listing exchange label', record.lx],
					['Source universe', record.su],
					['Date coverage', record.dc],
					['IPO/founding completeness', record.ic],
					['LLC filing completeness', record.fc],
					['Statutory filing time', record.lt ? formatDate(record.lt) : ''],
					['Filing venue (SOS / registry)', record.ll],
					['Filing venue coordinates', formatCoords(record.lc)],
					['Filing source', record.fs],
					['Headquarters location', record.hq],
					['Headquarters coordinates', formatCoords(record.hc)],
					['Headquarters source', record.hs],
					['Branch locations', formatBranches(record.br)],
					['Branch source', record.bs],
				]);

				aliasList.innerHTML =
					record.al && record.al.length
						? record.al.map((value) => `<span class="badge muted">${escapeHtml(value)}</span>`).join('')
						: '<span class="muted">No aliases provided.</span>';

				renderEdgarPanel(record);

				statusElement.textContent = 'Profile ready.';
				if (liveRoot) liveRoot.hidden = true;
				contentElement.hidden = false;

				void applyLiveQuote(record);
				void renderProfileInterval(record);
				const coverageTicker = listingTicker(record);
				void renderHistorySparkline(coverageTicker, record.nm);
				void renderSnowflakeCoverage(coverageTicker);
			} catch (error) {
				statusElement.textContent = error.message;
				titleElement.textContent = 'Failed to load listing';
				subtitleElement.textContent = 'The static catalog JSON could not be read.';
			}
		})();
	</script>
</Layout>

