---
import Layout from '../../layouts/Layout.astro';
import summary from '../../generated/catalog-meta.json';

const featuredListings = summary.featuredListings.slice(0, 6);
---

<Layout
	title="Listing Profile | Train Market Data"
	description="Inspect a single market listing from the Erika dataset."
	pageClass="page-stock"
	eyebrow="Listing view"
	subtitle="Single-record dashboard with core metadata, dates, and classification."
>
	<section class="container listing-shell">
		<header class="header">
			<div class="disclaimer" role="note" aria-label="Listing disclaimer">
				<p class="disclaimer__text">
					This listing profile is a static metadata panel for research and education. It does
					not imply investability, recommendation, or data completeness beyond the Erika
					source files.
				</p>
			</div>
		</header>

		<div id="listing-status" class="metaHint">Fetching record…</div>

		<div id="listing-live-root" class="listing-live-root" hidden>
			<div class="stockTopBand">
				<article class="card listing-hero">
					<div class="tileTop">
						<div>
							<div class="ticker">Live market snapshot</div>
							<div id="listing-live-subtitle" class="name">
								Price chart from the same per-ticker daily OHLCV shim as the full listing profile — not Yahoo or
								TradingView.
							</div>
						</div>
						<div class="hero-actions">
							<a id="listing-live-profile" class="button-secondary" href="#">Open catalog profile</a>
							<a class="button-secondary" href="../directory/">← Directory</a>
						</div>
					</div>
					<div class="listing-hero-main">
						<div>
							<p id="listing-live-id" class="metaPill"></p>
							<h1 id="listing-live-title">Loading…</h1>
						</div>
						<span class="badge muted">Erika history</span>
					</div>
					<p class="listing-live-disclaimer muted">
						Data is served from this site’s static history store (<code>public/data/history/</code>) when present.
						Backfill with <code>npm run history:fetch</code> or import CSVs if a ticker is missing. Educational use
						only.
					</p>
				</article>
				<aside class="card listing-metrics">
					<div class="tileTop">
						<div>
							<div class="ticker">Session context</div>
							<div class="name">Use featured markets for regional close logic.</div>
						</div>
					</div>
					<div class="hero-actions" style="margin-top: 12px;">
						<a class="button-secondary" href="../featured/">Featured session</a>
					</div>
				</aside>
			</div>
			<section class="card listing-live-frame-card">
				<div class="tileTop">
					<div>
						<div class="ticker">Current interval</div>
						<div id="listing-live-interval-subtitle" class="name">
							Latest session quote plus trailing daily OHLCV from the shim store.
						</div>
					</div>
					<span id="listing-live-quote-badge" class="badge muted">Quote: —</span>
				</div>
				<div id="listing-live-stats" class="history-stats listing-live-stats" hidden>
					<div class="metric-card">
						<span class="muted">Last close</span>
						<strong id="listing-live-close">—</strong>
					</div>
					<div class="metric-card">
						<span class="muted">Session change</span>
						<strong id="listing-live-change">—</strong>
					</div>
					<div class="metric-card">
						<span class="muted">Total return (window)</span>
						<strong id="listing-live-total-return">—</strong>
					</div>
					<div class="metric-card">
						<span class="muted">Annualized</span>
						<strong id="listing-live-annualized">—</strong>
					</div>
					<div class="metric-card">
						<span class="muted">Max drawdown</span>
						<strong id="listing-live-drawdown">—</strong>
					</div>
					<div class="metric-card">
						<span class="muted">Avg daily volume</span>
						<strong id="listing-live-volume">—</strong>
					</div>
				</div>
				<div id="listing-live-chart" class="history-chart" aria-label="Erika price history chart"></div>
				<p id="listing-live-chart-status" class="muted history-status">Loading history…</p>
			</section>
		</div>

		<section id="listing-empty" class="card listing-empty">
			<div class="tileTop">
				<div>
					<div class="ticker">Listing lookup</div>
					<h2 id="listing-empty-title">Open a listing profile</h2>
					<p id="listing-empty-copy" class="name">
						Choose a listing from the directory, or jump straight into one of these sample
						profiles.
					</p>
				</div>
				<div class="hero-actions">
					<a class="button-secondary" href="../featured/">Open featured market page</a>
					<a class="button-secondary" href="../directory/">Browse directory</a>
					<a class="button-secondary" href="../raw/">Open raw data</a>
				</div>
			</div>
			<div class="listing-empty-links">
				{
					featuredListings.map((item) => (
						<a class="listing-empty-link" href={`?id=${encodeURIComponent(item.id)}`}>
							<strong>{item.nm}</strong>
							<span>{item.id}</span>
						</a>
					))
				}
			</div>
		</section>

		<div id="listing-content" hidden>
			<div class="stockTopBand">
				<article class="card listing-hero">
					<div class="tileTop">
						<div>
							<div class="ticker">Listing profile</div>
							<div id="listing-subtitle" class="name">
								This profile loads from the same static catalog used on the main directory page.
							</div>
						</div>
						<div class="hero-actions">
							<a id="listing-featured-link" class="button-secondary" href="../featured/">
								Featured session
							</a>
							<a class="button-secondary" href="../directory/">← Directory</a>
						</div>
					</div>

					<div class="listing-hero-main">
						<div>
							<p id="listing-id" class="metaPill"></p>
							<h1 id="listing-title">Loading listing…</h1>
						</div>
						<span id="listing-coverage" class="badge muted">missing</span>
					</div>

					<div id="listing-tags" class="listing-tags"></div>
				</article>

				<aside class="card listing-metrics">
					<div class="tileTop">
						<div>
							<div class="ticker">Quick view</div>
							<div class="name">Core dates and notes, similar to the reference page’s top band.</div>
						</div>
					</div>
					<div class="key-metrics">
						<div class="metric-card">
							<span class="muted">Session price</span>
							<strong id="listing-quote-price">—</strong>
						</div>
						<div class="metric-card">
							<span class="muted">Session change</span>
							<strong id="listing-quote-change">—</strong>
						</div>
						<div class="metric-card">
							<span class="muted">Quote as of</span>
							<strong id="listing-quote-asof">—</strong>
						</div>
						<div class="metric-card">
							<span class="muted">Company creation</span>
							<strong id="listing-company-date">Unavailable</strong>
						</div>
						<div class="metric-card">
							<span class="muted">IPO creation</span>
							<strong id="listing-ipo-date">Unavailable</strong>
						</div>
						<div class="metric-card">
							<span class="muted">First trade</span>
							<strong id="listing-first-trade">Unavailable</strong>
						</div>
						<div class="metric-card">
							<span class="muted" title="SEC acceptance time of the earliest registration-class filing (S-1, 8-A12B, etc.) — the statutory filing moment law firms submit to the commission.">
								Statutory filing time
							</span>
							<strong id="listing-filing-timestamp">Unavailable</strong>
						</div>
						<div class="metric-card">
							<span class="muted" title="State secretary-of-state / corporations division venue (courthouse-equivalent), not the issuer's operating HQ.">
								Filing venue (SOS)
							</span>
							<strong id="listing-filing-location">Unavailable</strong>
						</div>
					</div>
					<p id="listing-notes" class="listing-notes muted"></p>
				</aside>
			</div>

			<section class="card listing-panel listing-interval-card" id="listing-interval-card" hidden>
				<div class="tileTop">
					<div>
						<div class="ticker">Current interval</div>
						<div id="interval-subtitle" class="name">
							Latest session quote plus trailing daily OHLCV from the shim store.
						</div>
					</div>
					<span id="interval-quote-badge" class="badge muted">Quote: —</span>
				</div>
				<div id="profile-interval-stats" class="history-stats listing-live-stats" hidden>
					<div class="metric-card">
						<span class="muted">Last close</span>
						<strong id="profile-interval-close">—</strong>
					</div>
					<div class="metric-card">
						<span class="muted">Session change</span>
						<strong id="profile-interval-change">—</strong>
					</div>
					<div class="metric-card">
						<span class="muted">Total return (window)</span>
						<strong id="profile-interval-total-return">—</strong>
					</div>
					<div class="metric-card">
						<span class="muted">Annualized</span>
						<strong id="profile-interval-annualized">—</strong>
					</div>
					<div class="metric-card">
						<span class="muted">Max drawdown</span>
						<strong id="profile-interval-drawdown">—</strong>
					</div>
					<div class="metric-card">
						<span class="muted">Avg daily volume</span>
						<strong id="profile-interval-volume">—</strong>
					</div>
				</div>
				<div id="profile-interval-chart" class="history-chart" aria-label="Current interval price chart"></div>
				<p id="profile-interval-status" class="muted history-status">Loading interval…</p>
			</section>

			<section class="card listing-panel listing-history-card" data-history-card hidden>
				<div class="tileTop">
					<div>
						<div class="ticker">Price history</div>
						<div id="history-subtitle" class="name">
							Full available daily OHLCV from the per-ticker shim store.
						</div>
					</div>
					<span id="history-asof" class="badge muted">As of: —</span>
				</div>
				<div class="history-stats" id="history-stats">
					<div class="metric-card">
						<span class="muted">Total return (window)</span>
						<strong id="history-total-return">—</strong>
					</div>
					<div class="metric-card">
						<span class="muted">Annualized</span>
						<strong id="history-annualized">—</strong>
					</div>
					<div class="metric-card">
						<span class="muted">Max drawdown</span>
						<strong id="history-drawdown">—</strong>
					</div>
					<div class="metric-card">
						<span class="muted">Avg daily volume</span>
						<strong id="history-volume">—</strong>
					</div>
				</div>
				<div id="history-chart" class="history-chart" aria-label="Price history chart"></div>
				<div class="history-viz-grid">
					<div class="history-viz-cell">
						<p class="history-viz-kicker muted">
							Calendar heatmap ·
							<a
								href="https://echarts.apache.org/examples/en/editor.html?c=calendar-simple"
								target="_blank"
								rel="noopener noreferrer">calendar-simple</a
							>
						</p>
						<div
							id="history-calendar-chart"
							class="history-calendar-chart"
							aria-label="Daily return calendar heatmap"
						></div>
					</div>
					<div class="history-viz-cell history-viz-cell--flows">
						<p class="history-viz-kicker muted">
							Return flows ·
							<a
								href="https://echarts.apache.org/examples/en/editor.html?c=flowGL-noise&gl=1&theme=dark"
								target="_blank"
								rel="noopener noreferrer">flowGL-noise</a
							>
							(bars = period return; particles = flow direction)
						</p>
						<div class="flow-panel">
							<div id="history-flow-month" class="history-flow-chart-sm" aria-label="Monthly return flow"></div>
							<p id="history-flow-month-data" class="flow-data-strip muted"></p>
						</div>
						<div class="flow-panel">
							<div id="history-flow-week" class="history-flow-chart-sm" aria-label="Weekly return flow"></div>
							<p id="history-flow-week-data" class="flow-data-strip muted"></p>
						</div>
						<div class="flow-panel">
							<div id="history-flow-day" class="history-flow-chart-sm" aria-label="Daily return flow"></div>
							<p id="history-flow-day-data" class="flow-data-strip muted"></p>
						</div>
					</div>
					<div class="history-viz-cell history-viz-cell--snowflake">
						<p class="history-viz-kicker muted">Snowflake coverage · pass rate + axis detail + OHLCV shape</p>
						<div
							id="history-snowflake-radar"
							class="history-snowflake-radar"
							aria-label="Snowflake coverage radar"
						></div>
						<div
							id="history-snowflake-history"
							class="history-snowflake-radar history-snowflake-radar--secondary"
							aria-label="History-derived snowflake"
						></div>
						<div id="snowflake-axis-minis" class="snowflake-mini-grid" aria-label="Per-axis snowflake charts"></div>
					</div>
				</div>
				<p id="history-status" class="muted history-status">Loading history…</p>
			</section>

			<section class="card listing-panel listing-snowflake-card" data-snowflake-card hidden>
				<div class="tileTop">
					<div>
						<div class="ticker">Snowflake coverage</div>
						<div class="name">5-axis health profile (Value · Future · Past · Health · Dividends).</div>
					</div>
					<span id="snowflake-asof" class="badge muted">As of: —</span>
				</div>
				<p id="snowflake-summary" class="muted">Loading coverage…</p>
				<div id="snowflake-axes" class="snowflake-axes-grid"></div>
			</section>

			<section class="listing-panels">
				<article class="card listing-panel">
					<div class="tileTop">
						<div>
							<div class="ticker">Identity</div>
							<div class="name">Ticker, venue, jurisdiction, and entity fields.</div>
						</div>
					</div>
					<dl class="detail-grid" id="identity-grid"></dl>
				</article>

				<article class="card listing-panel">
					<div class="tileTop">
						<div>
							<div class="ticker">Classification</div>
							<div class="name">Security type, sector/category, and source annotations.</div>
						</div>
					</div>
					<dl class="detail-grid" id="classification-grid"></dl>
				</article>

				<article class="card listing-panel">
					<div class="tileTop">
						<div>
							<div class="ticker">Aliases</div>
							<div class="name">Alternate names and search variants stored in the dataset.</div>
						</div>
					</div>
					<div id="alias-list" class="alias-list muted">No aliases provided.</div>
				</article>
			</section>

			<section id="listing-edgar-panel" class="card listing-panel" hidden>
				<div class="tileTop">
					<div>
						<div class="ticker">Registry &amp; filings</div>
						<div class="name">OpenRegistry statutory profile (non-US) or SEC EDGAR (US filers).</div>
					</div>
				</div>
				<div id="listing-edgar-links" class="listing-edgar-links"></div>
				<p class="muted listing-edgar-note">
					US listings use SEC EDGAR (public domain). Other jurisdictions link to OpenRegistry when an enriched
					registry match exists. Educational use only.
				</p>
			</section>
		</div>
	</section>

	<script>
		import {
			getCoverageForTicker,
			getCoverageSummaryForTicker,
			loadHealthManifest,
			prefetchShardForTicker,
			summarizeProfile,
		} from '../../lib/health-shard-loader.ts';
		import {
			getHistoryForTicker,
			hasHistoryForTicker,
			loadHistoryManifest,
			summarizeHistoryWindow,
			dayKeyToISO,
		} from '../../lib/history-shard-loader.ts';
		import { mountHistorySparkline } from '../../lib/history-sparkline.ts';
		import { mountHistoryCalendar } from '../../lib/history-calendar-chart.ts';
		import { mountReturnFlowStack } from '../../lib/history-period-flow-chart.ts';
		import { mountSnowflakeRadar } from '../../lib/snowflake-radar-chart.ts';
		import { mountHistorySnowflakeRadar } from '../../lib/history-snowflake-radar.ts';
		import { mountSnowflakeAxisGrid } from '../../lib/snowflake-axis-mini-chart.ts';
		import { loadQuotesLatest, quoteForTicker } from '../../lib/quotes-latest.ts';

		window.__qbitosCharts__ = {
			mountHistoryCalendar,
			mountReturnFlowStack,
			mountSnowflakeRadar,
			mountHistorySnowflakeRadar,
			mountSnowflakeAxisGrid,
		};
		window.__qbitosHealthLoader__ = {
			getCoverageForTicker,
			getCoverageSummaryForTicker,
			loadHealthManifest,
			prefetchShardForTicker,
			summarizeProfile,
		};
		window.__qbitosHistoryLoader__ = {
			getHistoryForTicker,
			hasHistoryForTicker,
			loadHistoryManifest,
			summarizeHistoryWindow,
			dayKeyToISO,
		};
		window.__qbitosSparkline__ = { mountHistorySparkline };
		window.__qbitosQuotes__ = { loadQuotesLatest, quoteForTicker };
		window.dispatchEvent(new CustomEvent('qbitos:listing-bridges-ready'));
	</script>

	<script is:inline define:vars={{ baseUrl: import.meta.env.BASE_URL }}>
		const statusElement = document.querySelector('#listing-status');
		const liveRoot = document.querySelector('#listing-live-root');
		const liveTitle = document.querySelector('#listing-live-title');
		const liveId = document.querySelector('#listing-live-id');
		const liveProfile = document.querySelector('#listing-live-profile');
		const liveStats = document.querySelector('#listing-live-stats');
		const liveIntervalSubtitle = document.querySelector('#listing-live-interval-subtitle');
		const liveQuoteBadge = document.querySelector('#listing-live-quote-badge');
		const liveChart = document.querySelector('#listing-live-chart');
		const liveChartStatus = document.querySelector('#listing-live-chart-status');
		const liveClose = document.querySelector('#listing-live-close');
		const liveChange = document.querySelector('#listing-live-change');
		const liveTotal = document.querySelector('#listing-live-total-return');
		const liveAnnualized = document.querySelector('#listing-live-annualized');
		const liveDrawdown = document.querySelector('#listing-live-drawdown');
		const liveVolume = document.querySelector('#listing-live-volume');
		const emptyElement = document.querySelector('#listing-empty');
		const emptyTitleElement = document.querySelector('#listing-empty-title');
		const emptyCopyElement = document.querySelector('#listing-empty-copy');
		const contentElement = document.querySelector('#listing-content');
		const titleElement = document.querySelector('#listing-title');
		const subtitleElement = document.querySelector('#listing-subtitle');
		const idElement = document.querySelector('#listing-id');
		const coverageElement = document.querySelector('#listing-coverage');
		const companyDateElement = document.querySelector('#listing-company-date');
		const ipoDateElement = document.querySelector('#listing-ipo-date');
		const firstTradeElement = document.querySelector('#listing-first-trade');
		const filingTimestampElement = document.querySelector('#listing-filing-timestamp');
		const filingLocationElement = document.querySelector('#listing-filing-location');
		const quotePriceElement = document.querySelector('#listing-quote-price');
		const quoteChangeElement = document.querySelector('#listing-quote-change');
		const quoteAsofElement = document.querySelector('#listing-quote-asof');
		const notesElement = document.querySelector('#listing-notes');
		const intervalCard = document.querySelector('#listing-interval-card');
		const intervalSubtitle = document.querySelector('#interval-subtitle');
		const intervalQuoteBadge = document.querySelector('#interval-quote-badge');
		const profileIntervalStats = document.querySelector('#profile-interval-stats');
		const profileIntervalChart = document.querySelector('#profile-interval-chart');
		const profileIntervalStatus = document.querySelector('#profile-interval-status');
		const profileIntervalClose = document.querySelector('#profile-interval-close');
		const profileIntervalChange = document.querySelector('#profile-interval-change');
		const profileIntervalTotal = document.querySelector('#profile-interval-total-return');
		const profileIntervalAnnualized = document.querySelector('#profile-interval-annualized');
		const profileIntervalDrawdown = document.querySelector('#profile-interval-drawdown');
		const profileIntervalVolume = document.querySelector('#profile-interval-volume');
		const tagsElement = document.querySelector('#listing-tags');
		const identityGrid = document.querySelector('#identity-grid');
		const classificationGrid = document.querySelector('#classification-grid');
		const aliasList = document.querySelector('#alias-list');
		const featuredLink = document.querySelector('#listing-featured-link');
		const edgarPanel = document.querySelector('#listing-edgar-panel');
		const edgarLinks = document.querySelector('#listing-edgar-links');
		const dateFormatter = new Intl.DateTimeFormat(undefined, { dateStyle: 'medium' });

		function escapeHtml(value) {
			return String(value || '').replace(/[&<>'"]/g, (character) => {
				return (
					{
						'&': '&amp;',
						'<': '&lt;',
						'>': '&gt;',
						"'": '&#39;',
						'"': '&quot;',
					}[character] || character
				);
			});
		}

		function formatDate(value) {
			if (!value) return 'Unavailable';
			const date = new Date(value);
			return Number.isNaN(date.getTime()) ? value : dateFormatter.format(date);
		}

		function formatCoords(value) {
			if (!Array.isArray(value) || value.length !== 2) return 'Unavailable';
			const [lat, lon] = value;
			if (!Number.isFinite(lat) || !Number.isFinite(lon)) return 'Unavailable';
			const label = `${lat.toFixed(6)}, ${lon.toFixed(6)}`;
			const mapUrl = `https://www.openstreetmap.org/?mlat=${lat}&mlon=${lon}#map=14/${lat}/${lon}`;
			return `<a href="${escapeHtml(mapUrl)}" target="_blank" rel="noopener noreferrer">${escapeHtml(label)}</a>`;
		}

		function formatBranches(value) {
			if (!Array.isArray(value) || !value.length) return 'Unavailable';
			return value
				.map((entry) => {
					if (typeof entry === 'string') return entry;
					if (!entry || typeof entry !== 'object') return '';
					const label = [entry.name, entry.location, formatCoords(entry.coords)]
						.filter((part) => part && part !== 'Unavailable')
						.join(' · ');
					return label || 'Branch';
				})
				.filter(Boolean)
				.join(' | ');
		}

		function coverageClass(coverage) {
			if (coverage === 'complete') return 'success';
			if (coverage === 'partial') return 'warning';
			return 'muted';
		}

		function renderPairs(target, entries) {
			target.innerHTML = entries
				.map(([label, value]) => {
					const raw = value || 'Unavailable';
					const isHtml = typeof raw === 'string' && raw.includes('<a ');
					return `
						<div>
							<dt>${escapeHtml(label)}</dt>
							<dd>${isHtml ? raw : escapeHtml(raw)}</dd>
						</div>
					`;
				})
				.join('');
		}

		let liveChartHandle = null;
		let profileIntervalChartHandle = null;
		const numFormatter = new Intl.NumberFormat();
		const pctFormatter = new Intl.NumberFormat(undefined, {
			style: 'percent',
			minimumFractionDigits: 1,
			maximumFractionDigits: 2,
		});

		function listingTicker(record) {
			return String(record.sy || record.id || '').trim();
		}

		function applyQuoteToIntervalTargets(file, quote, sym, targets) {
			if (!quote) return;
			if (targets.closeEl) targets.closeEl.textContent = numFormatter.format(quote.price);
			if (targets.changeEl) {
				const sign = quote.changePct >= 0 ? '+' : '';
				targets.changeEl.textContent = `${sign}${quote.changePct.toFixed(2)}%`;
				targets.changeEl.className = quote.changePct >= 0 ? 'quote-up' : 'quote-down';
			}
			if (targets.quoteBadgeEl) {
				targets.quoteBadgeEl.textContent = `Quote: ${quote.sessionDate || file?.asOf || '—'}`;
				targets.quoteBadgeEl.className = 'badge success';
			}
		}

		/** Shared quote + OHLCV interval panel for profile and ?t= live snapshot. */
		async function mountIntervalPanel(ticker, targets) {
			const sym = String(ticker || '').trim();
			if (!sym) return;

			await whenListingBridgesReady();
			if (targets.statusEl) targets.statusEl.textContent = 'Loading interval…';
			if (targets.statsRoot) targets.statsRoot.hidden = true;
			if (targets.chartHandleRef?.handle) {
				targets.chartHandleRef.handle.dispose();
				targets.chartHandleRef.handle = null;
			}
			if (targets.chartEl) targets.chartEl.innerHTML = '';

			const quotesApi = window.__qbitosQuotes__;
			const quotesPromise = quotesApi?.loadQuotesLatest
				? Promise.race([
						quotesApi.loadQuotesLatest(),
						new Promise((resolve) => setTimeout(() => resolve(null), 4000)),
					])
				: Promise.resolve(null);

			const helpers = await whenHistoryHelpersReady();
			if (!helpers) {
				if (targets.statusEl) targets.statusEl.textContent = 'History loader unavailable; refresh the page.';
				return;
			}
			try {
				const [file, series] = await Promise.all([
					quotesPromise,
					helpers.getHistoryForTicker(sym),
				]);
				const quote = quotesApi?.quoteForTicker ? quotesApi.quoteForTicker(file, sym) : null;
				applyQuoteToIntervalTargets(file, quote, sym, targets);
				if (!series) {
					if (targets.statusEl) {
						targets.statusEl.textContent =
							`No OHLCV shim for ${sym}. Run npm run history:fetch -- --tickers=${sym} --lookback max`;
					}
					return;
				}
				const summary = helpers.summarizeHistoryWindow(series);
				if (targets.statsRoot) targets.statsRoot.hidden = false;
				if (targets.totalEl) targets.totalEl.textContent = pctFormatter.format(summary.totalReturnPct / 100);
				if (targets.annualizedEl) targets.annualizedEl.textContent = pctFormatter.format(summary.annualizedReturnPct / 100);
				if (targets.drawdownEl) targets.drawdownEl.textContent = pctFormatter.format(summary.maxDrawdownPct / 100);
				if (targets.volumeEl) targets.volumeEl.textContent = numFormatter.format(Math.round(summary.avgVolume));
				if (!quote?.price && targets.closeEl && series.c.length) {
					targets.closeEl.textContent = numFormatter.format(series.c[series.c.length - 1]);
				}
				if (targets.subtitleEl) {
					targets.subtitleEl.textContent = `${numFormatter.format(series.rows)} daily bars · ${helpers.dayKeyToISO(series.rangeStart)} → ${helpers.dayKeyToISO(series.rangeEnd)}`;
				}
				if (targets.statusEl) {
					targets.statusEl.textContent = quote
						? `Live quote ${quote.sessionDate} · history source ${series.source}`
						: `History source ${series.source} (no quote row for ${sym})`;
				}
				if (targets.chartEl) {
					const handle = await mountSparkline(targets.chartEl, series);
					if (targets.chartHandleRef) targets.chartHandleRef.handle = handle;
				}
			} catch (err) {
				if (targets.statusEl) {
					targets.statusEl.textContent = `Interval failed: ${err && err.message ? err.message : err}`;
				}
			}
		}

		async function applyLiveQuote(record) {
			const ticker = listingTicker(record);
			const quotesApi = window.__qbitosQuotes__;
			if (!quotesApi?.loadQuotesLatest) return;
			const file = await quotesApi.loadQuotesLatest();
			const quote = quotesApi.quoteForTicker(file, ticker);
			if (!quote) {
				if (quotePriceElement) quotePriceElement.textContent = 'No quote in snapshot';
				if (quoteChangeElement) quoteChangeElement.textContent = '—';
				if (quoteAsofElement) quoteAsofElement.textContent = file?.asOf || '—';
				return;
			}
			if (quotePriceElement) quotePriceElement.textContent = numFormatter.format(quote.price);
			if (quoteChangeElement) {
				const sign = quote.changePct >= 0 ? '+' : '';
				quoteChangeElement.textContent = `${sign}${quote.changePct.toFixed(2)}%`;
				quoteChangeElement.className = quote.changePct >= 0 ? 'quote-up' : 'quote-down';
			}
			if (quoteAsofElement) quoteAsofElement.textContent = quote.sessionDate || file.asOf || '—';
			if (intervalQuoteBadge) {
				intervalQuoteBadge.textContent = `Quote: ${quote.sessionDate || file.asOf}`;
				intervalQuoteBadge.className = 'badge success';
			}
		}

