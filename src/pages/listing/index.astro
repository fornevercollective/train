---
import Layout from '../../layouts/Layout.astro';
import summary from '../../generated/catalog-meta.json';
import { YAHOO_TO_TRADINGVIEW } from '../../lib/yahoo-tv-map';

const featuredListings = summary.featuredListings.slice(0, 6);
---

<Layout
	title="Listing Profile | Erika Market Directory"
	description="Inspect a single market listing from the Erika dataset."
	pageClass="page-stock"
	eyebrow="Listing view"
	subtitle="Single-record dashboard with core metadata, dates, and classification."
>
	<section class="container listing-shell">
		<header class="header">
			<div class="disclaimer" role="note" aria-label="Listing disclaimer">
				<p class="disclaimer__text">
					This listing profile is a static metadata panel for research and education. It does
					not imply investability, recommendation, or data completeness beyond the Erika
					source files.
				</p>
			</div>
		</header>

		<div id="listing-status" class="metaHint">Fetching record…</div>

		<div id="listing-live-root" class="listing-live-root" hidden>
			<div class="stockTopBand">
				<article class="card listing-hero">
					<div class="tileTop">
						<div>
							<div class="ticker">Live market snapshot</div>
							<div id="listing-live-subtitle" class="name">
								Hourly-capable TradingView embed plus Yahoo Finance for the same Yahoo-style
								symbol.
							</div>
						</div>
						<div class="hero-actions">
							<a id="listing-live-yahoo" class="button-secondary" href="#" target="_blank" rel="noreferrer"
								>Open Yahoo Finance</a
							>
							<a class="button-secondary" href="../directory/">← Directory</a>
						</div>
					</div>
					<div class="listing-hero-main">
						<div>
							<p id="listing-live-id" class="metaPill"></p>
							<h1 id="listing-live-title">Loading…</h1>
						</div>
						<span class="badge muted">External quote</span>
					</div>
					<p class="listing-live-disclaimer muted">
						Quotes load from TradingView’s embed; they are indicative, can differ from the Erika
						static lake, and are not investment advice.
					</p>
				</article>
				<aside class="card listing-metrics">
					<div class="tileTop">
						<div>
							<div class="ticker">Session context</div>
							<div class="name">Use featured markets for regional close logic.</div>
						</div>
					</div>
					<div class="hero-actions" style="margin-top: 12px;">
						<a class="button-secondary" href="../featured/">Featured session</a>
					</div>
				</aside>
			</div>
			<section class="card listing-live-frame-card">
				<div class="tileTop">
					<div>
						<div class="ticker">Current interval</div>
						<div class="name">Embedded overview (60m); open Yahoo for full depth.</div>
					</div>
				</div>
				<iframe
					id="listing-live-iframe"
					class="listing-live-iframe"
					title="Live quote"
					referrerpolicy="no-referrer-when-downgrade"
				></iframe>
			</section>
		</div>

		<section id="listing-empty" class="card listing-empty">
			<div class="tileTop">
				<div>
					<div class="ticker">Listing lookup</div>
					<h2 id="listing-empty-title">Open a listing profile</h2>
					<p id="listing-empty-copy" class="name">
						Choose a listing from the directory, or jump straight into one of these sample
						profiles.
					</p>
				</div>
				<div class="hero-actions">
					<a class="button-secondary" href="../featured/">Open featured market page</a>
					<a class="button-secondary" href="../directory/">Browse directory</a>
					<a class="button-secondary" href="../raw/">Open raw data</a>
				</div>
			</div>
			<div class="listing-empty-links">
				{
					featuredListings.map((item) => (
						<a class="listing-empty-link" href={`?id=${encodeURIComponent(item.id)}`}>
							<strong>{item.nm}</strong>
							<span>{item.id}</span>
						</a>
					))
				}
			</div>
		</section>

		<div id="listing-content" hidden>
			<div class="stockTopBand">
				<article class="card listing-hero">
					<div class="tileTop">
						<div>
							<div class="ticker">Listing profile</div>
							<div id="listing-subtitle" class="name">
								This profile loads from the same static catalog used on the main directory page.
							</div>
						</div>
						<div class="hero-actions">
							<a id="listing-featured-link" class="button-secondary" href="../featured/">
								Featured session
							</a>
							<a class="button-secondary" href="../directory/">← Directory</a>
						</div>
					</div>

					<div class="listing-hero-main">
						<div>
							<p id="listing-id" class="metaPill"></p>
							<h1 id="listing-title">Loading listing…</h1>
						</div>
						<span id="listing-coverage" class="badge muted">missing</span>
					</div>

					<div id="listing-tags" class="listing-tags"></div>
				</article>

				<aside class="card listing-metrics">
					<div class="tileTop">
						<div>
							<div class="ticker">Quick view</div>
							<div class="name">Core dates and notes, similar to the reference page’s top band.</div>
						</div>
					</div>
					<div class="key-metrics">
						<div class="metric-card">
							<span class="muted">Company creation</span>
							<strong id="listing-company-date">Unavailable</strong>
						</div>
						<div class="metric-card">
							<span class="muted">IPO creation</span>
							<strong id="listing-ipo-date">Unavailable</strong>
						</div>
						<div class="metric-card">
							<span class="muted">First trade</span>
							<strong id="listing-first-trade">Unavailable</strong>
						</div>
					</div>
					<p id="listing-notes" class="listing-notes muted"></p>
				</aside>
			</div>

			<section class="card listing-panel listing-snowflake-card" data-snowflake-card hidden>
				<div class="tileTop">
					<div>
						<div class="ticker">Snowflake coverage</div>
						<div class="name">5-axis health profile (Value · Future · Past · Health · Dividends).</div>
					</div>
					<span id="snowflake-asof" class="badge muted">As of: —</span>
				</div>
				<p id="snowflake-summary" class="muted" style="margin-top: 12px;">Loading coverage…</p>
				<div id="snowflake-axes" class="snowflake-axes-grid"></div>
			</section>

			<section class="listing-panels">
				<article class="card listing-panel">
					<div class="tileTop">
						<div>
							<div class="ticker">Identity</div>
							<div class="name">Ticker, venue, jurisdiction, and entity fields.</div>
						</div>
					</div>
					<dl class="detail-grid" id="identity-grid"></dl>
				</article>

				<article class="card listing-panel">
					<div class="tileTop">
						<div>
							<div class="ticker">Classification</div>
							<div class="name">Security type, sector/category, and source annotations.</div>
						</div>
					</div>
					<dl class="detail-grid" id="classification-grid"></dl>
				</article>

				<article class="card listing-panel">
					<div class="tileTop">
						<div>
							<div class="ticker">Aliases</div>
							<div class="name">Alternate names and search variants stored in the dataset.</div>
						</div>
					</div>
					<div id="alias-list" class="alias-list muted">No aliases provided.</div>
				</article>
			</section>
		</div>
	</section>

	<script is:inline define:vars={{ baseUrl: import.meta.env.BASE_URL, YAHOO_TO_TRADINGVIEW }}>
		const statusElement = document.querySelector('#listing-status');
		const liveRoot = document.querySelector('#listing-live-root');
		const liveTitle = document.querySelector('#listing-live-title');
		const liveId = document.querySelector('#listing-live-id');
		const liveIframe = document.querySelector('#listing-live-iframe');
		const liveYahoo = document.querySelector('#listing-live-yahoo');
		const emptyElement = document.querySelector('#listing-empty');
		const emptyTitleElement = document.querySelector('#listing-empty-title');
		const emptyCopyElement = document.querySelector('#listing-empty-copy');
		const contentElement = document.querySelector('#listing-content');
		const titleElement = document.querySelector('#listing-title');
		const subtitleElement = document.querySelector('#listing-subtitle');
		const idElement = document.querySelector('#listing-id');
		const coverageElement = document.querySelector('#listing-coverage');
		const companyDateElement = document.querySelector('#listing-company-date');
		const ipoDateElement = document.querySelector('#listing-ipo-date');
		const firstTradeElement = document.querySelector('#listing-first-trade');
		const notesElement = document.querySelector('#listing-notes');
		const tagsElement = document.querySelector('#listing-tags');
		const identityGrid = document.querySelector('#identity-grid');
		const classificationGrid = document.querySelector('#classification-grid');
		const aliasList = document.querySelector('#alias-list');
		const featuredLink = document.querySelector('#listing-featured-link');
		const dateFormatter = new Intl.DateTimeFormat(undefined, { dateStyle: 'medium' });

		function escapeHtml(value) {
			return String(value || '').replace(/[&<>'"]/g, (character) => {
				return (
					{
						'&': '&amp;',
						'<': '&lt;',
						'>': '&gt;',
						"'": '&#39;',
						'"': '&quot;',
					}[character] || character
				);
			});
		}

		function formatDate(value) {
			if (!value) return 'Unavailable';
			const date = new Date(value);
			return Number.isNaN(date.getTime()) ? value : dateFormatter.format(date);
		}

		function coverageClass(coverage) {
			if (coverage === 'complete') return 'success';
			if (coverage === 'partial') return 'warning';
			return 'muted';
		}

		function renderPairs(target, entries) {
			target.innerHTML = entries
				.map(
					([label, value]) => `
						<div>
							<dt>${escapeHtml(label)}</dt>
							<dd>${escapeHtml(value || 'Unavailable')}</dd>
						</div>
					`,
				)
				.join('');
		}

		function tradingViewMiniUrl(tvSymbol) {
			const params = new URLSearchParams({
				locale: 'en',
				symbol: tvSymbol,
				colorTheme: 'dark',
				isTransparent: 'true',
				autosize: 'true',
				interval: '60',
			});
			return `https://www.tradingview-widget.com/embed-widget/mini-symbol-overview/?${params.toString()}`;
		}

		function showLiveSnapshot(ticker, label) {
			const tvSymbol = YAHOO_TO_TRADINGVIEW[ticker];
			const displayName = label || ticker;
			document.title = `${displayName} | Live snapshot`;
			statusElement.textContent = 'Live snapshot ready.';
			emptyElement.hidden = true;
			contentElement.hidden = true;
			liveRoot.hidden = false;
			liveTitle.textContent = displayName;
			liveId.textContent = ticker;
			const yahooUrl = `https://finance.yahoo.com/quote/${encodeURIComponent(ticker)}`;
			liveYahoo.href = yahooUrl;
			if (tvSymbol) {
				liveIframe.src = tradingViewMiniUrl(tvSymbol);
				liveIframe.hidden = false;
			} else {
				liveIframe.removeAttribute('src');
				liveIframe.hidden = true;
				statusElement.textContent =
					'No TradingView mapping for this ticker; use Yahoo Finance for live context.';
			}
		}

		async function loadCatalog() {
			const response = await fetch(`${baseUrl}data/catalog.json`);
			if (!response.ok) {
				throw new Error(`Failed to load catalog: ${response.status}`);
			}

			return response.json();
		}

		const snowflakeCard = document.querySelector('[data-snowflake-card]');
		const snowflakeSummary = document.querySelector('#snowflake-summary');
		const snowflakeAxes = document.querySelector('#snowflake-axes');
		const snowflakeAsOf = document.querySelector('#snowflake-asof');

		function whenCoverageHelpersReady(timeoutMs = 8000) {
			return new Promise((resolve) => {
				if (window.__qbitosHealthLoader__) return resolve(window.__qbitosHealthLoader__);
				const start = Date.now();
				const handler = () => resolve(window.__qbitosHealthLoader__ ?? null);
				const tick = () => {
					if (window.__qbitosHealthLoader__) return resolve(window.__qbitosHealthLoader__);
					if (Date.now() - start > timeoutMs) return resolve(null);
					setTimeout(tick, 80);
				};
				window.addEventListener('qbitos:health-loader-ready', handler, { once: true });
				tick();
			});
		}

		function checkBadge(state) {
			if (state === 'pass') return 'success';
			if (state === 'fail') return 'warning';
			return 'muted';
		}

		async function renderSnowflakeCoverage(ticker) {
			if (!snowflakeCard || !snowflakeSummary || !snowflakeAxes || !snowflakeAsOf) return;
			const helpers = await whenCoverageHelpersReady();
			if (!helpers || typeof helpers.getCoverageForTicker !== 'function') return;

			snowflakeCard.hidden = false;
			snowflakeSummary.textContent = 'Loading coverage…';
			snowflakeAxes.innerHTML = '';
			try {
				const profile = await helpers.getCoverageForTicker(ticker);
				if (!profile) {
					snowflakeSummary.textContent = 'No coverage profile is available for this ticker yet.';
					return;
				}
				const summary = helpers.summarizeProfile(profile);
				snowflakeAsOf.textContent = `As of: ${profile.asOfISO || 'pending'}`;
				const filled = summary.totalChecks - summary.naChecks;
				snowflakeSummary.textContent =
					filled === 0
						? `Skeleton scaffold for ${summary.totalChecks} checks across ${summary.axes.length} axes — awaiting research overlay patch.`
						: `${summary.passedChecks} of ${summary.totalChecks} checks passed (${filled} scored, ${summary.naChecks} pending).`;
				snowflakeAxes.innerHTML = profile.axes
					.map((axis) => {
						const passed = axis.checks.filter((check) => check.state === 'pass').length;
						return `
							<article class="snowflake-axis">
								<header>
									<strong>${escapeHtml(axis.label)}</strong>
									<span class="badge muted">${escapeHtml(String(passed))}/${escapeHtml(String(axis.checks.length))}</span>
								</header>
								<ul>
									${axis.checks
										.map(
											(check) => `
												<li>
													<span class="badge ${checkBadge(check.state)}">${escapeHtml(check.state)}</span>
													<div>
														<div class="check-label">${escapeHtml(check.label)}</div>
														<div class="check-detail muted">${escapeHtml(check.detail)}</div>
													</div>
												</li>
											`,
										)
										.join('')}
								</ul>
							</article>
						`;
					})
					.join('');
			} catch (err) {
				snowflakeSummary.textContent = `Coverage failed to load: ${err && err.message ? err.message : err}`;
			}
		}

		(async () => {
			const params = new URLSearchParams(window.location.search);
			const liveTicker = params.get('t')?.trim();
			const liveLabel = params.get('label')?.trim();
			const recordId = params.get('id')?.trim();

			if (liveTicker && !recordId) {
				showLiveSnapshot(liveTicker, liveLabel);
				return;
			}

			if (!recordId) {
				statusElement.textContent = 'Choose a listing from the directory to open its profile.';
				emptyTitleElement.textContent = 'No listing selected';
				emptyCopyElement.textContent =
					'Use the main directory page to pick a ticker, ETF, or exchange listing, open a priority-market live snapshot with ?t=…, or open one of the sample links below.';
				return;
			}

			try {
				const catalog = await loadCatalog();
				const record = catalog.find((entry) => entry.id === recordId);

				if (!record) {
					statusElement.textContent = 'That listing was not found in the generated catalog.';
					emptyTitleElement.textContent = 'Listing not found';
					emptyCopyElement.textContent = `No generated catalog record matched ${recordId}. Try one of the sample profiles below or go back to the directory.`;
					return;
				}

				document.title = `${record.nm} | Erika Market Directory`;
				emptyElement.hidden = true;
				titleElement.textContent = record.nm;
				subtitleElement.textContent = `${record.id} · ${record.ty} · ${record.ex}`;
				featuredLink.href = `${baseUrl}featured/?exchange=${encodeURIComponent(record.ex || '')}`;
				idElement.textContent = record.id;
				coverageElement.textContent = record.dc || 'missing';
				coverageElement.className = `badge ${coverageClass(record.dc)}`;
				companyDateElement.textContent = formatDate(record.cd);
				ipoDateElement.textContent = formatDate(record.ip);
				firstTradeElement.textContent = formatDate(record.ft);
				notesElement.textContent = record.nt || 'No additional notes were provided for this listing.';

				tagsElement.innerHTML = [
					record.ty,
					record.ex,
					record.co,
					record.se || record.ec,
					record.lx,
				]
					.filter(Boolean)
					.map((value) => `<span class="badge muted">${escapeHtml(value)}</span>`)
					.join('');

				renderPairs(identityGrid, [
					['Symbol', record.sy],
					['Exchange', record.ex],
					['Country', record.co],
					['Country code', record.cc],
					['ISIN', record.is],
					['Legal entity', record.ln || record.nm],
				]);

				renderPairs(classificationGrid, [
					['Security type', record.ty],
					['Sector', record.se],
					['ETF category', record.ec],
					['Listing exchange label', record.lx],
					['Source universe', record.su],
					['Date coverage', record.dc],
				]);

				aliasList.innerHTML =
					record.al && record.al.length
						? record.al.map((value) => `<span class="badge muted">${escapeHtml(value)}</span>`).join('')
						: '<span class="muted">No aliases provided.</span>';

				statusElement.textContent = 'Profile ready.';
				contentElement.hidden = false;

				void renderSnowflakeCoverage(record.id);
			} catch (error) {
				statusElement.textContent = error.message;
				titleElement.textContent = 'Failed to load listing';
				subtitleElement.textContent = 'The static catalog JSON could not be read.';
			}
		})();
	</script>

	<script>
		import {
			getCoverageForTicker,
			getCoverageSummaryForTicker,
			loadHealthManifest,
			prefetchShardForTicker,
			summarizeProfile,
		} from '../../lib/health-shard-loader.ts';

		window.__qbitosHealthLoader__ = {
			getCoverageForTicker,
			getCoverageSummaryForTicker,
			loadHealthManifest,
			prefetchShardForTicker,
			summarizeProfile,
		};
		window.dispatchEvent(new CustomEvent('qbitos:health-loader-ready'));
	</script>
</Layout>

<style>
	.listing-snowflake-card {
		padding: 16px;
		display: flex;
		flex-direction: column;
		gap: 12px;
	}

	.snowflake-axes-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
		gap: 12px;
	}

	.snowflake-axis {
		padding: 12px;
		border-radius: 14px;
		background: rgba(0, 0, 0, 0.22);
		border: 1px solid rgba(255, 255, 255, 0.1);
	}

	.snowflake-axis header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 8px;
	}

	.snowflake-axis ul {
		list-style: none;
		padding: 0;
		margin: 12px 0 0;
		display: flex;
		flex-direction: column;
		gap: 8px;
	}

	.snowflake-axis li {
		display: flex;
		gap: 10px;
		align-items: flex-start;
	}

	.snowflake-axis .check-label {
		font-weight: 600;
	}

	.snowflake-axis .check-detail {
		font-size: 12px;
		margin-top: 2px;
	}

	.listing-shell {
		display: flex;
		flex-direction: column;
		gap: 16px;
	}

	.listing-live-root {
		display: flex;
		flex-direction: column;
		gap: 16px;
	}

	.listing-live-disclaimer {
		margin: 12px 0 0;
		line-height: 1.55;
		font-size: 0.92rem;
	}

	.listing-live-frame-card {
		padding: 16px;
	}

	.listing-live-iframe {
		display: block;
		width: 100%;
		min-height: 420px;
		margin-top: 14px;
		border: 0;
		border-radius: 14px;
		background: rgba(0, 0, 0, 0.2);
	}

	.header {
		display: flex;
		flex-direction: column;
		gap: 16px;
	}

	.stockTopBand {
		display: grid;
		grid-template-columns: minmax(0, 1.3fr) minmax(320px, 0.9fr);
		gap: 16px;
	}

	.listing-empty {
		padding: 16px;
	}

	.listing-empty h2 {
		margin: 0;
		font-size: clamp(2rem, 4vw, 3rem);
		font-family: var(--font-serif);
		font-weight: 400;
		line-height: 1;
	}

	.listing-empty-links {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 12px;
		margin-top: 16px;
	}

	.listing-empty-link {
		display: flex;
		flex-direction: column;
		gap: 6px;
		padding: 12px;
		border-radius: 16px;
		background: rgba(0, 0, 0, 0.22);
		border: 1px solid rgba(255, 255, 255, 0.1);
	}

	.listing-empty-link span {
		color: var(--muted);
		font-size: 0.92rem;
	}

	.listing-hero,
	.listing-metrics,
	.listing-panel {
		padding: 16px;
	}

	.listing-hero-main {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 12px;
		margin-top: 14px;
		flex-wrap: wrap;
	}

	.listing-hero h1 {
		margin: 12px 0 0;
		font-family: var(--font-serif);
		font-size: clamp(2.8rem, 5vw, 4.5rem);
		font-weight: 400;
		line-height: 0.96;
		letter-spacing: 0.01em;
		max-width: 10ch;
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
	}

	.listing-tags,
	.alias-list {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
		margin-top: 16px;
	}

	.key-metrics,
	.listing-panels {
		display: grid;
		gap: 16px;
	}

	.key-metrics {
		grid-template-columns: 1fr;
		margin-top: 14px;
	}

	.metric-card,
	.detail-grid div {
		padding: 12px;
		border-radius: 16px;
		background: rgba(0, 0, 0, 0.22);
		border: 1px solid rgba(255, 255, 255, 0.1);
	}

	.metric-card span,
	.metric-card strong {
		display: block;
	}

	.metric-card strong {
		margin-top: 6px;
		font-size: 1.15rem;
	}

	.listing-notes {
		margin: 14px 0 0;
		line-height: 1.65;
	}

	.listing-panels {
		grid-template-columns: repeat(3, minmax(0, 1fr));
	}

	.detail-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 12px;
		margin-top: 14px;
