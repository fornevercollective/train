---
import Layout from '../../layouts/Layout.astro';
import BloombergLiveRelay from '../../components/BloombergLiveRelay.astro';
import {
	tocItems,
	researchCards,
	changelogEntries,
	captionSeeds,
} from '../../lib/live-captions-desk';

const bloombergRelayStartCommand = 'cd "/Volumes/qbitOS/00.dev/cursor/train" && python3 server.py';
const published = new Intl.DateTimeFormat('en-US', {
	month: 'long',
	day: 'numeric',
	year: 'numeric',
}).format(new Date());
---

<Layout
	title="Live captions desk | Erika Train"
	description="Caption-aware working paper, evidence log, and Bloomberg relay — educational desk surface for the Erika catalog."
	pageClass="page-live-captions"
	eyebrow="Research desk"
	subtitle="Rebuild a fact-style brief from captions and conversation, then cross-check themes against the static market catalog."
>
	<section class="container live-captions-shell">
		<article class="live-captions-doc">
			<header class="live-captions-hero">
				<p class="live-captions-kicker">Train · Live relay</p>
				<h1 class="live-captions-title">A technical guide to the live captions desk</h1>
				<p class="live-captions-meta muted">{published}</p>
				<p class="live-captions-lead muted">
					This page is for <strong>education and research layout</strong> only — not investment advice. It borrows
					structural patterns from long-form product guides and research portals (clear sections, dated evidence, and
					explorable cards) while keeping execution and compliance outside this static site.
				</p>
			</header>

			<div class="live-captions-layout">
				<nav class="live-captions-toc" aria-labelledby="live-captions-toc-heading">
					<p id="live-captions-toc-heading" class="live-captions-toc-title">On this page</p>
					<ul class="live-captions-toc-list">
						{
							tocItems.map((item) => (
								<li>
									<a href={`#${item.id}`}>{item.label}</a>
								</li>
							))
						}
					</ul>
				</nav>

				<div class="live-captions-main">
					<section class="live-captions-section" id="live-captions-how" aria-labelledby="live-captions-how-h">
						<h2 id="live-captions-how-h">How the desk works</h2>
						<p>
							Most chat tools run linearly: you type, the model answers. This desk is designed more like a{' '}
							<strong>review workflow</strong>: captions arrive as a noisy primary source, the side chat proposes
							structure, and you reorganize claims before anything is treated as “settled.”
						</p>
						<p>
							When a parameter is missing — which venue, which contract month, which session window — the UI should
							ask before promoting text to the evidence log. That mirrors how agent-style guides treat intent: narrow
							the trigger, then lock the action.
						</p>
					</section>

					<section
						class="live-captions-section"
						id="live-captions-explorables"
						aria-labelledby="live-captions-explorables-h"
					>
						<h2 id="live-captions-explorables-h">Interpretability &amp; data</h2>
						<p class="muted">
							Explorable explainers and HCI research are useful references when you label caption clusters or explain
							why a theme fired. External links open in a new tab.
						</p>
						<div class="live-captions-cardGrid">
							{
								researchCards.map((card) => (
									<a
										class="live-captions-card"
										href={card.href}
										target={card.external ? '_blank' : undefined}
										rel={card.external ? 'noopener noreferrer' : undefined}
									>
										<h3 class="live-captions-cardTitle">{card.title}</h3>
										<p class="live-captions-cardBlurb muted">{card.blurb}</p>
										<ul class="live-captions-cardTags" aria-label="Topics">
											{card.tags.map((t) => (
												<li>{t}</li>
											))}
										</ul>
									</a>
								))
							}
						</div>
					</section>

					<section class="live-captions-section" id="live-captions-paper" aria-labelledby="live-captions-paper-h">
						<h2 id="live-captions-paper-h">Working paper from captions</h2>
						<p>
							Below is a <strong>stub digest</strong>: the browser groups seed caption lines by theme. When the relay
							writes JSON (captions + chat turns), replace the script source with that payload and re-render the same
							sections — abstract, claims, and catalog cross-check.
						</p>
						<div class="live-captions-paper">
							<h3 class="live-captions-paper-h3">Abstract</h3>
							<p id="caption-digest-abstract" class="muted">
								Loading caption-derived summary…
							</p>
							<h3 class="live-captions-paper-h3">Claims under review</h3>
							<div id="caption-digest-body" class="live-captions-digestMount" />
							<h3 class="live-captions-paper-h3">Catalog cross-check</h3>
							<p class="muted">
								Map each theme to symbols present in the Erika directory (metals: <code>GC=F</code>,{' '}
								<code>SI=F</code>; benchmarks: <code>ES=F</code>, <code>QQQ</code>; majors:{' '}
								<code>BTC-USD</code>). Coverage rows on the Directory tab remain the ground truth for what is actually
								in <code>catalog.json</code>.
							</p>
						</div>
					</section>

					<section
						class="live-captions-section"
						id="live-captions-changelog"
						aria-labelledby="live-captions-changelog-h"
					>
						<h2 id="live-captions-changelog-h">Evidence log</h2>
						<p class="muted">Dated deltas for the desk itself — same rhythm as an API changelog.</p>
						<ol class="live-captions-changelog">
							{
								changelogEntries.map((entry) => (
									<li class="live-captions-changelog-item">
										<time class="live-captions-changelog-date" datetime={entry.date}>
											{entry.date}
										</time>
										<div class="live-captions-changelog-body">
											<h3 class="live-captions-changelog-title">{entry.title}</h3>
											<p>{entry.body}</p>
										</div>
									</li>
								))
							}
						</ol>
					</section>

					<section class="live-captions-section" id="live-captions-apis" aria-labelledby="live-captions-apis-h">
						<h2 id="live-captions-apis-h">External references</h2>
						<p class="muted">
							Design inspiration only — no affiliation. Public’s Agents guide and API changelog; Google PAIR’s home,
							research index, and Explorables.
						</p>
						<ul class="live-captions-linkList muted">
							<li><a href="https://public.com/ai-agents/how-it-works" target="_blank" rel="noopener noreferrer">public.com/ai-agents/how-it-works</a></li>
							<li><a href="https://public.com/api/docs/changelog" target="_blank" rel="noopener noreferrer">public.com/api/docs/changelog</a></li>
							<li><a href="https://pair.withgoogle.com/" target="_blank" rel="noopener noreferrer">pair.withgoogle.com</a></li>
							<li><a href="https://pair.withgoogle.com/research/" target="_blank" rel="noopener noreferrer">pair.withgoogle.com/research/</a></li>
							<li><a href="https://pair.withgoogle.com/explorables/" target="_blank" rel="noopener noreferrer">pair.withgoogle.com/explorables/</a></li>
						</ul>
					</section>
				</div>
			</div>
		</article>

		<BloombergLiveRelay bloombergRelayStartCommand={bloombergRelayStartCommand} />
	</section>
</Layout>

<script define:vars={{ captionSeeds }}>
	(() => {
		const abstractEl = document.getElementById('caption-digest-abstract');
		const bodyEl = document.getElementById('caption-digest-body');
		if (!abstractEl || !bodyEl) return;
		const themes = [...new Set(captionSeeds.map((c) => c.theme))];
		abstractEl.textContent = `This session’s working themes: ${themes.join(', ')}. Claims are reconstructed from ${captionSeeds.length} seed caption lines pending live relay JSON.`;
		const items = captionSeeds
			.map(
				(s) =>
					`<li><span class="live-captions-claim-theme">${s.theme}</span><span class="live-captions-claim-text">${s.text}</span></li>`,
			)
			.join('');
		bodyEl.innerHTML = `<ol class="live-captions-claim-list">${items}</ol>`;
	})();
</script>

<style>
	.live-captions-shell {
		display: flex;
		flex-direction: column;
		gap: 28px;
		padding-bottom: 48px;
	}

	.live-captions-doc {
		max-width: 920px;
		margin: 0 auto;
	}

	.live-captions-hero {
		padding-bottom: 8px;
		border-bottom: 1px solid rgba(255, 255, 255, 0.08);
		margin-bottom: 24px;
	}

	.live-captions-kicker {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		margin: 0 0 10px;
		color: var(--accent);
	}

	.live-captions-title {
		margin: 0;
		font-family: var(--font-serif);
		font-size: clamp(2rem, 4vw, 2.75rem);
		font-weight: 400;
		line-height: 1.1;
		letter-spacing: 0.01em;
		max-width: 22ch;
	}

	.live-captions-meta {
		margin: 10px 0 0;
		font-size: 0.92rem;
	}

	.live-captions-lead {
		margin: 18px 0 0;
		max-width: 48rem;
		font-size: 1.02rem;
		line-height: 1.65;
	}

	.live-captions-layout {
		display: grid;
		grid-template-columns: minmax(200px, 240px) minmax(0, 1fr);
		gap: 32px;
		align-items: start;
	}

	.live-captions-toc {
		position: sticky;
		top: 1.25rem;
		padding: 14px 16px;
		border-radius: 14px;
		background: rgba(0, 0, 0, 0.2);
		border: 1px solid rgba(255, 255, 255, 0.08);
	}

	.live-captions-toc-title {
		margin: 0 0 10px;
		font-size: 0.78rem;
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--muted);
	}

	.live-captions-toc-list {
		margin: 0;
		padding: 0;
		list-style: none;
		display: flex;
		flex-direction: column;
		gap: 8px;
		font-size: 0.9rem;
	}

	.live-captions-toc-list a {
		color: rgba(200, 218, 255, 0.92);
		text-decoration: none;
		border-bottom: 1px solid transparent;
	}

	.live-captions-toc-list a:hover {
		border-bottom-color: rgba(120, 170, 255, 0.45);
	}

	.live-captions-main {
		min-width: 0;
	}

	.live-captions-section {
		margin-bottom: 2.5rem;
	}

	.live-captions-section h2 {
		margin: 0 0 14px;
		font-family: var(--font-serif);
		font-size: 1.45rem;
		font-weight: 500;
		letter-spacing: 0.01em;
	}

	.live-captions-section p {
		margin: 0 0 12px;
		line-height: 1.65;
		max-width: 46rem;
	}

	.live-captions-cardGrid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
		gap: 14px;
		margin-top: 16px;
	}

	.live-captions-card {
		display: flex;
		flex-direction: column;
		gap: 8px;
		padding: 16px;
		border-radius: 16px;
		background: rgba(0, 0, 0, 0.22);
		border: 1px solid rgba(255, 255, 255, 0.1);
		text-decoration: none;
		color: inherit;
		transition: border-color 0.15s ease, background 0.15s ease;
	}

	.live-captions-card:hover {
		border-color: rgba(120, 170, 255, 0.35);
		background: rgba(12, 20, 40, 0.45);
	}

	.live-captions-cardTitle {
		margin: 0;
		font-size: 1.05rem;
		font-weight: 600;
		line-height: 1.25;
	}

	.live-captions-cardBlurb {
		margin: 0;
		font-size: 0.88rem;
		line-height: 1.55;
		flex: 1;
	}

	.live-captions-cardTags {
		margin: 4px 0 0;
		padding: 0;
		list-style: none;
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
	}

	.live-captions-cardTags li {
		font-size: 0.68rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		padding: 4px 8px;
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.06);
		color: rgba(186, 206, 240, 0.9);
	}

	.live-captions-paper {
		margin-top: 14px;
		padding: 18px;
		border-radius: 16px;
		background: rgba(0, 0, 0, 0.18);
		border: 1px solid rgba(255, 255, 255, 0.08);
	}

	.live-captions-paper-h3 {
		margin: 18px 0 8px;
		font-size: 1rem;
		font-weight: 600;
	}

	.live-captions-paper-h3:first-child {
		margin-top: 0;
	}

	.live-captions-digestMount {
		min-height: 2rem;
	}

	.live-captions-claim-list {
		margin: 0;
		padding-left: 1.2rem;
		line-height: 1.6;
	}

	.live-captions-claim-list li {
		margin-bottom: 10px;
	}

	.live-captions-claim-theme {
		display: inline-block;
		min-width: 5.5rem;
		font-family: var(--font-mono);
		font-size: 0.72rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--accent);
		margin-right: 8px;
	}

	.live-captions-changelog {
		margin: 16px 0 0;
		padding: 0;
		list-style: none;
		display: flex;
		flex-direction: column;
		gap: 0;
	}

	.live-captions-changelog-item {
		display: grid;
		grid-template-columns: 120px minmax(0, 1fr);
		gap: 16px;
		padding: 16px 0;
		border-bottom: 1px solid rgba(255, 255, 255, 0.06);
	}

	.live-captions-changelog-item:last-child {
		border-bottom: 0;
	}

	.live-captions-changelog-date {
		font-family: var(--font-mono);
		font-size: 0.82rem;
		color: var(--muted);
	}

	.live-captions-changelog-title {
		margin: 0 0 6px;
		font-size: 1.02rem;
		font-weight: 600;
	}

	.live-captions-changelog-body p {
		margin: 0;
		font-size: 0.94rem;
		color: var(--muted);
	}

	.live-captions-linkList {
		margin: 12px 0 0;
		padding-left: 1.2rem;
		line-height: 1.8;
	}

	.live-captions-linkList a {
		color: rgba(140, 190, 255, 0.95);
	}

	@media (max-width: 900px) {
		.live-captions-layout {
			grid-template-columns: 1fr;
		}

		.live-captions-toc {
			position: static;
		}

		.live-captions-changelog-item {
			grid-template-columns: 1fr;
			gap: 6px;
		}
	}
</style>
