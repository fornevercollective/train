---
import Layout from '../layouts/Layout.astro';
import summary from '../generated/catalog-meta.json';

const topCountries = summary.topCountries.slice(0, 8);
const topExchanges = summary.topExchanges.slice(0, 8);
const topSectors = summary.topSectors.filter((item) => item.name !== '(none)').slice(0, 8);
const featuredListings = summary.featuredListings.slice(0, 6);
const quickLinks = [
	{ label: 'Latency topology', href: '#topology' },
	{ label: 'Live pipeline', href: '#live-pipeline' },
	{ label: 'Complete date coverage', href: '?coverage=complete#explore' },
	{ label: 'ETFs in the US', href: '?type=ETF&country=United%20States#explore' },
	{ label: 'NASDAQ listings', href: '?exchange=NASDAQ#explore' },
	{ label: 'Healthcare stocks', href: '?type=Stock&sector=Health%20Care#explore' },
];
const priorityGroups = [
	{
		title: 'Major metals',
		kicker: 'Highest-priority market block',
		description:
			'These are the strongest, most complete histories visible in the local Erika lake and should sit above the generic listing browse flow.',
		items: [
			{ name: 'Gold', symbol: 'GC=F', coverage: '2000-08 -> 2026-04', rows: '6,440 rows', status: 'strong' },
			{ name: 'Silver', symbol: 'SI=F', coverage: '2000-08 -> 2026-04', rows: '6,442 rows', status: 'strong' },
			{ name: 'Platinum', symbol: 'PL=F', coverage: '1997-10 -> 2026-04', rows: '6,468 rows', status: 'strong' },
			{ name: 'Palladium', symbol: 'PA=F', coverage: '1998-09 -> 2026-04', rows: '6,479 rows', status: 'strong' },
			{ name: 'Copper', symbol: 'HG=F', coverage: '2000-08 -> 2026-04', rows: '6,445 rows', status: 'strong' },
			{ name: 'Aluminum', symbol: 'ALI=F', coverage: '2014-05 -> 2026-04', rows: '2,978 rows', status: 'medium' },
		],
	},
	{
		title: 'Global benchmarks and futures',
		kicker: 'Macro proxy set',
		description:
			'The preset exists for major indexes and futures, but the local lake is strongest right now on futures and ETF proxies rather than every benchmark index parquet.',
		items: [
			{ name: 'E-mini S&P 500', symbol: 'ES=F', coverage: '2025-04 -> 2026-04', rows: '253 rows', status: 'medium' },
			{ name: 'Nasdaq 100 ETF', symbol: 'QQQ', coverage: '2021-04 -> 2026-04', rows: '1,255 rows', status: 'good' },
			{ name: 'S&P 500 index', symbol: '^GSPC', coverage: 'Not present as local parquet', rows: 'Use preset / refresh ingest', status: 'missing' },
		],
	},
	{
		title: 'Major crypto',
		kicker: 'Liquid digital majors',
		description:
			'Crypto is present and current, with Bitcoin available locally and the README preset covering the broader major-crypto basket.',
		items: [
			{ name: 'Bitcoin', symbol: 'BTC-USD', coverage: '2021-04 -> 2026-04', rows: '1,827 rows', status: 'good' },
			{ name: 'Ethereum / majors', symbol: 'major-crypto', coverage: 'Preset referenced in Erika README', rows: '10-symbol basket', status: 'good' },
		],
	},
	{
		title: 'AI / LLM market names',
		kicker: 'Names referenced in the presets',
		description:
			'These are the headline equity names from the ai-llm-boom preset. Coverage is uneven locally, so they are useful as a prominence layer but not all are equally complete.',
		items: [
			{ name: 'Microsoft', symbol: 'MSFT', coverage: '2021-04 -> 2026-04', rows: '1,255 rows', status: 'good' },
			{ name: 'NVIDIA', symbol: 'NVDA', coverage: '2021-04 -> 2026-04', rows: '1,255 rows', status: 'good' },
			{ name: 'Apple', symbol: 'AAPL', coverage: '2026-03 -> 2026-04', rows: '22 rows', status: 'limited' },
		],
	},
];
const topologyRoutes = [
	{
		venue: 'CME / Aurora futures',
		benchmarks: 'ES, NQ, RTY, YM, GC, SI, HG',
		pop: 'Aurora I / CH2',
		relay: 'Aurora edge -> Chicago metro relay -> NY4/NY5 fanout',
		hops: '1 in-cage; 3-5 metro; 6-9 to NY metro',
		latency: 'sub-0.1 ms local; 0.3-0.9 ms Chicago metro; 8-10 ms one-way to NJ',
		speed: '10/25 GbE capture, 25/100 GbE relay',
		note: 'Best home for index futures, rates, and metals when futures lead price discovery.',
	},
	{
		venue: 'NASDAQ / NYSE / NYSE Arca / OPRA',
		benchmarks: 'QQQ, SPY, cash equities, ETFs, options fanout',
		pop: 'Carteret / Mahwah / Secaucus / NY4',
		relay: 'Venue edge -> New Jersey relay spine -> Chicago and London distribution',
		hops: '1-2 local; 3-6 metro; 6-10 to Chicago',
		latency: 'sub-0.15 ms local; 0.2-1.1 ms NJ metro; 8-10 ms one-way to Chicago',
		speed: '10/25 GbE edge, 25/100 GbE relay',
		note: 'Use this path for ETF NAV, cash open/close logic, and US equity index arbitration.',
	},
	{
		venue: 'LSE / ICE Europe / Euronext',
		benchmarks: 'FTSE, ICE energy, STOXX-linked flows',
		pop: 'LD4 / Basildon / Slough',
		relay: 'London metro edge -> LD4 relay -> Frankfurt and NY distribution',
		hops: '1-2 local; 3-6 metro; 5-7 to Frankfurt',
		latency: 'sub-0.15 ms local; 0.3-1.2 ms London metro; 3-5 ms one-way to Frankfurt',
		speed: '10/25 GbE capture, 25/100 GbE backbone',
		note: 'London is the clean aggregation point for European cash, futures, and energy venues.',
	},
	{
		venue: 'Deutsche Boerse / Eurex',
		benchmarks: 'DAX, Euro Stoxx, Bund, Bobl, Schatz',
		pop: 'FR2 / FR5',
		relay: 'Frankfurt edge -> Frankfurt relay -> LD4 and NY fanout',
		hops: '1-2 local; 3-5 metro; 5-7 to London',
		latency: 'sub-0.12 ms local; 0.2-0.8 ms metro; 3-5 ms one-way to London',
		speed: '10/25 GbE edge, 25/100 GbE relay',
		note: 'Keep Eurex-leading macro logic in Frankfurt if rates or DAX futures are your trigger feed.',
	},
	{
		venue: 'JPX / OSE',
		benchmarks: 'Nikkei 225, TOPIX, JGB-linked flows',
		pop: 'TY3 / Tokyo metro',
		relay: 'Tokyo edge -> Tokyo relay -> Singapore and Hong Kong regional fanout',
		hops: '1-2 local; 3-5 metro; 7-10 regional backbone',
		latency: 'sub-0.12 ms local; 0.2-0.9 ms metro; 35-70 ms to SG/HK depending path',
		speed: '10/25 GbE edge, 25 GbE regional relay',
		note: 'APAC strategies should stay regional; sending the first decision loop to the US is too slow.',
	},
	{
		venue: 'HKEX / SGX',
		benchmarks: 'Hang Seng, CNH, SGX index and derivatives flows',
		pop: 'HK1 / HK3 / SG1',
		relay: 'Local metro edge -> Hong Kong or Singapore relay -> Tokyo and London distribution',
		hops: '1-2 local; 4-8 regional; 8-12 inter-region',
		latency: 'sub-0.15 ms local; 0.3-1.0 ms metro; 30-40 ms HK<->SG',
		speed: '10/25 GbE edge, 25/100 GbE relay uplinks',
		note: 'Pair Hong Kong and Singapore to absorb regional outages and keep APAC fanout tight.',
	},
];
const livePipelineStages = [
	{
		stage: 'Venue ingress',
		primary: 'Primary exchange handoff / multicast plant / direct cross-connect',
		redundant: 'Secondary venue handoff or alternate A/B line card / network path',
		data: 'Raw packets, sequence numbers, heartbeats, venue control messages',
		junction: 'Exchange demarc -> cage switch -> capture NIC',
		bottleneck: 'Cross-connect oversubscription, bursty open/close traffic, sequence gaps at the handoff edge',
		stack: 'Cross-connects, L1/L2 switching, UDP multicast or direct TCP/ITCH-style feeds, optical diversity',
	},
	{
		stage: 'Lossless capture',
		primary: 'Hot capture host pinned to the primary feed leg',
		redundant: 'Parallel hot-capture host or standby NIC path with the same session view',
		data: 'Nanosecond timestamps, packet payloads, gap alerts, drop counters',
		junction: 'NIC -> kernel bypass / capture process -> write-ahead queue',
		bottleneck: 'RX ring overflow, interrupt storms, NUMA mismatch, disk flush latency during bursts',
		stack: 'PTP, hardware timestamping, RSS/IRQ pinning, DPDK/AF_XDP-class capture, NVMe journals',
	},
	{
		stage: 'Decode and normalize',
		primary: 'Venue parser and schema-normalization pipeline',
		redundant: 'Secondary parser workers fed from mirrored capture or replay queue',
		data: 'Trades, MBO/MBP books, instrument defs, status events, normalized records',
		junction: 'Capture queue -> parser workers -> normalized event bus',
		bottleneck: 'Single-thread parser saturation, schema edge cases, slow gap-fill replay after reconnect',
		stack: 'Feed handlers, schema codecs, DBN-style binary encoding, lock-free queues, replayable logs',
	},
	{
		stage: 'Gap fill and reconciliation',
		primary: 'Real-time sequencer and gap-fill service',
		redundant: 'Replay path from mirrored capture store or alternate venue session',
		data: 'Recovery requests, retransmits, sequence windows, continuity markers',
		junction: 'Normalizer -> sequencer -> recovery service',
		bottleneck: 'Recovery storms during venue instability and replay contention against live flow',
		stack: 'Sequence tracking, retransmit requests, bounded in-memory buffers, deterministic replay',
	},
	{
		stage: 'Regional relay mesh',
		primary: 'Chicago, New Jersey, London, Frankfurt, Tokyo, Singapore active fanout',
		redundant: 'Cross-region mirror relay or same-region hot standby',
		data: 'Normalized live stream, partial depth, full depth, trades, metadata side channels',
		junction: 'Metro relay spine -> regional backbone -> local fanout node',
		bottleneck: 'East-west congestion, route asymmetry, fanout amplification when many clients subscribe at once',
		stack: '25/100 GbE leaf-spine, ECMP, low-jitter metro circuits, internal pub-sub / stream fabric',
	},
	{
		stage: 'Hot cache and serving plane',
		primary: 'In-memory live cache and session gateway',
		redundant: 'Replica cache and second gateway pool in the same or adjacent region',
		data: 'Latest books, subscription state, session tokens, entitlement-aware stream state',
		junction: 'Relay -> cache -> auth/session gateway -> outbound stream',
		bottleneck: 'Cache stampede on reconnect, gateway fanout pressure, entitlement checks in the hot path',
		stack: 'In-memory caches, session services, load balancers, service discovery, TLS termination off hot path where possible',
	},
	{
		stage: 'Historical persistence',
		primary: 'Append-only live archive and object-store landing zone',
		redundant: 'Mirrored object storage / second-region archive',
		data: 'Raw PCAP-class capture, normalized DBN records, catalog metadata, audit trail',
		junction: 'Capture + normalized stream -> archive writer -> object store / cold tier',
		bottleneck: 'Write amplification, checksum/recompression overhead, slow cold-tier recalls during replay',
		stack: 'NVMe staging, object storage, immutable partitions, compression, checksum verification',
	},
	{
		stage: 'Client delivery',
		primary: 'Live streaming endpoint close to the consuming strategy',
		redundant: 'Secondary endpoint / region plus replay bootstrap path',
		data: 'Subscription responses, normalized frames, heartbeat, backpressure / reconnect control',
		junction: 'Gateway -> internet/private link -> strategy node',
		bottleneck: 'Last-mile jitter, client-side backpressure, TLS/session churn, slow consumer queues',
		stack: 'TCP/WebSocket/streaming APIs, client libraries, backpressure handling, reconnect and resume logic',
	},
];
const architectureJunctions = [
	{
		name: 'Venue demarcation',
		primary: 'Venue A handoff -> cage switch -> primary capture NIC',
		backup: 'Venue B handoff -> alternate ToR -> redundant capture NIC',
		choke: 'Optics, ToR oversubscription, or microburst loss at the handoff edge',
		watch: 'Drops, burst counters, asymmetric sequence drift',
	},
	{
		name: 'Capture to parser handoff',
		primary: 'Hot capture host -> write-ahead queue -> parser shard',
		backup: 'Mirrored journal -> standby parser worker',
		choke: 'Queue depth and parser lag during open/close bursts',
		watch: 'Backlog, gap-fill requests, replay catch-up time',
	},
	{
		name: 'Relay fanout spine',
		primary: 'Metro relay -> regional spine -> local fanout cache',
		backup: 'Secondary relay region -> mirrored fanout node',
		choke: 'Cross-region congestion and too many subscribers on one spine node',
		watch: 'Jitter, egress imbalance, reconnect fanout spikes',
	},
	{
		name: 'Gateway and entitlement plane',
		primary: 'Hot cache -> session gateway -> client stream',
		backup: 'Replica cache -> standby gateway pool',
		choke: 'Inline auth/entitlement work and reconnect pressure',
		watch: 'Connect latency, CPU hotspots, slow session creation',
	},
	{
		name: 'Archive and replay',
		primary: 'Live journal -> archive writer -> object store',
		backup: 'Second-region archive -> isolated replay path',
		choke: 'Replay I/O contention against live writes',
		watch: 'NVMe saturation, replay start delay, live-write jitter',
	},
];
const techStackLayers = [
	{
		layer: 'Time and clocking',
		tools: 'PTP, hardware NIC timestamps, disciplined grandmaster, monotonic local clocks',
		why: 'Required to compare venue ingress, relay transit, and client receive times without lying to yourself.',
	},
	{
		layer: 'Network fabric',
		tools: 'Diverse cross-connects, low-latency switches, ECMP, 25/100 GbE spine, metro wavelength diversity',
		why: 'This is where primary/redundant paths stop being theoretical and become physically separate.',
	},
	{
		layer: 'Capture and feed handling',
		tools: 'Kernel-bypass capture, pinned cores, lock-free queues, feed handlers, sequencers, gap detectors',
		why: 'The first place burst traffic and venue pathologies show up.',
	},
	{
		layer: 'Normalization and stream fabric',
		tools: 'Binary schema codecs, replayable logs, in-memory buses, shard-aware parser workers',
		why: 'Normalizing many venue dialects without creating a single chokepoint is the core systems problem.',
	},
	{
		layer: 'Storage and replay',
		tools: 'NVMe journals, immutable partitions, object storage, compression, checksum validation',
		why: 'Live and historical paths should share truth, not share contention.',
	},
	{
		layer: 'Serving and client edge',
		tools: 'Session gateways, load balancers, auth cache, streaming APIs, client resume/backpressure logic',
		why: 'Most visible outages come from connect/reconnect pressure rather than raw market data loss.',
	},
];
const relayPoints = [
	{
		name: 'Aurora / Chicago relay',
		role: 'Primary futures and macro relay',
		ingress: 'Aurora capture',
		spine: 'Chicago metro core',
		egress: 'US macro + metals fanout',
		backup: 'NJ mirror + replay path',
		choke: 'Open/close burst fanout and gap-fill overlap',
	},
	{
		name: 'New Jersey / NY4-NY5 relay',
		role: 'US equities, ETFs, and options aggregation',
		ingress: 'Mahwah / Carteret / Secaucus',
		spine: 'NJ metro relay',
		egress: 'Cash equity + ETF + options fanout',
		backup: 'Chicago cache + second gateway pool',
		choke: 'Cash open/close microbursts and reconnect storms',
	},
	{
		name: 'London / LD4 relay',
		role: 'European core relay',
		ingress: 'LSE / ICE / Euronext edge',
		spine: 'LD4 metro core',
		egress: 'EU fanout + transatlantic handoff',
		backup: 'Frankfurt hot standby',
		choke: 'Metro jitter before long-haul replication',
	},
	{
		name: 'Frankfurt relay',
		role: 'Eurex and Xetra recovery / primary node',
		ingress: 'Eurex / Xetra edge',
		spine: 'Frankfurt relay core',
		egress: 'Rates + DAX + EU standby fanout',
		backup: 'London mirror relay',
		choke: 'Recovery traffic colliding with live macro flow',
	},
	{
		name: 'Tokyo + Singapore pair',
		role: 'APAC relay mesh',
		ingress: 'TY3 / HK / SG venue edge',
		spine: 'Regional APAC mesh',
		egress: 'JPX + HKEX + SGX regional fanout',
		backup: 'Tokyo<->Singapore mutual failover',
		choke: 'Regional path asymmetry and outage reroute bursts',
	},
];
const systemProfiles = [
	{
		name: 'Capture / exchange edge',
		cpu: '16-32 high-clock cores',
		memory: '64-128 GB ECC',
		nic: 'Dual 25 GbE or single 100 GbE with hardware timestamps',
		storage: '2-4 TB NVMe scratch plus mirrored archival path',
		fit: 'Raw packet capture, gap detection, feed recording, and immediate handoff to relay.',
	},
	{
		name: 'Relay / normalization node',
		cpu: '24-48 cores',
		memory: '128-256 GB ECC',
		nic: 'Dual 25/100 GbE',
		storage: '4-8 TB NVMe RAID1 or RAID10',
		fit: 'Protocol normalization, gap-fill, compression, replay, and fanout to multiple consumers.',
	},
	{
		name: 'Strategy / hot-path node',
		cpu: '8-24 high-frequency cores',
		memory: '64-128 GB ECC',
		nic: '10/25 GbE with RSS and IRQ pinning',
		storage: '2-4 TB NVMe local cache',
		fit: 'Feature calc, signal generation, cache-resident books, and order-routing adjacency.',
	},
	{
		name: 'Research / replay node',
		cpu: '32-64 cores',
		memory: '128-512 GB ECC',
		nic: '10/25 GbE',
		storage: '8-32 TB NVMe or U.2 array',
		fit: 'Historical ingest, backtests, full-session replay, and derived dataset generation.',
	},
];
const fastPathChecklist = [
	'Linux 6.x LTS with tuned IRQ affinity, CPU isolation, and unnecessary C-states disabled.',
	'PTP or a tightly disciplined clock so exchange timestamps, relay stamps, and strategy clocks line up.',
	'NICs with hardware timestamping, deep RX rings, and driver settings reviewed for burst handling.',
	'NVMe-first storage for capture and replay; avoid SATA or network filesystems on the ingestion hot path.',
	'25 GbE east-west links as the minimum serious relay target; 100 GbE where multi-venue fanout is shared.',
];
---

<Layout
	title="Erika Market Directory"
	description="Search 60k+ global stock and ETF listings from the Erika dataset in a fast GitHub Pages-ready directory."
	pageClass="page-home"
	eyebrow="Directory view"
	subtitle="Static listing intelligence with search, filters, and profile pages."
>
	<section class="container home-shell">
		<header class="header">
			<div class="disclaimer" role="note" aria-label="Directory disclaimer">
				<p class="disclaimer__text">
					This directory is a static metadata browser for research and educational use. It is
					not an offer to buy or sell securities, and it does not replace financial, legal, or
					tax advice.
				</p>
			</div>
		</header>

		<div class="home-topBand">
			<article class="card home-hero">
				<div class="tileTop">
					<div>
						<div class="ticker">Directory search</div>
						<h1>Explore Erika world Market data.</h1>
						<p class="hero-lead">
							A GitHub Pages-ready catalog for {summary.totalSymbols.toLocaleString()} global
							listings across stocks and ETFs, with searchable metadata, exchange filters, and
							date-coverage signals.
						</p>
					</div>
				</div>
				<div class="hero-actions">
					<a class="button" href="#explore">Browse the directory</a>
					{
						featuredListings[0] && (
							<a
								class="button-secondary"
								href={`listing/?id=${encodeURIComponent(featuredListings[0].id)}`}
							>
								Open featured profile
							</a>
						)
					}
					<a class="button-secondary" href="raw/">Open raw data page</a>
				</div>
				<div class="quick-links">
					{
						quickLinks.map((link) => (
							<a class="badge muted" href={link.href}>
								{link.label}
							</a>
						))
					}
				</div>
			</article>

			<aside class="card home-stats">
				<div class="tileTop">
					<div>
						<div class="ticker">Coverage snapshot</div>
						<div class="name">High-level shape of the Erika listing universe.</div>
					</div>
				</div>
				<div class="stats-grid">
					<div class="stat-block">
						<span class="muted">Listings</span>
						<strong>{summary.totalSymbols.toLocaleString()}</strong>
					</div>
					<div class="stat-block">
						<span class="muted">Countries</span>
						<strong>{summary.uniqueCountries.toLocaleString()}</strong>
					</div>
					<div class="stat-block">
						<span class="muted">Exchanges</span>
						<strong>{summary.uniqueExchanges.toLocaleString()}</strong>
					</div>
					<div class="stat-block">
						<span class="muted">Company dates</span>
						<strong>{summary.withCompanyCreation.toLocaleString()}</strong>
					</div>
					<div class="stat-block">
						<span class="muted">IPO dates</span>
						<strong>{summary.withIpoCreation.toLocaleString()}</strong>
					</div>
					<div class="stat-block">
						<span class="muted">Complete coverage</span>
						<strong>{summary.dateCoverage.complete.toLocaleString()}</strong>
					</div>
				</div>
				<div class="stats-foot">
					<span class="badge success">
						{summary.securityTypes[0]?.name}: {summary.securityTypes[0]?.count.toLocaleString()}
					</span>
					<span class="badge muted">
						{summary.securityTypes[1]?.name}: {summary.securityTypes[1]?.count.toLocaleString()}
					</span>
				</div>
			</aside>
		</div>

		<section class="facet-strip">
			<div class="card facet-card">
				<div class="tileTop">
					<div>
						<div class="ticker">Top countries</div>
						<div class="name">Most represented jurisdictions in the dataset.</div>
					</div>
				</div>
				<div class="facet-list">
					{
						topCountries.map((item) => (
							<a class="badge muted" href={`?country=${encodeURIComponent(item.name)}#explore`}>
								{item.name} · {item.count.toLocaleString()}
							</a>
						))
					}
				</div>
			</div>

			<div class="card facet-card">
				<div class="tileTop">
					<div>
						<div class="ticker">Top exchanges</div>
						<div class="name">Quick pivots into the busiest listing venues.</div>
					</div>
				</div>
				<div class="facet-list">
					{
						topExchanges.map((item) => (
							<a class="badge muted" href={`?exchange=${encodeURIComponent(item.name)}#explore`}>
								{item.name} · {item.count.toLocaleString()}
							</a>
						))
					}
				</div>
			</div>

			<div class="card facet-card">
				<div class="tileTop">
					<div>
						<div class="ticker">Top sectors</div>
						<div class="name">Fast routes into sector-based slices of the directory.</div>
					</div>
				</div>
				<div class="facet-list">
					{
						topSectors.map((item) => (
							<a class="badge muted" href={`?sector=${encodeURIComponent(item.name)}#explore`}>
								{item.name} · {item.count.toLocaleString()}
							</a>
						))
					}
				</div>
			</div>
		</section>

		<section class="section-card card priority-section">
			<div class="section-heading">
				<div>
					<div class="kicker">Priority markets</div>
					<h2>Put metals and the key market presets up front</h2>
					<p>
						The Erika lake is updated through 2026-04-30, but the time-series coverage is not
						uniform across all symbols. Metals are the strongest local histories, so they now
						get a dedicated top-level block instead of being buried below the listing directory.
					</p>
				</div>
			</div>

			<div class="priority-grid">
				{
					priorityGroups.map((group) => (
						<article class="priority-card card">
							<div class="tileTop">
								<div>
									<div class="ticker">{group.kicker}</div>
									<h3>{group.title}</h3>
									<p class="priority-copy">{group.description}</p>
								</div>
							</div>
							<div class="priority-items">
								{
									group.items.map((item) => (
										<div class="priority-item">
											<div class="priority-item-head">
												<div>
													<strong>{item.name}</strong>
													<p>{item.symbol}</p>
												</div>
												<span
													class={`badge ${
														item.status === 'strong' || item.status === 'good'
															? 'success'
															: item.status === 'missing' || item.status === 'limited'
																? 'warning'
																: 'muted'
													}`}
												>
													{item.status}
												</span>
											</div>
											<div class="priority-item-meta">
												<span>{item.coverage}</span>
												<span>{item.rows}</span>
											</div>
										</div>
									))
								}
							</div>
						</article>
					))
				}
			</div>
		</section>

		<details class="section-card card architecture-shell" open>
			<summary class="collapse-summary architecture-summary">
				<div>
					<div class="kicker">Architecture control panel</div>
					<h2>Hop, relay, bottleneck, and system-view controls</h2>
					<p>
						Open the sections below for the Databento-style plant view: venue hops, live
						pipeline stages, relay junctions, bottlenecks, and the hardware stack behind them.
					</p>
				</div>
			</summary>

			<div class="collapse-body architecture-body">
				<details class="architecture-panel" id="topology" open>
					<summary class="collapse-summary">
						<div>
							<div class="kicker">Hop and speed analysis</div>
							<h3>Indicative topology for major exchanges, index flows, and relay points</h3>
						</div>
					</summary>
					<div class="collapse-body">
						<div class="topology-table-wrap">
							<table class="topology-table">
								<thead>
									<tr>
										<th>Venue</th>
										<th>Benchmarks / flows</th>
										<th>Primary PoP</th>
										<th>Relay path</th>
										<th>Hop budget</th>
										<th>Latency budget</th>
										<th>Link speed</th>
									</tr>
								</thead>
								<tbody>
									{
										topologyRoutes.map((route) => (
											<tr>
												<td>
													<strong>{route.venue}</strong>
													<p>{route.note}</p>
												</td>
												<td>{route.benchmarks}</td>
												<td>{route.pop}</td>
												<td>{route.relay}</td>
												<td>{route.hops}</td>
												<td>{route.latency}</td>
												<td>{route.speed}</td>
											</tr>
										))
									}
								</tbody>
							</table>
						</div>
					</div>
				</details>

				<details class="architecture-panel" id="live-pipeline">
					<summary class="collapse-summary">
						<div>
							<div class="kicker">Live data architecture</div>
							<h3>Primary path, redundant path, and the stack between them</h3>
						</div>
					</summary>
					<div class="collapse-body">
						<div class="pipeline-table-wrap">
							<table class="pipeline-table">
								<thead>
									<tr>
										<th>Stage</th>
										<th>Primary path</th>
										<th>Redundant path</th>
										<th>Data carried</th>
										<th>Junction</th>
										<th>Likely bottleneck</th>
										<th>Tech stack</th>
									</tr>
								</thead>
								<tbody>
									{
										livePipelineStages.map((item) => (
											<tr>
												<td><strong>{item.stage}</strong></td>
												<td>{item.primary}</td>
												<td>{item.redundant}</td>
												<td>{item.data}</td>
												<td>{item.junction}</td>
												<td>{item.bottleneck}</td>
												<td>{item.stack}</td>
											</tr>
										))
									}
								</tbody>
							</table>
						</div>
					</div>
				</details>

				<details class="architecture-panel">
					<summary class="collapse-summary">
						<div>
							<div class="kicker">Junction bottlenecks</div>
							<h3>Primary and redundant paths still fail at the joins</h3>
						</div>
					</summary>
					<div class="collapse-body">
						<div class="junction-grid">
							{
								architectureJunctions.map((item) => (
									<article class="signal-card card">
										<div class="signal-card-head">
											<div>
												<div class="ticker">Critical junction</div>
												<h3>{item.name}</h3>
											</div>
										</div>
										<div class="signal-lane">
											<span class="path-node">Primary</span>
											<span class="path-arrow">→</span>
											<span class="path-copy">{item.primary}</span>
										</div>
										<div class="signal-lane">
											<span class="path-node muted-node">Backup</span>
											<span class="path-arrow">→</span>
											<span class="path-copy">{item.backup}</span>
										</div>
										<div class="signal-metrics">
											<div>
												<dt>Choke</dt>
												<dd>{item.choke}</dd>
											</div>
											<div>
												<dt>Watch</dt>
												<dd>{item.watch}</dd>
											</div>
										</div>
									</article>
								))
							}
						</div>
					</div>
				</details>

				<details class="architecture-panel">
					<summary class="collapse-summary">
						<div>
							<div class="kicker">Relay points</div>
							<h3>Feed aggregation and redistribution laid out like signal paths</h3>
						</div>
					</summary>
					<div class="collapse-body">
						<div class="relay-grid">
							{
								relayPoints.map((relay) => (
									<article class="signal-card card">
										<div class="signal-card-head">
											<div>
												<div class="ticker">{relay.role}</div>
												<h3>{relay.name}</h3>
											</div>
										</div>
										<div class="signal-route">
											<span class="path-node">{relay.ingress}</span>
											<span class="path-arrow">→</span>
											<span class="path-node">{relay.spine}</span>
											<span class="path-arrow">→</span>
											<span class="path-node">{relay.egress}</span>
										</div>
										<div class="signal-metrics">
											<div>
												<dt>Backup</dt>
												<dd>{relay.backup}</dd>
											</div>
											<div>
												<dt>Choke</dt>
												<dd>{relay.choke}</dd>
											</div>
										</div>
									</article>
								))
							}
						</div>
					</div>
				</details>

				<details class="architecture-panel">
					<summary class="collapse-summary">
						<div>
							<div class="kicker">Server and system requirements</div>
							<h3>Baseline hardware for accessing the feed at speed</h3>
						</div>
					</summary>
					<div class="collapse-body">
						<div class="requirements-grid">
							{
								systemProfiles.map((profile) => (
									<article class="detail-card card">
										<div class="tileTop">
											<div>
												<div class="ticker">System profile</div>
												<h3>{profile.name}</h3>
											</div>
										</div>
										<dl class="requirements-list">
											<div>
												<dt>CPU</dt>
												<dd>{profile.cpu}</dd>
											</div>
											<div>
												<dt>Memory</dt>
												<dd>{profile.memory}</dd>
											</div>
											<div>
												<dt>NIC</dt>
												<dd>{profile.nic}</dd>
											</div>
											<div>
												<dt>Storage</dt>
												<dd>{profile.storage}</dd>
											</div>
										</dl>
										<p class="detail-meta">{profile.fit}</p>
									</article>
								))
							}
						</div>

						<div class="checklist-card">
							<div class="tileTop">
								<div>
									<div class="ticker">Fast-path checklist</div>
									<h3>Operating assumptions behind the latency budgets</h3>
								</div>
							</div>
							<div class="checklist-items">
								{
									fastPathChecklist.map((item) => (
										<div class="checklist-item">{item}</div>
									))
								}
							</div>
						</div>

						<div class="stack-grid">
							{
								techStackLayers.map((item) => (
									<article class="detail-card card">
										<div class="tileTop">
											<div>
												<div class="ticker">Tech stack layer</div>
												<h3>{item.layer}</h3>
											</div>
										</div>
										<p class="detail-copy">{item.tools}</p>
										<p class="detail-meta">{item.why}</p>
									</article>
								))
							}
						</div>
					</div>
				</details>
			</div>
		</details>

		<section class="section-card card featured-section">
			<div class="section-heading">
				<div>
					<div class="kicker">Featured profiles</div>
					<h2>Examples with richer metadata</h2>
					<p>
						These picks surface listings with better date coverage and stronger identity
						fields, similar to a “quick view” band on the reference page.
					</p>
				</div>
			</div>

			<div class="featured-grid">
				{
					featuredListings.map((item) => (
						<a class="featured-card card" href={`listing/?id=${encodeURIComponent(item.id)}`}>
							<div class="featured-card-head">
								<div>
									<h3>{item.nm}</h3>
									<p>{item.id}</p>
								</div>
								<span class={`badge ${item.dc === 'complete' ? 'success' : 'warning'}`}>
									{item.dc}
								</span>
							</div>
							<div class="featured-card-meta">
								<span>{item.ty}</span>
								<span>{item.ex}</span>
								<span>{item.co}</span>
							</div>
							<p class="featured-card-body">
								{item.se || ('ec' in item ? item.ec : '') || 'No sector/category metadata'} ·
								company {item.cd ? 'date included' : 'date missing'}
								{item.ip ? ' · IPO date included' : ''}
							</p>
						</a>
					))
				}
			</div>
		</section>

		<section class="section-card card explorer-section" id="explore">
			<div class="section-heading">
				<div>
					<div class="kicker">Directory explorer</div>
					<h2>Search, slice, and open individual listing profiles</h2>
					<p>
						The browser below runs entirely from static JSON, so the site keeps the same
						GitHub Pages-friendly footprint while feeling more like a data panel.
					</p>
				</div>
			</div>

			<div class="filters-grid">
				<label class="field field-search">
					<span>Search</span>
					<input
						id="filter-query"
						type="search"
						placeholder="Ticker, company, exchange, country, alias..."
						autocomplete="off"
					/>
				</label>

				<label class="field">
					<span>Security type</span>
					<select id="filter-type">
						<option value="">All types</option>
					</select>
				</label>

				<label class="field">
					<span>Date coverage</span>
					<select id="filter-coverage">
						<option value="">Any coverage</option>
						<option value="complete">Complete</option>
						<option value="partial">Partial</option>
						<option value="missing">Missing</option>
					</select>
				</label>

				<label class="field">
					<span>Country</span>
					<input id="filter-country" list="country-options" placeholder="All countries" />
					<datalist id="country-options"></datalist>
				</label>

				<label class="field">
					<span>Exchange</span>
					<input id="filter-exchange" list="exchange-options" placeholder="All exchanges" />
					<datalist id="exchange-options"></datalist>
				</label>

				<label class="field">
					<span>Sector</span>
					<input id="filter-sector" list="sector-options" placeholder="All sectors" />
					<datalist id="sector-options"></datalist>
				</label>
			</div>

			<div class="results-toolbar">
				<div id="results-meta" class="metaHint">Loading catalog…</div>
				<button id="clear-filters" class="button-secondary" type="button">Reset filters</button>
			</div>

			<div id="results-grid" class="results-grid"></div>

			<div class="pagination-row">
				<button id="prev-page" class="button-secondary" type="button">Previous</button>
				<div id="page-meta" class="metaHint">Page 1</div>
				<button id="next-page" class="button-secondary" type="button">Next</button>
			</div>
		</section>
	</section>

	<script is:inline define:vars={{ baseUrl: import.meta.env.BASE_URL }}>
		const pageSize = 24;
		const filterElements = {
			query: document.querySelector('#filter-query'),
			type: document.querySelector('#filter-type'),
			coverage: document.querySelector('#filter-coverage'),
			country: document.querySelector('#filter-country'),
			exchange: document.querySelector('#filter-exchange'),
			sector: document.querySelector('#filter-sector'),
		};
		const resultsMeta = document.querySelector('#results-meta');
		const resultsGrid = document.querySelector('#results-grid');
		const pageMeta = document.querySelector('#page-meta');
		const previousButton = document.querySelector('#prev-page');
		const nextButton = document.querySelector('#next-page');
		const clearFiltersButton = document.querySelector('#clear-filters');
		const countryOptions = document.querySelector('#country-options');
		const exchangeOptions = document.querySelector('#exchange-options');
		const sectorOptions = document.querySelector('#sector-options');
		const state = {
			query: '',
			type: '',
			coverage: '',
			country: '',
			exchange: '',
			sector: '',
			page: 1,
		};
		let catalog = [];
		let filteredCatalog = [];

		const countFormatter = new Intl.NumberFormat();
		const dateFormatter = new Intl.DateTimeFormat(undefined, { dateStyle: 'medium' });

		function escapeHtml(value) {
			return String(value || '').replace(/[&<>'"]/g, (character) => {
				return (
					{
						'&': '&amp;',
						'<': '&lt;',
						'>': '&gt;',
						"'": '&#39;',
						'"': '&quot;',
					}[character] || character
				);
			});
		}

		function formatDate(value) {
			if (!value) return 'Unavailable';
			const date = new Date(value);
			return Number.isNaN(date.getTime()) ? value : dateFormatter.format(date);
		}

		function coverageBadge(coverage) {
			if (coverage === 'complete') return 'success';
			if (coverage === 'partial') return 'warning';
			return 'muted';
		}

		function normalize(value) {
			return String(value || '').trim().toLowerCase();
		}

		function applyUrlState() {
			const params = new URLSearchParams(window.location.search);
			state.query = params.get('q') || '';
			state.type = params.get('type') || '';
			state.coverage = params.get('coverage') || '';
			state.country = params.get('country') || '';
			state.exchange = params.get('exchange') || '';
			state.sector = params.get('sector') || '';
			state.page = Math.max(Number(params.get('page') || '1'), 1);

			filterElements.query.value = state.query;
			filterElements.type.value = state.type;
			filterElements.coverage.value = state.coverage;
			filterElements.country.value = state.country;
			filterElements.exchange.value = state.exchange;
			filterElements.sector.value = state.sector;
		}

		function syncUrl() {
			const params = new URLSearchParams();
			if (state.query) params.set('q', state.query);
			if (state.type) params.set('type', state.type);
			if (state.coverage) params.set('coverage', state.coverage);
			if (state.country) params.set('country', state.country);
			if (state.exchange) params.set('exchange', state.exchange);
			if (state.sector) params.set('sector', state.sector);
			if (state.page > 1) params.set('page', String(state.page));
			const queryString = params.toString();
			const nextUrl = `${window.location.pathname}${queryString ? `?${queryString}` : ''}#explore`;
			window.history.replaceState({}, '', nextUrl);
		}

		function createOptionMarkup(values) {
			return values.map((value) => `<option value="${escapeHtml(value)}"></option>`).join('');
		}

		function populateFilterControls(records) {
			const securityTypes = [...new Set(records.map((entry) => entry.ty).filter(Boolean))].sort();
			const countries = [...new Set(records.map((entry) => entry.co).filter(Boolean))].sort();
			const exchanges = [...new Set(records.map((entry) => entry.ex).filter(Boolean))].sort();
			const sectors = [...new Set(records.map((entry) => entry.se).filter(Boolean))].sort();

			filterElements.type.innerHTML = `<option value="">All types</option>${securityTypes
				.map((value) => `<option value="${escapeHtml(value)}">${escapeHtml(value)}</option>`)
				.join('')}`;
			countryOptions.innerHTML = createOptionMarkup(countries);
			exchangeOptions.innerHTML = createOptionMarkup(exchanges);
			sectorOptions.innerHTML = createOptionMarkup(sectors);
		}

		function filterCatalog() {
			const query = normalize(state.query);
			const type = normalize(state.type);
			const coverage = normalize(state.coverage);
			const country = normalize(state.country);
			const exchange = normalize(state.exchange);
			const sector = normalize(state.sector);

			filteredCatalog = catalog.filter((entry) => {
				if (query && !entry._search.includes(query)) return false;
				if (type && normalize(entry.ty) !== type) return false;
				if (coverage && normalize(entry.dc) !== coverage) return false;
				if (country && normalize(entry.co) !== country) return false;
				if (exchange && normalize(entry.ex) !== exchange) return false;
				if (sector && normalize(entry.se) !== sector) return false;
				return true;
			});

			const maxPage = Math.max(Math.ceil(filteredCatalog.length / pageSize), 1);
			state.page = Math.min(state.page, maxPage);
		}

		function renderResults() {
			filterCatalog();
			const total = filteredCatalog.length;
			const firstItem = total === 0 ? 0 : (state.page - 1) * pageSize + 1;
			const lastItem = Math.min(state.page * pageSize, total);
			const pageItems = filteredCatalog.slice(firstItem - 1, lastItem);

			resultsMeta.textContent =
				total === 0
					? 'No listings match these filters.'
					: `Showing ${countFormatter.format(firstItem)}-${countFormatter.format(lastItem)} of ${countFormatter.format(total)} listings`;

			pageMeta.textContent = `Page ${state.page} of ${Math.max(Math.ceil(total / pageSize), 1)}`;
			previousButton.disabled = state.page <= 1;
			nextButton.disabled = state.page >= Math.max(Math.ceil(total / pageSize), 1);

			if (pageItems.length === 0) {
				resultsGrid.innerHTML = `
					<div class="result-empty card">
						<h3>No matches</h3>
						<p>Try a broader search, clear one of the filters, or jump back to a top country or exchange above.</p>
					</div>
				`;
				return;
			}

			resultsGrid.innerHTML = pageItems
				.map((entry) => {
					const tags = [
						entry.ty,
						entry.ex,
						entry.co,
						entry.se || entry.ec,
						entry.dc,
					].filter(Boolean);
					return `
						<article class="result-card card">
							<div class="result-card-head">
								<div>
									<h3>${escapeHtml(entry.nm)}</h3>
									<p>${escapeHtml(entry.id)}</p>
								</div>
								<span class="badge ${coverageBadge(entry.dc)}">${escapeHtml(entry.dc || 'missing')}</span>
							</div>
							<div class="result-card-tags">
								${tags
									.map((tag) => `<span class="badge muted">${escapeHtml(tag)}</span>`)
									.join('')}
							</div>
							<p class="result-card-body">
								${escapeHtml(entry.ln || 'Primary legal name unavailable')}
							</p>
							<div class="result-card-footer">
								<span class="muted">Company: ${escapeHtml(formatDate(entry.cd))}</span>
								<span class="muted">IPO: ${escapeHtml(formatDate(entry.ip))}</span>
							</div>
							<a class="button result-link" href="${baseUrl}listing/?id=${encodeURIComponent(entry.id)}">
								Open profile
							</a>
						</article>
					`;
				})
				.join('');
		}

		function handleFilterChange() {
			state.query = filterElements.query.value.trim();
			state.type = filterElements.type.value.trim();
			state.coverage = filterElements.coverage.value.trim();
			state.country = filterElements.country.value.trim();
			state.exchange = filterElements.exchange.value.trim();
			state.sector = filterElements.sector.value.trim();
			state.page = 1;
			syncUrl();
			renderResults();
		}

		async function loadCatalog() {
			const response = await fetch(`${baseUrl}data/catalog.json`);
			if (!response.ok) {
				throw new Error(`Failed to load catalog: ${response.status}`);
			}

			const records = await response.json();
			return records.map((entry) => ({
				...entry,
				_search: [
					entry.id,
					entry.sy,
					entry.ex,
					entry.nm,
					entry.ln,
					entry.ty,
					entry.se,
					entry.ec,
					entry.co,
					...(entry.al || []),
				]
					.filter(Boolean)
					.join(' ')
					.toLowerCase(),
			}));
		}

		previousButton.addEventListener('click', () => {
			state.page = Math.max(1, state.page - 1);
			syncUrl();
			renderResults();
		});

		nextButton.addEventListener('click', () => {
			state.page += 1;
			syncUrl();
			renderResults();
		});

		clearFiltersButton.addEventListener('click', () => {
			Object.assign(state, {
				query: '',
				type: '',
				coverage: '',
				country: '',
				exchange: '',
				sector: '',
				page: 1,
			});
			applyUrlState();
			syncUrl();
			renderResults();
		});

		for (const element of Object.values(filterElements)) {
			element.addEventListener('input', handleFilterChange);
			element.addEventListener('change', handleFilterChange);
		}

		(async () => {
			try {
				catalog = await loadCatalog();
				populateFilterControls(catalog);
				applyUrlState();
				renderResults();
			} catch (error) {
				resultsMeta.textContent = 'Catalog failed to load.';
				resultsGrid.innerHTML = `
					<div class="result-empty card">
						<h3>Unable to load the directory</h3>
						<p>${escapeHtml(error.message)}</p>
					</div>
				`;
			}
		})();
	</script>
</Layout>

<style>
	.home-shell {
		display: flex;
		flex-direction: column;
		gap: 18px;
	}

	.header {
		display: flex;
		flex-direction: column;
		gap: 16px;
	}

	.home-topBand {
		display: grid;
		grid-template-columns: minmax(0, 1.28fr) minmax(300px, 0.92fr);
		gap: 16px;
	}

	.home-hero h1 {
		margin: 0;
		font-family: var(--font-serif);
		font-size: clamp(3rem, 6vw, 4.75rem);
		font-weight: 400;
		line-height: 0.96;
		letter-spacing: 0.01em;
		max-width: 10ch;
	}

	.hero-lead {
		margin: 14px 0 0;
		max-width: 58rem;
		font-size: 1.04rem;
