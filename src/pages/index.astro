/** Illustrative desk-style rows (not tradable quotes) — mirrors Game predictions card density. */
const priorityStatusDepthPct: Record<string, number> = {
	strong: 71,
	good: 60,
	medium: 52,
	limited: 44,
	missing: 33,
};

function priorityIcon(symbol: string, groupTitle: string): string {
	const s = symbol.toUpperCase();
	if (s.includes('BTC') || s.includes('MAJOR-CRYPTO')) return '₿';
	if (groupTitle.toLowerCase().includes('crypto')) return '◆';
	if (groupTitle.toLowerCase().includes('ai')) return '◎';
	if (groupTitle.toLowerCase().includes('benchmark')) return '📊';
	if (s.startsWith('GC')) return '🥇';
	if (s.startsWith('SI')) return '🥈';
	return '📈';
}

function priorityCardModel(item: { status: string; rows: string; coverage: string }) {
	const depth = priorityStatusDepthPct[item.status] ?? 50;
	const alt = 100 - depth;
	const rowsNum = Number.parseInt(item.rows.replace(/[^\d]/g, ''), 10) || 0;
	const payoutDepth = Math.round(100 + (depth / 100) * 188 + Math.min(rowsNum / 4000, 1) * 42);
	const payoutAlt = Math.max(102, Math.round(100 + (alt / 100) * 162));
	return {
		depthPct: depth,
		altPct: alt,
		payoutDepth,
		payoutAlt,
		volLine: `${item.rows} · ${item.coverage}`,
	};
}

function priorityHash(s: string): number {
	let h = 0;
	for (let i = 0; i < s.length; i++) h = (Math.imul(31, h) + s.charCodeAt(i)) | 0;
	return Math.abs(h);
}

type PriorityQuoteBand = { min: number; max: number; decimals: number; ccy: string; venue: string };

function priorityQuoteBand(symbol: string): PriorityQuoteBand {
	const u = symbol.toUpperCase();
	if (u.includes('MAJOR-CRYPTO')) return { min: 3200, max: 4200, decimals: 2, ccy: 'USD', venue: 'IDX' };
	if (u.includes('BTC')) return { min: 92_000, max: 108_000, decimals: 2, ccy: 'USD', venue: 'COIN' };
	if (u.startsWith('GC')) return { min: 2380, max: 2660, decimals: 1, ccy: 'USD', venue: 'COMEX' };
	if (u.startsWith('SI')) return { min: 28.5, max: 35.2, decimals: 3, ccy: 'USD', venue: 'COMEX' };
	if (u.startsWith('PL')) return { min: 980, max: 1180, decimals: 1, ccy: 'USD', venue: 'NYMEX' };
	if (u.startsWith('PA')) return { min: 940, max: 1150, decimals: 1, ccy: 'USD', venue: 'NYMEX' };
	if (u.startsWith('HG')) return { min: 4.05, max: 5.35, decimals: 3, ccy: 'USD', venue: 'COMEX' };
	if (u.startsWith('ALI')) return { min: 2280, max: 2680, decimals: 2, ccy: 'USD', venue: 'LME' };
	if (u.startsWith('ES')) return { min: 5100, max: 5950, decimals: 2, ccy: 'USD', venue: 'CME' };
	if (u === 'QQQ') return { min: 420, max: 560, decimals: 2, ccy: 'USD', venue: 'NASDAQ' };
	if (u.startsWith('^')) return { min: 4800, max: 6200, decimals: 2, ccy: 'USD', venue: 'SPOT' };
	if (!u.includes('=') && u.length <= 6) return { min: 140, max: 520, decimals: 2, ccy: 'USD', venue: 'NASDAQ' };
	return { min: 22, max: 220, decimals: 2, ccy: 'USD', venue: 'FUT' };
}

function roundPrice(n: number, decimals: number): number {
	const p = 10 ** decimals;
	return Math.round(n * p) / p;
}

/** TradingView-style header numbers — deterministic from symbol + desk depth; not live market data. */
function priorityTvQuote(item: { symbol: string; coverage: string }, model: { depthPct: number }) {
	const band = priorityQuoteBand(item.symbol);
	const t = (priorityHash(item.symbol) % 100_001) / 100_000;
	const last = roundPrice(band.min + t * (band.max - band.min), band.decimals);
	const j = (priorityHash(`${item.symbol}|d`) % 100_001) / 100_000;
	const deltaPct = ((j * 2 - 1) * 0.55 * model.depthPct) / 100;
	const prev = last / (1 + deltaPct / 100);
	const chgPts = roundPrice(last - prev, Math.min(3, band.decimals + 1));
	const chgPct = roundPrice(deltaPct, 2);
	const up = deltaPct >= 0;
	const m = item.coverage.match(/->\s*(\d{4})-(\d{2})/);
	let dateLabel = 'Apr 30, 2026';
	let timeLabel = '13:59';
	if (m) {
		const y = Number(m[1]);
		const mo = Number(m[2]) - 1;
		const d = new Date(y, mo, 28);
		dateLabel = d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
		timeLabel = `${11 + (priorityHash(`${item.symbol}|t`) % 6)}:59`;
	}
	const lastStr = last.toLocaleString('en-US', {
		minimumFractionDigits: band.decimals,
		maximumFractionDigits: band.decimals,
	});
	const chgPtsAbs = Math.abs(chgPts).toLocaleString('en-US', { maximumFractionDigits: 3 });
	const chgPctAbs = Math.abs(chgPct).toFixed(2);
	return {
		lastStr,
		ccy: band.ccy,
		venue: band.venue,
		sym: item.symbol,
		chgPtsStr: up ? `+${chgPtsAbs}` : `-${chgPtsAbs}`,
		chgPctStr: up ? `+${chgPctAbs}%` : `-${chgPctAbs}%`,
		up,
		dateLabel,
		timeLabel,
	};
}

