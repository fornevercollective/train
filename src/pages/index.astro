	'PTP or a tightly disciplined clock so exchange timestamps, relay stamps, and strategy clocks line up.',
	'NICs with hardware timestamping, deep RX rings, and driver settings reviewed for burst handling.',
	'NVMe-first storage for capture and replay; avoid SATA or network filesystems on the ingestion hot path.',
	'25 GbE east-west links as the minimum serious relay target; 100 GbE where multi-venue fanout is shared.',
];
const layoutEyebrow = 'Directory view';
const layoutSubtitle =
	'Static listing intelligence; search and filters live on the Directory tab.';
---

<Layout
	title="Erika Market Directory"
	description="Search 60k+ global stock and ETF listings from the Erika dataset in a fast GitHub Pages-ready directory."
	pageClass="page-home"
	eyebrow={layoutEyebrow}
	subtitle={layoutSubtitle}
>
	<section class="container home-shell">
		<header class="header">
			<div class="disclaimer" role="note" aria-label="Directory disclaimer">
				<p class="disclaimer__text">
					This directory is a static metadata browser for research and educational use. It is
					not an offer to buy or sell securities, and it does not replace financial, legal, or
					tax advice.
				</p>
			</div>
		</header>

		<div class="home-topBand">
			<article class="card home-hero">
				<div class="tileTop">
					<div>
						<div class="ticker">Directory search</div>
						<h1>Explore Erika world Market data.</h1>
						<p class="hero-lead">
							A GitHub Pages-ready catalog for {summary.totalSymbols.toLocaleString()} global
							listings across stocks and ETFs, with searchable metadata, exchange filters, and
							date-coverage signals.
						</p>
					</div>
				</div>
				<div class="hero-actions hero-actions-row">
					<a class="button" href="directory/">Browse the directory</a>
					<a
						class="button-secondary"
						href={
							primaryFeaturedListing
								? `listing/?id=${encodeURIComponent(primaryFeaturedListing.id)}`
								: 'featured/'
						}
					>
						Open featured profile
					</a>
					<a class="button-secondary" href="raw/">Open raw data page</a>
					{
						gameLiveUrl ? (
							<a class="button-secondary" href={gameLiveUrl} target="_blank" rel="noopener noreferrer">
								Open Game live desk
							</a>
						) : (
							<a class="button-secondary" href="#home-live-analysis">
								Live analysis desk
							</a>
						)
					}
				</div>
				<nav class="hero-section-nav" aria-label="Sections on this page">
					<ul class="hero-section-nav-list">
						{
							homeSectionLinks.map((item) => (
								<li>
									<a class="hero-section-nav-link" href={item.href}>
										{item.label}
									</a>
								</li>
							))
						}
					</ul>
				</nav>
				<div class="quick-links">
					{
						quickLinks.map((link) => (
							<a class="badge muted" href={link.href}>
								{link.label}
							</a>
						))
					}
				</div>
			</article>

			<details class="card home-stats" id="home-stats-panel" open>
				<summary class="home-stats-summary">
					<div class="home-stats-summary-text">
						<div class="ticker">Coverage snapshot</div>
						<div class="name">High-level shape of the Erika listing universe.</div>
					</div>
					<span class="home-stats-chevron" aria-hidden="true" />
				</summary>
				<div class="home-stats-body">
					<HomeStatsECharts
						totalSymbols={summary.totalSymbols}
						uniqueCountries={summary.uniqueCountries}
						uniqueExchanges={summary.uniqueExchanges}
						withCompanyCreation={summary.withCompanyCreation}
						withIpoCreation={summary.withIpoCreation}
						completeCoverage={summary.dateCoverage.complete}
						stockCount={summary.securityTypes[0]?.count ?? 0}
						etfCount={summary.securityTypes[1]?.count ?? 0}
						stockName={summary.securityTypes[0]?.name ?? 'Stock'}
						etfName={summary.securityTypes[1]?.name ?? 'ETF'}
					/>
				</div>
			</details>
		</div>

		<PredictionsGamePanel
			id="home-predictions"
			variant="home"
			gameHomeUrl={gameHomeUrl}
			gameLiveUrl={gameLiveUrl}
			gamePredictionsHashUrl={gamePredictionsHashUrl}
		/>

		<HomeLiveAnalysis gameLiveUrl={gameLiveUrl} anchorMode="here" />

		<BloombergLiveRelay />

		<section class="facet-strip" id="home-facets">
			<div class="card facet-card">
				<div class="tileTop">
					<div>
						<div class="ticker">Top countries</div>
						<div class="name">Most represented jurisdictions in the dataset.</div>
					</div>
				</div>
				<div
					id="home-facet-countries-viz"
					class="home-facet-viz"
					data-payload={encodeURIComponent(JSON.stringify(topCountries))}
					role="img"
					aria-label="Top countries graph (catalog counts)"
				></div>
				<div class="facet-list">
					{
						topCountries.map((item) => (
							<a class="badge muted" href={`directory/?country=${encodeURIComponent(item.name)}`}>
								{item.name} · {item.count.toLocaleString()}
							</a>
						))
					}
				</div>
			</div>

			<div class="card facet-card">
				<div class="tileTop">
					<div>
						<div class="ticker">Top exchanges</div>
						<div class="name">Quick pivots into the busiest listing venues.</div>
					</div>
				</div>
				<div
					id="home-facet-exchanges-viz"
					class="home-facet-viz"
					data-payload={encodeURIComponent(JSON.stringify(topExchanges))}
					role="img"
					aria-label="Top exchanges affinity matrix (catalog counts)"
				></div>
				<div class="facet-list">
					{
						topExchanges.map((item) => (
							<a class="badge muted" href={`directory/?exchange=${encodeURIComponent(item.name)}`}>
								{item.name} · {item.count.toLocaleString()}
							</a>
						))
					}
				</div>
			</div>

			<div class="card facet-card">
				<div class="tileTop">
					<div>
						<div class="ticker">Top sectors</div>
						<div class="name">Fast routes into sector-based slices of the directory.</div>
					</div>
				</div>
				<div
					id="home-facet-sectors-viz"
					class="home-facet-viz"
					data-payload={encodeURIComponent(JSON.stringify(topSectors))}
					role="img"
					aria-label="Top sectors parallel coordinates (catalog counts)"
				></div>
				<div class="facet-list">
					{
						topSectors.map((item) => (
							<a class="badge muted" href={`directory/?sector=${encodeURIComponent(item.name)}`}>
								{item.name} · {item.count.toLocaleString()}
							</a>
						))
					}
				</div>
			</div>
		</section>

		<section class="section-card card priority-section" id="home-priority-markets">
			<div class="section-heading priority-section-heading">
				<div>
					<div class="kicker">Priority markets</div>
					<h2>Put metals and the key market presets up front</h2>
					<p>
						The Erika lake is updated through 2026-04-30, but the time-series coverage is not
						uniform across all symbols. Metals are the strongest local histories, so they now
						get a dedicated top-level block instead of being buried below the listing directory.
					</p>
				</div>
				<div
					id="home-viz-priority-polar"
					class="home-priority-polar-viz"
					role="img"
					aria-label="Illustrative weekly desk intensity (polar punch card)"
				></div>
			</div>

			<div class="priority-grid">
				{
					priorityGroups.map((group) => (
						<article class="priority-card card">
							<div class="tileTop">
								<div>
									<div class="ticker">{group.kicker}</div>
									<h3>{group.title}</h3>
									<p class="priority-copy">{group.description}</p>
								</div>
							</div>
							<div class="priority-items">
								{
									group.items.map((item) => {
										const tvSymbol = YAHOO_TO_TRADINGVIEW[item.symbol];
										const liveHref = `listing/?t=${encodeURIComponent(item.symbol)}&label=${encodeURIComponent(item.name)}`;
										const model = priorityCardModel(item);
										const tvQuote = priorityTvQuote(item, model);
										const icon = priorityIcon(item.symbol, group.title);
										const statusClass =
											item.status === 'strong' || item.status === 'good'
												? 'success'
												: item.status === 'missing' || item.status === 'limited'
													? 'warning'
													: 'muted';
										return (
											<article class="priority-item">
												<div
													class="priority-tv-quote"
													role="group"
													aria-label={`Illustrative last price for ${item.name} (not live)`}
												>
													<div class="priority-tv-quoteTop">
														<div class="priority-tv-priceCluster">
															<span class="priority-tv-last">{tvQuote.lastStr}</span>
															<span class="priority-tv-ccy">{tvQuote.ccy}</span>
															<span class="priority-tv-slash" aria-hidden="true">/</span>
															<span class="priority-tv-sym">{tvQuote.sym}</span>
															<span class="priority-tv-venueBadge">{tvQuote.venue}</span>
														</div>
														<div
															class:list={[
																'priority-tv-delta',
																tvQuote.up ? 'priority-tv-delta--up' : 'priority-tv-delta--down',
															]}
														>
															<span class="priority-tv-deltaPts">{tvQuote.chgPtsStr}</span>
															<span class="priority-tv-deltaPct">{tvQuote.chgPctStr}</span>
														</div>
													</div>
													<p class="priority-tv-session muted">
														At close at {tvQuote.dateLabel}, {tvQuote.timeLabel} GMT-7 · Erika snapshot
													</p>
												</div>
												<a class="priority-item-main" href={liveHref}>
													<div class="priority-item-cardtop">
														<span class="priority-item-icon" aria-hidden="true">
															{icon}
														</span>
														<div class="priority-item-titles">
															<h3 class="priority-item-title">{item.name}</h3>
															<p class="priority-item-sub">
																{item.symbol} · <span class={`badge ${statusClass}`}>{item.status}</span> · Erika
																snapshot
															</p>
														</div>
														{tvSymbol ? (
															<span class="priority-live-pill">Live</span>
														) : (
															<span class="priority-snapshot-pill">Snapshot</span>
														)}
													</div>
													<div class="priority-item-outcomes">
														<div class="priority-item-outcome">
															<div class="priority-item-outcome-left">
																<span class="priority-item-code">DEPTH</span>
																<span class="priority-item-pct">{model.depthPct}%</span>
															</div>
															<div class="priority-item-payout">
																$100 → <strong>${model.payoutDepth.toLocaleString()}</strong>
															</div>
														</div>
														<div class="priority-item-outcome">
															<div class="priority-item-outcome-left">
																<span class="priority-item-code">SURFACE</span>
																<span class="priority-item-pct">{model.altPct}%</span>
															</div>
															<div class="priority-item-payout">
																$100 → <strong>${model.payoutAlt.toLocaleString()}</strong>
															</div>
														</div>
													</div>
													<p class="priority-item-vol">{model.volLine}</p>
													<p class="priority-item-desk-hint muted">
														Illustrative desk legs — not a tradable quote. TV mini loads when mapped.
													</p>
												</a>
												{tvSymbol ? (
													<div class="priority-item-tv">
														<p class="priority-live-caption muted">Live snapshot · hourly interval</p>
														<div
															class="priority-snapshot-charts"
															data-home-priority-snapshot
															data-payload={encodeURIComponent(
																JSON.stringify({
																	symbol: item.symbol,
																	name: item.name,
																	depthPct: model.depthPct,
																	altPct: model.altPct,
																	status: item.status,
																}),
															)}
														>
															<div class="priority-chart-river" data-home-priority-river></div>
															<div class="priority-chart-radar" data-home-priority-radar></div>
														</div>
														<div class="priority-tv-frame">
															<iframe
																class="priority-live-iframe"
																title={`${item.name} (${item.symbol}) TradingView mini`}
																loading="lazy"
																referrerpolicy="no-referrer-when-downgrade"
																allow="clipboard-write; fullscreen"
																src={tradingViewMiniUrl(tvSymbol)}
															/>
														</div>
													</div>
												) : null}
											</article>
										);
									})
								}
							</div>
						</article>
					))
				}
			</div>
		</section>

		<details class="section-card card architecture-shell" id="home-architecture" open>
			<summary class="collapse-summary architecture-summary">
				<div>
					<div class="kicker">Architecture control panel</div>
					<h2>Hop, relay, bottleneck, and system-view controls</h2>
					<p>
						Open the sections below for the Databento-style plant view: venue hops, live
						pipeline stages, relay junctions, bottlenecks, and the hardware stack behind them.
					</p>
				</div>
			</summary>

			<div class="collapse-body architecture-body">
				<details class="architecture-panel" id="topology" open>
					<summary class="collapse-summary">
						<div>
							<div class="kicker">Hop and speed analysis</div>
							<h3>Indicative topology for major exchanges, index flows, and relay points</h3>
						</div>
					</summary>
					<div class="collapse-body">
						<div
							id="topology-viz-root"
							class="topology-viz-root"
							data-payload={encodeURIComponent(JSON.stringify(topologyVizPayload))}
							aria-label="Illustrative hop topology: relay gauge, venue graph, animated paths"
						>
							<div class="topology-viz-row">
								<div id="topology-viz-gauge" class="topology-viz-gauge" aria-hidden="true"></div>
								<div id="topology-viz-geo" class="topology-viz-geo" aria-hidden="true"></div>
							</div>
							<div id="topology-viz-flights" class="topology-viz-flights" aria-hidden="true"></div>
							<p class="topology-viz-note muted">
								Static ECharts metaphors —{' '}
								<a
									href="https://echarts.apache.org/examples/en/editor.html?c=gauge-ring"
									target="_blank"
									rel="noopener noreferrer">gauge ring</a>
								,{' '}
								<a
									href="https://echarts.apache.org/examples/en/editor.html?c=geo-graph"
									target="_blank"
									rel="noopener noreferrer">geo-style graph</a>
								, and a 2D take on{' '}
								<a
									href="https://echarts.apache.org/examples/en/editor.html?c=lines3d-flights-gl&gl=1"
									target="_blank"
									rel="noopener noreferrer">flight paths</a>
								(not WebGL 3D here).
							</p>
						</div>
						<div class="topology-table-wrap">
							<table class="topology-table">
								<thead>
									<tr>
										<th>Venue</th>
										<th>Benchmarks / flows</th>
										<th>Primary PoP</th>
										<th>Relay path</th>
										<th>Hop budget</th>
										<th>Latency budget</th>
										<th>Link speed</th>
									</tr>
								</thead>
								<tbody>
									{
										topologyRoutes.map((route) => (
											<tr>
												<td>
													<strong>{route.venue}</strong>
													<p>{route.note}</p>
												</td>
												<td>{route.benchmarks}</td>
												<td>{route.pop}</td>
												<td>{route.relay}</td>
												<td>{route.hops}</td>
												<td>{route.latency}</td>
												<td>{route.speed}</td>
											</tr>
										))
									}
								</tbody>
							</table>
						</div>
					</div>
				</details>

				<details class="architecture-panel" id="live-pipeline">
					<summary class="collapse-summary">
						<div>
							<div class="kicker">Live data architecture</div>
							<h3>Primary path, redundant path, and the stack between them</h3>
						</div>
					</summary>
					<div class="collapse-body">
						<div class="pipeline-table-wrap">
							<table class="pipeline-table">
								<thead>
									<tr>
										<th>Stage</th>
										<th>Primary path</th>
										<th>Redundant path</th>
										<th>Data carried</th>
										<th>Junction</th>
										<th>Likely bottleneck</th>
										<th>Tech stack</th>
									</tr>
								</thead>
								<tbody>
									{
										livePipelineStages.map((item) => (
											<tr>
												<td><strong>{item.stage}</strong></td>
												<td>{item.primary}</td>
												<td>{item.redundant}</td>
												<td>{item.data}</td>
												<td>{item.junction}</td>
												<td>{item.bottleneck}</td>
												<td>{item.stack}</td>
											</tr>
										))
									}
								</tbody>
							</table>
						</div>
					</div>
				</details>

				<details class="architecture-panel">
					<summary class="collapse-summary">
						<div>
							<div class="kicker">Junction bottlenecks</div>
							<h3>Primary and redundant paths still fail at the joins</h3>
						</div>
					</summary>
					<div class="collapse-body">
						<div class="junction-grid">
							{
								architectureJunctions.map((item) => (
									<article class="signal-card card">
										<div class="signal-card-head">
											<div>
												<div class="ticker">Critical junction</div>
												<h3>{item.name}</h3>
											</div>
										</div>
										<div class="signal-lane">
											<span class="path-node">Primary</span>
											<span class="path-arrow">→</span>
											<span class="path-copy">{item.primary}</span>
										</div>
										<div class="signal-lane">
											<span class="path-node muted-node">Backup</span>
											<span class="path-arrow">→</span>
											<span class="path-copy">{item.backup}</span>
										</div>
										<div class="signal-metrics">
											<div>
												<dt>Choke</dt>
												<dd>{item.choke}</dd>
											</div>
											<div>
												<dt>Watch</dt>
												<dd>{item.watch}</dd>
											</div>
										</div>
									</article>
								))
							}
						</div>
					</div>
				</details>

				<details class="architecture-panel">
					<summary class="collapse-summary">
						<div>
							<div class="kicker">Relay points</div>
							<h3>Feed aggregation and redistribution laid out like signal paths</h3>
						</div>
					</summary>
					<div class="collapse-body">
						<div class="relay-grid">
							{
								relayPoints.map((relay) => (
									<article class="signal-card card">
										<div class="signal-card-head">
											<div>
												<div class="ticker">{relay.role}</div>
												<h3>{relay.name}</h3>
											</div>
										</div>
										<div class="signal-route">
											<span class="path-node">{relay.ingress}</span>
											<span class="path-arrow">→</span>
											<span class="path-node">{relay.spine}</span>
											<span class="path-arrow">→</span>
											<span class="path-node">{relay.egress}</span>
										</div>
										<div class="signal-metrics">
											<div>
												<dt>Backup</dt>
												<dd>{relay.backup}</dd>
											</div>
											<div>
												<dt>Choke</dt>
												<dd>{relay.choke}</dd>
											</div>
										</div>
									</article>
								))
							}
						</div>
					</div>
				</details>

				<details class="architecture-panel">
					<summary class="collapse-summary">
						<div>
							<div class="kicker">Server and system requirements</div>
							<h3>Baseline hardware for accessing the feed at speed</h3>
						</div>
					</summary>
					<div class="collapse-body">
						<div class="requirements-grid">
							{
								systemProfiles.map((profile) => (
									<article class="detail-card card">
										<div class="tileTop">
											<div>
												<div class="ticker">System profile</div>
												<h3>{profile.name}</h3>
											</div>
										</div>
										<dl class="requirements-list">
											<div>
												<dt>CPU</dt>
												<dd>{profile.cpu}</dd>
											</div>
											<div>
												<dt>Memory</dt>
												<dd>{profile.memory}</dd>
											</div>
											<div>
												<dt>NIC</dt>
												<dd>{profile.nic}</dd>
											</div>
											<div>
												<dt>Storage</dt>
												<dd>{profile.storage}</dd>
											</div>
										</dl>
										<p class="detail-meta">{profile.fit}</p>
									</article>
								))
							}
						</div>

						<div class="checklist-card">
							<div class="tileTop">
								<div>
									<div class="ticker">Fast-path checklist</div>
									<h3>Operating assumptions behind the latency budgets</h3>
								</div>
							</div>
							<div class="checklist-items">
								{
									fastPathChecklist.map((item) => (
										<div class="checklist-item">{item}</div>
									))
								}
							</div>
						</div>

						<div class="stack-grid">
							{
								techStackLayers.map((item) => (
									<article class="detail-card card">
										<div class="tileTop">
											<div>
												<div class="ticker">Tech stack layer</div>
												<h3>{item.layer}</h3>
											</div>
										</div>
										<p class="detail-copy">{item.tools}</p>
										<p class="detail-meta">{item.why}</p>
									</article>
								))
							}
						</div>
					</div>
				</details>
			</div>
		</details>

		<section class="section-card card featured-section" id="home-featured">
			<div class="section-heading">
				<div>
					<div class="kicker">Sample listings</div>
					<h2>Reference profiles with richer metadata</h2>
					<p>
						These remain static reference profiles with better date coverage and stronger
						identity fields. The timezone-aware majors page now lives separately under
						Featured.
					</p>
				</div>
			</div>

			<div class="featured-grid">
				{
					featuredListings.map((item) => (
