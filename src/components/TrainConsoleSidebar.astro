---
/** Mirrors game `components/app-sidebar.tsx` — Train routes + optional Game console links. */
interface NavActive {
	home: boolean;
	featured: boolean;
	predictions: boolean;
	directory: boolean;
	listing: boolean;
	raw: boolean;
}

interface Props {
	baseUrl: string;
	gameConsoleUrl: string;
	navActive: NavActive;
}

const { baseUrl, gameConsoleUrl, navActive } = Astro.props;
const b = baseUrl.endsWith('/') ? baseUrl : `${baseUrl}/`;
const gameHome = gameConsoleUrl ? `${gameConsoleUrl}/` : '';
const gameLive = gameConsoleUrl ? `${gameConsoleUrl}/live` : '';

type NavItem = {
	href: string;
	label: string;
	ext?: boolean;
	match: keyof NavActive | 'liveAnalysis' | 'gameLive';
};

const items: NavItem[] = [
	{ href: b, label: 'Home', match: 'home' },
	{ href: `${b}predictions/`, label: 'Predictions', match: 'predictions' },
	{ href: `${b}predictions/#home-live-analysis`, label: 'Live analysis', match: 'liveAnalysis' },
	{ href: `${b}directory/`, label: 'Markets', match: 'directory' },
	{ href: `${b}featured/`, label: 'Featured', match: 'featured' },
];

if (gameLive) {
	items.push({ href: gameLive, label: 'Game /live', ext: true, match: 'gameLive' });
}

items.push(
	{ href: `${b}listing/`, label: 'Execution ops', match: 'listing' },
	{ href: `${b}raw/`, label: 'Raw research', match: 'raw' },
);

function isActive(item: NavItem): boolean {
	if (item.match === 'liveAnalysis') return navActive.predictions;
	if (item.match === 'gameLive') return false;
	return navActive[item.match as keyof NavActive];
}
---

<aside class="train-console-sidebar" aria-label="Train console navigation">
	<button
		type="button"
		class="train-sidebar-toggle"
		id="train-sidebar-toggle"
		aria-expanded="true"
		aria-controls="train-sidebar-rail"
		title="Collapse sidebar"
	>
		<svg
			class="train-sidebar-toggle-icon"
			width="18"
			height="18"
			viewBox="0 0 24 24"
			fill="none"
			stroke="currentColor"
			stroke-width="2"
			stroke-linecap="round"
			stroke-linejoin="round"
			aria-hidden="true"
		>
			<polyline points="15 6 9 12 15 18"></polyline>
		</svg>
	</button>
	<div class="train-sidebar-rail" id="train-sidebar-rail">
	<div class="train-sidebar-top">
		<a class="train-sidebar-brand" href={b}>
			<span class="train-sidebar-mark">E</span>
			<span class="train-sidebar-brandText">
				<strong>Train shell</strong>
				<small>Erika · predictions · live desk</small>
			</span>
		</a>
	</div>

	<div class="train-sidebar-scroll">
		<nav class="train-sidebar-nav" aria-label="Primary">
			{
				items.map((item) => (
					<a
						href={item.href}
						class:list={['train-sidebar-link', { 'is-active': isActive(item) }]}
						target={item.ext ? '_blank' : undefined}
						rel={item.ext ? 'noopener noreferrer' : undefined}
					>
						{item.match === 'home' ? (
							<svg class="train-sidebar-icon" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" /><polyline points="9 22 9 12 15 12 15 22" /></svg>
						) : item.match === 'predictions' || item.match === 'liveAnalysis' || item.match === 'gameLive' ? (
							<svg class="train-sidebar-icon" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2" /></svg>
						) : item.match === 'directory' || item.match === 'featured' ? (
							<svg class="train-sidebar-icon" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6" /><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18" /><path d="M4 22h16" /><path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22" /><path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22" /><path d="M18 2H6v7a6 6 0 0 0 12 0V2Z" /></svg>
						) : item.match === 'listing' ? (
							<svg class="train-sidebar-icon" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z" /></svg>
						) : (
							<svg class="train-sidebar-icon" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 2v7.527a2 2 0 0 1-.211.896L4.72 20.55a1 1 0 0 0 .9 1.45h12.76a1 1 0 0 0 .9-1.45l-5.07-10.127A2 2 0 0 1 14 9.527V2" /><path d="M8.5 2h7" /><path d="M7 16h10" /></svg>
						)}
						<span>{item.label}</span>
					</a>
				))
			}
		</nav>

		{
			gameHome ? (
				<div class="train-sidebar-summary">
					<div class="train-sidebar-eyebrow">Companion app</div>
					<a class="train-sidebar-link train-sidebar-link--ghost" href={gameHome} target="_blank" rel="noopener noreferrer">
						<svg class="train-sidebar-icon" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10" /><path d="M12 6v6l4 2" /></svg>
						<span>Game console</span>
					</a>
				</div>
			) : null
		}

		<div class="train-sidebar-summary">
			<div class="train-sidebar-eyebrow">Current mode</div>
			<div class="train-sidebar-chipRow">
				<span class="train-status-pill train-status-pill--live">watching</span>
				<span class="train-status-pill train-status-pill--neutral">educational</span>
			</div>
		</div>

		<div class="train-sidebar-summary">
			<div class="train-sidebar-eyebrow">Shell mix</div>
			<ul class="train-bulletless-list">
				<li>
					<span class="train-mono">Predictions</span>
					<span class="muted">Coinbase-style cards; static on GitHub Pages</span>
				</li>
				<li>
					<span class="train-mono">Live</span>
					<span class="muted">μgrad + Bloomberg wiring; Game Next for iframes</span>
				</li>
				<li>
					<span class="train-mono">Sports</span>
					<span class="muted">
						<a
							class="train-sidebar-out-link"
							href="https://ballerleague.us/en"
							target="_blank"
							rel="noopener noreferrer">Baller League US</a> context
					</span>
				</li>
				<li>
					<span class="train-mono">Markets</span>
					<span class="muted">Directory + listing metadata, no execution</span>
				</li>
			</ul>
		</div>
	</div>

	<div class="train-sidebar-footer">
		<div class="train-sidebar-tip">
			<svg class="train-sidebar-icon" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18" /><path d="M18 17V9" /><path d="M13 17V5" /><path d="M8 17v-3" /></svg>
			<div>
				<strong>Live market read</strong>
				<p>Use Directory for listings; Predictions for desk rhythm; wire Game /live when env URLs are set.</p>
			</div>
		</div>
	</div>
	</div>
</aside>

<style>
	.train-console-sidebar {
		position: sticky;
		top: 10rem;
		width: 280px;
		flex-shrink: 0;
		display: flex;
		flex-direction: row;
		align-items: stretch;
		align-self: flex-start;
		max-height: calc(100vh - 10.5rem);
		overflow: hidden;
		border-radius: 20px;
		border: 1px solid rgba(170, 186, 220, 0.14);
		background: rgba(10, 14, 24, 0.88);
		backdrop-filter: blur(20px) saturate(1.1);
		-webkit-backdrop-filter: blur(20px) saturate(1.1);
		box-shadow: 0 18px 48px rgba(0, 0, 0, 0.35);
		transition: width 0.22s ease;
	}

	.train-sidebar-rail {
		flex: 1;
		min-width: 0;
		display: flex;
		flex-direction: column;
		overflow: hidden;
	}

	.train-sidebar-toggle {
		flex: 0 0 38px;
		width: 38px;
		align-self: stretch;
		border: none;
		border-right: 1px solid rgba(170, 186, 220, 0.12);
		background: rgba(255, 255, 255, 0.04);
		color: rgba(230, 236, 255, 0.88);
		cursor: pointer;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 0;
		transition: background 0.15s ease, color 0.15s ease;
	}

	.train-sidebar-toggle:hover {
		background: rgba(102, 165, 255, 0.12);
		color: #fff;
	}

	.train-sidebar-toggle-icon {
		display: block;
		transition: transform 0.22s ease;
	}

	:global(body.train-sidebar-collapsed) .train-sidebar-toggle-icon {
		transform: rotate(180deg);
	}

	:global(body.train-sidebar-collapsed) .train-sidebar-rail {
		display: none;
	}

	:global(body.train-sidebar-collapsed) .train-console-sidebar {
		width: 44px;
		flex-direction: column;
		align-items: center;
		padding-top: 6px;
	}

	:global(body.train-sidebar-collapsed) .train-sidebar-toggle {
		flex: 0 0 40px;
		width: 100%;
		border-right: none;
		border-bottom: 1px solid rgba(170, 186, 220, 0.12);
		min-height: 40px;
	}

	:global(body:not(.has-header-directory-search)) .train-console-sidebar {
		top: 8.25rem;
		max-height: calc(100vh - 8.75rem);
	}

	:global(body.header-collapsed) .train-console-sidebar {
		top: 6.5rem;
		max-height: calc(100vh - 7rem);
	}

	:global(body.has-header-directory-search.header-collapsed) .train-console-sidebar {
		top: 7.75rem;
		max-height: calc(100vh - 8.25rem);
	}

	.train-sidebar-top,
	.train-sidebar-footer {
		padding: 16px;
		flex-shrink: 0;
	}

	.train-sidebar-top {
		border-bottom: 1px solid rgba(170, 186, 220, 0.1);
	}

	.train-sidebar-brand {
		display: inline-flex;
		align-items: center;
		gap: 12px;
		color: var(--text);
		text-decoration: none;
	}

	.train-sidebar-brand:hover .train-sidebar-brandText strong {
		color: var(--accent);
	}

	.train-sidebar-mark {
		width: 40px;
		height: 40px;
		border-radius: 12px;
		display: grid;
		place-items: center;
		background: linear-gradient(135deg, rgba(102, 165, 255, 0.28), rgba(89, 214, 157, 0.2));
		border: 1px solid rgba(170, 186, 220, 0.16);
		font-family: var(--font-serif);
		font-size: 1.15rem;
		font-weight: 600;
		color: rgba(255, 255, 255, 0.92);
	}

	.train-sidebar-brandText {
		display: flex;
		flex-direction: column;
		gap: 2px;
	}

	.train-sidebar-brandText strong {
		font-size: 0.95rem;
		font-weight: 650;
		letter-spacing: -0.02em;
	}

	.train-sidebar-brandText small {
		color: var(--muted);
		font-size: 0.68rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.train-sidebar-scroll {
		flex: 1;
		min-height: 0;
		overflow: auto;
		padding: 14px 12px;
		display: flex;
		flex-direction: column;
		gap: 14px;
	}

	.train-sidebar-nav {
		display: flex;
		flex-direction: column;
		gap: 6px;
		padding: 10px 10px 12px;
		background: var(--header-rail-surface);
		color: #0a0b0d;
		border: 1px solid var(--header-rail-border);
		border-radius: 18px;
		box-shadow: var(--header-rail-shadow);
		font-family: 'Inter', var(--font-ui);
	}

	.train-sidebar-link {
		display: flex;
		align-items: center;
		gap: 10px;
		padding: 8px 12px;
		border-radius: 999px;
		font-size: 0.88rem;
		font-weight: 500;
		line-height: 1.2;
		border: 1px solid var(--header-rail-pill-border);
		background: var(--header-rail-pill-bg);
		color: var(--header-rail-muted);
		text-decoration: none;
		transition:
			background 0.15s ease,
			border-color 0.15s ease,
			color 0.15s ease;
	}

	.train-sidebar-link:hover {
		border-color: #0052ff;
		color: #0052ff;
		background: #ffffff;
	}

	.train-sidebar-link.is-active {
		color: #ffffff;
		background: #0a0b0d;
		border-color: #0a0b0d;
		font-weight: 600;
		box-shadow: none;
	}

	.train-sidebar-link--ghost {
		border-style: dashed;
		color: #3d4a63;
	}

	.train-sidebar-link--ghost:hover {
		border-style: solid;
	}

	.train-sidebar-icon {
		width: 16px;
		height: 16px;
		flex-shrink: 0;
		opacity: 0.92;
	}

	.train-sidebar-summary,
	.train-sidebar-tip {
		border-radius: 16px;
		border: 1px solid rgba(170, 186, 220, 0.12);
		background: rgba(255, 255, 255, 0.04);
		padding: 14px;
	}

	.train-sidebar-tip {
		display: flex;
		gap: 12px;
		align-items: flex-start;
	}

	.train-sidebar-tip p {
		margin: 4px 0 0;
		color: var(--muted);
		font-size: 0.82rem;
		line-height: 1.5;
	}

	.train-sidebar-tip strong {
		font-size: 0.86rem;
		color: var(--text);
	}

	.train-sidebar-eyebrow {
		color: rgba(169, 200, 255, 0.92);
		font-family: var(--font-mono);
		font-size: 0.68rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		margin-bottom: 10px;
	}

	.train-sidebar-chipRow {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
	}

	.train-status-pill {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 26px;
		padding: 0 10px;
		border-radius: 999px;
		border: 1px solid rgba(170, 186, 220, 0.16);
		font-size: 0.68rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		white-space: nowrap;
	}

	.train-status-pill--live {
		background: rgba(102, 165, 255, 0.14);
		color: rgba(169, 200, 255, 0.95);
	}

	.train-status-pill--neutral {
		background: rgba(255, 255, 255, 0.05);
		color: var(--muted);
	}

	.train-bulletless-list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 10px;
	}

	.train-bulletless-list li {
		display: flex;
		justify-content: space-between;
		gap: 12px;
		padding: 10px 0;
		border-bottom: 1px solid rgba(170, 186, 220, 0.08);
		font-size: 0.82rem;
		line-height: 1.45;
	}

	.train-bulletless-list li:last-child {
		border-bottom: 0;
		padding-bottom: 0;
	}

	.train-mono {
		font-family: var(--font-mono);
		font-size: 0.78rem;
		color: var(--text);
		flex-shrink: 0;
	}

	.train-sidebar-out-link {
		color: rgba(102, 165, 255, 0.95);
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	.train-sidebar-out-link:hover {
		color: #cfe4ff;
	}

	@media (max-width: 1100px) {
		.train-console-sidebar {
			position: static;
			width: 100%;
			max-height: none;
			margin-bottom: 4px;
		}

		.train-sidebar-scroll {
			max-height: 420px;
		}

		:global(body.train-sidebar-collapsed) .train-console-sidebar {
			width: 44px;
			align-self: flex-start;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.train-sidebar-link,
		.train-console-sidebar,
		.train-sidebar-toggle-icon {
			transition: none;
		}
	}
</style>
