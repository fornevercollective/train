---
import { trainPredictionDemoMarkets } from '../lib/prediction-demo-markets';
import {
	sectorDeskSynopsis,
	sportsWhyBlocks,
	sectorContenders,
	deskTips,
	platformFootnote,
	monthlyEstimatesIntro,
	monthlySectorEstimateRows,
	mispricingKalshiCoinbasePlaybook,
} from '../lib/prediction-sector-desk';

interface Props {
	/** Anchor id when embedded on the home page */
	id?: string;
	/** `home` = compact intro; `page` = full hero band */
	variant?: 'home' | 'page';
	gameHomeUrl: string;
	gameLiveUrl: string;
	gamePredictionsHashUrl: string;
}

const { id, variant = 'home', gameHomeUrl, gameLiveUrl, gamePredictionsHashUrl } = Astro.props;
const isPage = variant === 'page';
const trainBase = import.meta.env.BASE_URL.endsWith('/')
	? import.meta.env.BASE_URL
	: `${import.meta.env.BASE_URL}/`;
const liveAnalysisHref = isPage
	? `${trainBase}predictions/#home-live-analysis`
	: `${trainBase}#home-live-analysis`;

const maxRomYield = Math.max(...monthlySectorEstimateRows.map((r) => r.romYieldScore), 1);
const romRowsDisplay = [...monthlySectorEstimateRows]
	.sort((a, b) => b.romYieldScore - a.romYieldScore)
	.map((r) => ({
		...r,
		pctOfLeader: Math.round((r.romYieldScore / maxRomYield) * 1000) / 10,
	}));
const topRomRow = romRowsDisplay[0];
const secondRomRow = romRowsDisplay[1];
const topVsSecondPct =
	secondRomRow && secondRomRow.romYieldScore > 0
		? Math.round(((topRomRow.romYieldScore - secondRomRow.romYieldScore) / secondRomRow.romYieldScore) * 1000) / 10
		: null;
---

<section class:list={['ep-predictions-scope', isPage && 'ep-predictions-scope--page']} id={id}>
	<div class:list={['ep-predictions-surface', isPage && 'ep-predictions-surface--roomy']}>
		<div class="ep-pred-hero">
			<div class="ep-pred-hero-copy">
				<p class="ep-pred-eyebrow">Trending prediction markets</p>
				<h2 class="ep-pred-page-title">
					{isPage
						? 'Predictions desk — same card rhythm as the Game console'
						: 'Clean cards, $100 → payout, Game-console density'}
				</h2>
				<p class="ep-pred-muted">
					Train stays static on GitHub Pages; the companion <strong>Game</strong> Next app hosts the
					interactive strip and merged <code class="ep-pred-code">/live</code> (μgrad + Bloomberg).
					Product reference:
					<a
						class="ep-pred-inline-link"
						href="https://www.coinbase.com/predictions"
						target="_blank"
						rel="noopener noreferrer">Coinbase Predictions</a>.
					Minors context:
					<a
						class="ep-pred-inline-link"
						href="https://ballerleague.us/en"
						target="_blank"
						rel="noopener noreferrer">Baller League US</a>.
				</p>
			</div>
			<div class="ep-pred-hero-actions">
				{
					gamePredictionsHashUrl ? (
						<a class="ep-pred-btn ep-pred-btn-primary" href={gamePredictionsHashUrl} target="_blank" rel="noopener noreferrer">
							Open Game predictions
						</a>
					) : null
				}
				{
					gameHomeUrl ? (
						<a class="ep-pred-btn" href={gameHomeUrl} target="_blank" rel="noopener noreferrer">
							Game home
						</a>
					) : null
				}
				{
					gameLiveUrl ? (
						<a class="ep-pred-btn" href={gameLiveUrl} target="_blank" rel="noopener noreferrer">
							Live desk
						</a>
					) : null
				}
				{
					!isPage ? (
						<a class="ep-pred-btn" href={liveAnalysisHref}>
							Live wiring on Train
						</a>
					) : (
						<a class="ep-pred-btn" href={liveAnalysisHref}>
							Train live analysis
						</a>
					)
				}
				{
					isPage ? (
						<a class="ep-pred-btn" href={import.meta.env.BASE_URL}>
							← Directory home
						</a>
					) : null
				}
			</div>
		</div>

		{
			isPage ? (
				<div class="ep-pred-sector-expand" aria-labelledby="ep-pred-sector-title">
					<div class="ep-pred-sector-lead">
						<p class="ep-pred-sector-kicker">{sectorDeskSynopsis.kicker}</p>
						<h3 id="ep-pred-sector-title" class="ep-pred-sector-title">
							{sectorDeskSynopsis.title}
						</h3>
						<p class="ep-pred-sector-lede">{sectorDeskSynopsis.lede}</p>
						<p class="ep-pred-sector-note ep-pred-muted">{sectorDeskSynopsis.note}</p>
						<a
							class="ep-pred-btn ep-pred-btn--compact"
							href="https://www.coinbase.com/predictions"
							target="_blank"
							rel="noopener noreferrer"
						>
							Open Coinbase Predictions →
						</a>
					</div>

					<div class="ep-pred-sector-split">
						<div class="ep-pred-sector-panel ep-pred-sector-panel--sports">
							<h4 class="ep-pred-sector-h4">Why sports often leads for near-term “wins”</h4>
							<p class="ep-pred-muted ep-pred-sector-panel-intro">
								Not a promise of profit — just the structural reasons desks route flow here during playoffs and
								championship windows.
							</p>
							<ul class="ep-pred-sector-points">
								{sportsWhyBlocks.map((b) => (
									<li>
										<strong>{b.title}</strong>
										<span>{b.body}</span>
									</li>
								))}
							</ul>
						</div>

						<div class="ep-pred-sector-panel">
							<h4 class="ep-pred-sector-h4">Other verticals worth watching</h4>
							<div class="ep-pred-sector-contenders">
								{sectorContenders.map((c) => (
									<div class="ep-pred-sector-mini">
										<span class="ep-pred-sector-mini-tag">{c.tag}</span>
										<p class="ep-pred-sector-mini-title">{c.title}</p>
										<p class="ep-pred-sector-mini-body">{c.body}</p>
									</div>
								))}
							</div>
						</div>
					</div>

					<div class="ep-pred-month-stats" aria-labelledby="ep-pred-month-stats-title">
						<div class="ep-pred-month-stats-head">
							<h4 id="ep-pred-month-stats-title" class="ep-pred-sector-h4">
								{monthlyEstimatesIntro.title}
							</h4>
							<p class="ep-pred-muted ep-pred-month-stats-lede">{monthlyEstimatesIntro.lede}</p>
							<p class="ep-pred-month-stats-period ep-pred-muted">{monthlyEstimatesIntro.periodNote}</p>
							{
								topRomRow && secondRomRow && topVsSecondPct !== null ? (
									<p class="ep-pred-month-stats-compare" role="status">
										<strong class="ep-pred-month-stats-compare-strong">
											Highest illustrative RoM yield index:
										</strong>{' '}
										{topRomRow.sector} ({topRomRow.romYieldScore}) vs. next sector {secondRomRow.sector} (
										{secondRomRow.romYieldScore}) — about <strong>+{topVsSecondPct}%</strong> higher on this
										normalized scale (not dollars of profit).
									</p>
								) : null
							}
							<p class="ep-pred-month-stats-playbook">{mispricingKalshiCoinbasePlaybook}</p>
							<div class="ep-pred-month-stats-links">
								<a
									class="ep-pred-btn ep-pred-btn--compact"
									href="https://www.coinbase.com/predictions"
									target="_blank"
									rel="noopener noreferrer"
								>
									Coinbase Predictions
								</a>
								<a class="ep-pred-btn ep-pred-btn--compact" href="https://kalshi.com/" target="_blank" rel="noopener noreferrer">
									Kalshi
								</a>
							</div>
						</div>

						<div class="ep-pred-stat-table-wrap">
							<table class="ep-pred-stat-table">
								<caption class="ep-pred-sr-caption">
									Illustrative rest-of-month sector statistics — venue mid vs. reference fair, gaps, and yield
									rank
								</caption>
								<thead>
									<tr>
										<th scope="col">Sector</th>
										<th scope="col">Venue mid (%)</th>
										<th scope="col">Ref fair (%)</th>
										<th scope="col">Gap (pp)</th>
										<th scope="col">80% CI (±pp)</th>
										<th scope="col">Liquidity</th>
										<th scope="col">RoM yield</th>
										<th scope="col">% of leader</th>
									</tr>
								</thead>
								<tbody>
									{romRowsDisplay.map((row) => (
										<tr class:list={[{ 'ep-pred-stat-row--top': row.romYieldScore === topRomRow?.romYieldScore }]}>
											<th scope="row">{row.sector}</th>
											<td>{row.venueMidPct.toFixed(1)}</td>
											<td>{row.refFairPct.toFixed(1)}</td>
											<td
												class:list={[
													'ep-pred-stat-gap',
													{ 'ep-pred-stat-gap--pos': row.gapPctPoints > 0 },
													{ 'ep-pred-stat-gap--neg': row.gapPctPoints < 0 },
												]}
											>
												{row.gapPctPoints > 0 ? '+' : ''}
												{row.gapPctPoints.toFixed(1)}
											</td>
											<td>±{row.ci80HalfWidthPp.toFixed(1)}</td>
											<td>
												<span class="ep-pred-stat-liq">
													<span class="ep-pred-stat-liq-track">
														<span class="ep-pred-stat-liq-bar" style={`width: ${row.liquidityScore}%`} />
													</span>
													<span class="ep-pred-stat-liq-val">{row.liquidityScore}</span>
												</span>
											</td>
											<td>
												<span class="ep-pred-stat-yield">
													<span class="ep-pred-stat-yield-track">
														<span class="ep-pred-stat-yield-bar" style={`width: ${row.romYieldScore}%`} />
													</span>
													<span class="ep-pred-stat-yield-val">{row.romYieldScore}</span>
												</span>
											</td>
											<td>{row.pctOfLeader.toFixed(1)}%</td>
										</tr>
									))}
								</tbody>
							</table>
						</div>
					</div>

					<div class="ep-pred-sector-tips">
						<h4 class="ep-pred-sector-h4">Desk habits (informational)</h4>
						<ol class="ep-pred-sector-tip-list">
							{deskTips.map((t) => (
								<li>{t}</li>
							))}
						</ol>
						<p class="ep-pred-sector-foot ep-pred-muted">{platformFootnote}</p>
					</div>
				</div>
			) : null
		}

		<div class="ep-pred-trending-grid">
			{
				trainPredictionDemoMarkets.map((m) => (
					<article class="ep-pred-trend-card">
						<div class="ep-pred-trend-card-top">
							<span class="ep-pred-trend-icon" aria-hidden="true">
								{m.icon}
							</span>
							<div>
								<h3 class="ep-pred-trend-title">{m.title}</h3>
								<p class="ep-pred-trend-sub">{m.subtitle}</p>
							</div>
							{m.live ? <span class="ep-pred-live-pill">Live</span> : null}
						</div>
						<div class="ep-pred-trend-outcomes">
							{m.outcomes.map((o) => (
								<div class="ep-pred-trend-outcome">
									<div>
										<span class="ep-pred-trend-code">{o.code}</span>
										<span class="ep-pred-trend-pct">{o.probPct}%</span>
									</div>
									<div class="ep-pred-trend-payout">
										$100 → <strong>${o.payout.toLocaleString()}</strong>
									</div>
								</div>
							))}
						</div>
						{m.vol24h ? <p class="ep-pred-trend-vol">{m.vol24h} vol. (24h)</p> : null}
						{
							gameLiveUrl ? (
								<a class="ep-pred-trend-link" href={gameLiveUrl} target="_blank" rel="noopener noreferrer">
									Open merged live desk →
								</a>
							) : (
								<span class="ep-pred-trend-link-muted">Set PUBLIC_GAME_CONSOLE_URL to link out</span>
							)
						}
					</article>
				))
			}
		</div>

		<p class="ep-pred-disclaimer">
			Illustrative numbers, sector commentary, and the <strong>rest-of-month statistics table</strong> are for
			<strong>education only</strong> — not trading advice, not live Kalshi/Coinbase data, not a quote, and not an
			investability signal. Contracts can expire worthless; venues have eligibility and geographic rules. Set{' '}
			<code class="ep-pred-code">PUBLIC_GAME_CONSOLE_URL</code> at build time for header + outbound Game links.
		</p>
	</div>
</section>

<style>
	/* Predictions strip — same glass card shell as `.card` / home-live-analysis (scoped) */
	.ep-predictions-scope {
		--ep-pred-font: 'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif;
		--ep-pred-mono: 'IBM Plex Mono', ui-monospace, monospace;
		font-family: var(--ep-pred-font);
	}

	.ep-predictions-surface {
		background: var(--card-bg);
		color: var(--text);
		border-radius: 18px;
		border: 1px solid var(--card-border);
		box-shadow: var(--shadow);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		padding: 22px 22px 20px;
	}

	.ep-predictions-surface--roomy {
		padding: 28px 26px 28px;
	}

	.ep-pred-hero {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 18px;
		flex-wrap: wrap;
		margin-bottom: 4px;
	}

	.ep-pred-hero-copy {
		flex: 1;
		min-width: min(100%, 320px);
	}

	.ep-pred-eyebrow {
		font-family: var(--ep-pred-mono);
		font-size: 0.72rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--accent);
		margin: 0;
	}

	.ep-pred-page-title {
		margin: 6px 0 0;
		font-size: clamp(1.45rem, 3vw, 2.05rem);
		letter-spacing: -0.03em;
		line-height: 1.12;
		color: var(--text);
		font-weight: 700;
	}

	.ep-pred-muted {
		margin: 10px 0 0;
		color: var(--muted);
		font-size: 0.94rem;
		line-height: 1.6;
		max-width: 58rem;
	}

	.ep-pred-inline-link {
		color: var(--accent);
		font-weight: 600;
		text-decoration: none;
	}

	.ep-pred-inline-link:hover {
		color: var(--accent-warm);
		text-decoration: underline;
	}

	.ep-pred-code {
		font-family: var(--ep-pred-mono);
		font-size: 0.84em;
		padding: 0.1em 0.32em;
		border-radius: 6px;
		background: rgba(0, 0, 0, 0.28);
		border: 1px solid rgba(255, 255, 255, 0.1);
		color: var(--text);
	}

	.ep-pred-hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
		align-items: center;
	}

	.ep-pred-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 10px 16px;
		border-radius: 999px;
		font-size: 0.88rem;
		font-weight: 600;
		border: 1px solid rgba(255, 255, 255, 0.12);
		background: rgba(0, 0, 0, 0.22);
		color: rgba(230, 236, 255, 0.88);
		text-decoration: none;
		transition:
			background 0.15s ease,
			border-color 0.15s ease,
			color 0.15s ease;
	}

	.ep-pred-btn:hover {
		border-color: rgba(72, 224, 188, 0.35);
		color: var(--accent);
		background: rgba(72, 224, 188, 0.08);
	}

	.ep-pred-btn-primary {
		background: rgba(255, 255, 255, 0.92);
		color: #0a0b0d;
		border-color: rgba(255, 255, 255, 0.35);
	}

	.ep-pred-btn-primary:hover {
		filter: brightness(1.06);
		color: #0a0b0d;
		border-color: rgba(255, 255, 255, 0.45);
	}

	.ep-pred-btn--compact {
		margin-top: 14px;
		padding: 8px 14px;
		font-size: 0.82rem;
	}

	.ep-pred-sector-expand {
		margin-top: 26px;
		padding-top: 24px;
		border-top: 1px solid rgba(255, 255, 255, 0.1);
		display: flex;
		flex-direction: column;
		gap: 22px;
	}

	.ep-pred-sector-lead {
		max-width: 72rem;
	}

	.ep-pred-sector-kicker {
		font-family: var(--ep-pred-mono);
		font-size: 0.7rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--accent);
		margin: 0 0 8px;
	}

	.ep-pred-sector-title {
		margin: 0;
		font-size: clamp(1.2rem, 2.4vw, 1.55rem);
		font-weight: 700;
		letter-spacing: -0.02em;
		line-height: 1.2;
		color: var(--text);
	}

	.ep-pred-sector-lede {
		margin: 12px 0 0;
		font-size: 1rem;
		line-height: 1.65;
		color: rgba(220, 228, 245, 0.92);
	}

	.ep-pred-sector-note {
		margin: 12px 0 0;
		max-width: 62rem;
	}

	.ep-pred-sector-split {
		display: grid;
		grid-template-columns: minmax(0, 1.12fr) minmax(0, 0.88fr);
		gap: 18px;
		align-items: stretch;
	}

	.ep-pred-sector-panel {
		padding: 18px 18px 16px;
		border-radius: 16px;
		background: rgba(0, 0, 0, 0.2);
		border: 1px solid rgba(255, 255, 255, 0.09);
	}

	.ep-pred-sector-panel--sports {
		border-color: rgba(72, 224, 188, 0.22);
		background: linear-gradient(165deg, rgba(72, 224, 188, 0.07), rgba(0, 0, 0, 0.18));
	}

	.ep-pred-sector-h4 {
		margin: 0;
		font-size: 0.98rem;
		font-weight: 700;
		letter-spacing: -0.01em;
		color: var(--text);
	}

	.ep-pred-sector-panel-intro {
		margin: 8px 0 14px;
		font-size: 0.86rem;
		line-height: 1.55;
	}

	.ep-pred-sector-points {
		margin: 0;
		padding: 0;
		list-style: none;
		display: flex;
		flex-direction: column;
		gap: 14px;
	}

	.ep-pred-sector-points li {
		display: flex;
		flex-direction: column;
		gap: 4px;
		font-size: 0.88rem;
		line-height: 1.55;
		color: rgba(210, 218, 238, 0.9);
		padding-bottom: 12px;
		border-bottom: 1px solid rgba(255, 255, 255, 0.06);
	}

	.ep-pred-sector-points li:last-child {
		padding-bottom: 0;
		border-bottom: 0;
	}

	.ep-pred-sector-points strong {
		font-size: 0.82rem;
		font-weight: 700;
		color: var(--text);
		letter-spacing: 0.02em;
		text-transform: uppercase;
	}

	.ep-pred-sector-contenders {
		display: flex;
		flex-direction: column;
		gap: 12px;
		margin-top: 10px;
	}

	.ep-pred-sector-mini {
		padding: 12px 14px;
		border-radius: 12px;
		background: rgba(0, 0, 0, 0.22);
		border: 1px solid rgba(255, 255, 255, 0.08);
	}

	.ep-pred-sector-mini-tag {
		display: inline-block;
		font-size: 0.65rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--accent);
		margin-bottom: 6px;
	}

	.ep-pred-sector-mini-title {
		margin: 0 0 6px;
		font-size: 0.92rem;
		font-weight: 700;
		color: var(--text);
	}

	.ep-pred-sector-mini-body {
		margin: 0;
		font-size: 0.84rem;
		line-height: 1.55;
		color: var(--muted);
	}

	.ep-pred-sector-tips {
		padding: 18px 18px 16px;
		border-radius: 16px;
		background: rgba(0, 0, 0, 0.16);
		border: 1px dashed rgba(255, 255, 255, 0.12);
	}

	.ep-pred-sector-tip-list {
		margin: 10px 0 0;
		padding-left: 1.15rem;
		color: rgba(210, 218, 238, 0.9);
		font-size: 0.88rem;
		line-height: 1.62;
	}

	.ep-pred-sector-tip-list li {
		margin-bottom: 10px;
	}

	.ep-pred-sector-tip-list li:last-child {
		margin-bottom: 0;
	}

	.ep-pred-sector-foot {
		margin: 14px 0 0;
		font-size: 0.82rem;
		line-height: 1.55;
		max-width: 62rem;
	}

	.ep-pred-month-stats {
		margin-top: 8px;
		padding-top: 22px;
		border-top: 1px solid rgba(255, 255, 255, 0.08);
		display: flex;
		flex-direction: column;
		gap: 16px;
	}

	.ep-pred-month-stats-head {
		max-width: 72rem;
	}

	.ep-pred-month-stats-lede {
		margin: 8px 0 0;
		max-width: 68rem;
	}

	.ep-pred-month-stats-period {
		margin: 8px 0 0;
		font-size: 0.82rem;
	}

	.ep-pred-month-stats-compare {
		margin: 14px 0 0;
		font-size: 0.9rem;
		line-height: 1.55;
		color: rgba(220, 228, 245, 0.92);
		padding: 12px 14px;
		border-radius: 12px;
		background: rgba(72, 224, 188, 0.08);
		border: 1px solid rgba(72, 224, 188, 0.2);
	}

	.ep-pred-month-stats-compare-strong {
		color: var(--text);
	}

	.ep-pred-month-stats-playbook {
		margin: 12px 0 0;
		font-size: 0.88rem;
		line-height: 1.6;
		color: rgba(210, 218, 238, 0.95);
		max-width: 62rem;
	}

	.ep-pred-month-stats-links {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
		margin-top: 12px;
	}

	.ep-pred-stat-table-wrap {
