{
  "name": "train",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "prepare:data": "python3 scripts/build_catalog_data.py && python3 scripts/build_health_shards.py && python3 scripts/build_history_manifest.py",
    "enrichment:build": "python3 scripts/build_attribution_enrichment.py",
    "history:fetch": "python3 scripts/fetch_us_history.py",
    "history:import": "python3 scripts/import_history_csv.py",
    "history:manifest": "python3 scripts/build_history_manifest.py",
    "dev": "npm run prepare:data && astro dev",
		"dev:liquid": "bash scripts/run-liquid-ai-live.sh",
    "build": "node scripts/run-build.mjs",
    "build:local": "npm run prepare:data && astro build",
    "preview": "npm run build && wrangler dev",
    "check": "astro check",
    "astro": "astro",
    "generate-types": "wrangler types",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^13.5.0",
    "astro": "^6.2.0",
    "echarts": "^5.6.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@types/node": "^24.9.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.89.0"
  },
  "overrides": {
    "vite": "^7"
  }
}
