{
  "name": "train",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "prepare:data": "python3 scripts/build_catalog_data.py && python3 scripts/build_catalog_shards.py && python3 scripts/build_health_shards.py && python3 scripts/build_history_manifest.py && python3 scripts/patch_listing_genesis_showcase.py && python3 scripts/patch_catalog_sectors_from_members.py --apply --us-only",
    "patch:catalog-sectors": "python3 scripts/patch_catalog_sectors_from_members.py --apply --us-only",
    "enrichment:fetch": "python3 scripts/fetch_registry_enrichment.py",
    "enrichment:build": "python3 scripts/build_attribution_enrichment.py",
    "profiles:collect": "python3 scripts/collect_listing_profiles.py",
    "profiles:universe:nyse": "python3 scripts/build_nyse_priority_universe.py --also-write-ipo",
    "profiles:collect:nyse-priority": "python3 scripts/collect_listing_profiles.py --priority-file ../ipo-astro-lookup/data/nyse-priority-400.json --limit 25 --resume",
    "database:normalize": "python3 scripts/normalize_catalog_completeness.py",
    "database:history": "python3 scripts/fetch_us_history.py --source yfinance --lookback max --delay 0.25",
    "database:quotes": "python3 scripts/build_quotes_snapshot.py",
    "database:report": "python3 scripts/backfill_listing_database.py --phase report",
    "database:backfill": "python3 scripts/backfill_listing_database.py",
    "database:batch-all": "python3 scripts/batch_all_listings.py",
    "history:fetch": "python3 scripts/fetch_us_history.py",
    "history:import": "python3 scripts/import_history_csv.py",
    "history:manifest": "python3 scripts/build_history_manifest.py",
    "smoke:viz": "python3 scripts/smoke_listing_viz.py --apply --verify",
    "smoke:viz:apply": "python3 scripts/smoke_listing_viz.py --apply",
    "smoke:viz:cleanup": "python3 scripts/smoke_listing_viz.py --cleanup",
    "audit:genesis": "python3 scripts/audit_ipo_genesis.py --flag proxy_note --summary-only",
    "audit:watchlist:drift": "python3 scripts/audit_watchlist_genesis_drift.py",
    "verify:genesis:watchlist": "python3 scripts/verify_yahoo_sourced_genesis.py",
    "verify:genesis:yahoo": "python3 scripts/verify_yahoo_sourced_genesis.py --all-yahoo-proxy",
    "patch:listing-showcase": "python3 scripts/patch_listing_genesis_showcase.py",
    "audit:crsp-floor": "python3 scripts/audit_crsp_floor_genesis.py --json public/data/reports/crsp-floor-genesis-sweep.json",
    "llc:catalog:publish": "node ../ipo-astro-lookup/tools/build-llc-origin-catalog.mjs && cp ../ipo-astro-lookup/data/llc-origin-catalog.json public/data/llc-origin-catalog.json",
    "dev": "python3 scripts/ensure_demo_history.py && npm run prepare:data && astro dev",
    "dev:liquid": "bash scripts/run-liquid-ai-live.sh",
    "build": "node scripts/run-build.mjs",
    "build:local": "npm run prepare:data && astro build",
    "preview": "npm run build && wrangler dev",
    "check": "astro check",
    "astro": "astro",
    "generate-types": "wrangler types",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^13.5.0",
    "astro": "^6.2.0",
    "echarts": "^5.6.0",
    "echarts-gl": "^2.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@types/node": "^24.9.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.89.0"
  },
  "overrides": {
    "vite": "^7"
  }
}
